-- 凭证齐全时更换已保护列 Label

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataprot015_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataprot015_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataprot015_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot015_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot015_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot015_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot015_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot015_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot015_p.old;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot015_p.new;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot015_p.both;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataprot015_p;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataprot015_a;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataprot015_s;
<<NULL;

-- 18. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataprot015_t;
<<NULL;

-- 19. 操作步骤: 主体有 ALTER、旧 public_rd_rnd READ+WRITE 和新 secret_rd_rnd WRITE，将 value 从旧 Label 换到新 Label。；预期结果: 成功且数据不变；映射原子切换到新 Label，后续只按新 Label 判定。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataprot015_db;

-- 20. 切换当前数据库或元数据查询范围
USE lbdataprot015_db;

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataprot015_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataprot015_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataprot015_a';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataprot015_s SET ('RD','QA','OPS');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataprot015_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataprot015_s';

-- 25. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataprot015_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataprot015_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataprot015_t';

-- 27. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataprot015_p COMPONENTS lbdataprot015_a,lbdataprot015_s,lbdataprot015_t WITH LBACRULES;

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot015_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataprot015_p';

-- 29. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataprot015_p TO USER root;

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot015_p.top COMPONENT lbdataprot015_a 'TOP', COMPONENT lbdataprot015_s 'RD', COMPONENT lbdataprot015_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot015_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot015_p' AND label_name='top';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot015_p.secret COMPONENT lbdataprot015_a 'SECRET', COMPONENT lbdataprot015_s 'RD', COMPONENT lbdataprot015_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot015_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot015_p' AND label_name='secret';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot015_p.internal COMPONENT lbdataprot015_a 'INTERNAL', COMPONENT lbdataprot015_s 'RD', COMPONENT lbdataprot015_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot015_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot015_p' AND label_name='internal';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot015_p.public COMPONENT lbdataprot015_a 'PUBLIC', COMPONENT lbdataprot015_s 'RD', COMPONENT lbdataprot015_t 'A1';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot015_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot015_p' AND label_name='public';

-- 38. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot015_p.wide COMPONENT lbdataprot015_a 'SECRET', COMPONENT lbdataprot015_s 'RD','QA', COMPONENT lbdataprot015_t 'ROOT';

-- 39. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot015_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot015_p' AND label_name='wide';

-- 40. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataprot015_p TO USER root;

-- 41. 创建用例使用的普通用户
CREATE USER lbdataprot015_u 'LbacTest_2026!';

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataprot015_db TO USER lbdataprot015_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataprot015_db TO USER lbdataprot015_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataprot015_db TO USER lbdataprot015_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataprot015_db TO USER lbdataprot015_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataprot015_db TO USER lbdataprot015_u;

-- 47. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataprot015_db TO USER lbdataprot015_u;

-- 48. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataprot015_p;

-- 49. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 50. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot015_p.old COMPONENT lbdataprot015_a 'SECRET', COMPONENT lbdataprot015_s 'RD';

-- 51. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot015_p' AND MIN(label_name)='old' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot015_p' AND label_name='old';

-- 52. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot015_p.new COMPONENT lbdataprot015_a 'SECRET', COMPONENT lbdataprot015_s 'QA';

-- 53. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot015_p' AND MIN(label_name)='new' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot015_p' AND label_name='new';

-- 54. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN high SECURED WITH old;

-- 55. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataprot015_p.old TO USER lbdataprot015_u FOR READ ACCESS;

-- 56. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataprot015_p.old TO USER lbdataprot015_u FOR WRITE ACCESS;

-- 57. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot015_p.both COMPONENT lbdataprot015_a 'SECRET', COMPONENT lbdataprot015_s 'RD','QA';

-- 58. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot015_p' AND MIN(label_name)='both' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot015_p' AND label_name='both';

-- 59. 授予或撤销安全标签访问权限并验证授权行为
REVOKE SECURITY LABEL lbdataprot015_p.old FROM USER lbdataprot015_u;

-- 60. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataprot015_p.old TO USER lbdataprot015_u FOR READ ACCESS;

-- 61. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataprot015_p.both TO USER lbdataprot015_u FOR WRITE ACCESS;

-- 62. 使用当前测试账号建立数据库连接
connect lbdataprot015_u/LbacTest_2026!;

-- 63. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 64. 切换当前数据库或元数据查询范围
USE lbdataprot015_db;

-- 65. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN high SECURED WITH new;

-- 66. 切换当前数据库或元数据查询范围
USE lbdataprot015_db;

-- 67. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbdataprot015_db' AND table_name='metrics' AND column_name='high' AND security_label='new';

-- 68. 切换当前数据库或元数据查询范围
USE lbdataprot015_db;

-- 切回管理员账号执行数据完整性断言
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataprot015_db;
-- 69. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(plain)=10 AND MIN(low)=20 AND MIN(high)=30 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;
-- 切回测试账号继续用例
connect lbdataprot015_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataprot015_db;

-- 70. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lbdataprot015_db;
<<NULL;

-- 71. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
