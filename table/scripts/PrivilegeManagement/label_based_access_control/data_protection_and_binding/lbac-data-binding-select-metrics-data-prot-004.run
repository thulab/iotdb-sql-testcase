-- 列使用其他 Policy 的 Label

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataprot004_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataprot004_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataprot004_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataprot004_p2 FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot004_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot004_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot004_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot004_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot004_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataprot004_p2.foreign;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataprot004_p;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataprot004_p2;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataprot004_a;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataprot004_s;
<<NULL;

-- 18. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataprot004_t;
<<NULL;

-- 19. 操作步骤: 对已绑定 data_policy 的表，将未保护 value 设置为仅属于 other_policy 的 other_public。；预期结果: 失败且 value 仍未保护；不得因名称、组件或值相似而跨 Policy 解析 Label。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataprot004_db;

-- 20. 切换当前数据库或元数据查询范围
USE lbdataprot004_db;

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataprot004_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataprot004_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataprot004_a';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataprot004_s SET ('RD','QA','OPS');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataprot004_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataprot004_s';

-- 25. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataprot004_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataprot004_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataprot004_t';

-- 27. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataprot004_p COMPONENTS lbdataprot004_a,lbdataprot004_s,lbdataprot004_t WITH LBACRULES;

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot004_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataprot004_p';

-- 29. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataprot004_p TO USER root;

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot004_p.top COMPONENT lbdataprot004_a 'TOP', COMPONENT lbdataprot004_s 'RD', COMPONENT lbdataprot004_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot004_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot004_p' AND label_name='top';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot004_p.secret COMPONENT lbdataprot004_a 'SECRET', COMPONENT lbdataprot004_s 'RD', COMPONENT lbdataprot004_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot004_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot004_p' AND label_name='secret';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot004_p.internal COMPONENT lbdataprot004_a 'INTERNAL', COMPONENT lbdataprot004_s 'RD', COMPONENT lbdataprot004_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot004_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot004_p' AND label_name='internal';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot004_p.public COMPONENT lbdataprot004_a 'PUBLIC', COMPONENT lbdataprot004_s 'RD', COMPONENT lbdataprot004_t 'A1';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot004_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot004_p' AND label_name='public';

-- 38. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot004_p.wide COMPONENT lbdataprot004_a 'SECRET', COMPONENT lbdataprot004_s 'RD','QA', COMPONENT lbdataprot004_t 'ROOT';

-- 39. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot004_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot004_p' AND label_name='wide';

-- 40. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataprot004_p TO USER root;

-- 41. 创建用例使用的普通用户
CREATE USER lbdataprot004_u 'LbacTest_2026!';

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataprot004_db TO USER lbdataprot004_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataprot004_db TO USER lbdataprot004_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataprot004_db TO USER lbdataprot004_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataprot004_db TO USER lbdataprot004_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataprot004_db TO USER lbdataprot004_u;

-- 47. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataprot004_db TO USER lbdataprot004_u;

-- 48. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataprot004_p;

-- 49. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 50. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataprot004_p2 COMPONENTS lbdataprot004_a,lbdataprot004_s,lbdataprot004_t WITH LBACRULES;

-- 51. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot004_p2' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataprot004_p2';

-- 52. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataprot004_p2 TO USER root;

-- 53. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataprot004_p2.foreign COMPONENT lbdataprot004_a 'PUBLIC';

-- 54. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataprot004_p2' AND MIN(label_name)='foreign' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataprot004_p2' AND label_name='foreign';

-- 55. 修改数据表的 LBAC 保护配置；本语句预期失败，需核对 SQLSTATE 及错误原因
ALTER TABLE metrics ALTER COLUMN plain SECURED WITH foreign;
<<SQLSTATE;

-- 56. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbdataprot004_db' AND table_name='metrics' AND column_name='plain' AND security_label IS NULL;

-- 57. 切换当前数据库或元数据查询范围
USE lbdataprot004_db;

-- 58. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(plain)=10 AND MIN(low)=20 AND MIN(high)=30 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;

-- 59. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
