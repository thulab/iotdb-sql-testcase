-- empty value 规则

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbac088_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbac088_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbac088_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac088_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac088_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac088_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac088_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac088_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac088_p.object;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac088_p.subject;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac088_p.missing;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbac088_p;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac088_a;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac088_s;
<<NULL;

-- 18. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac088_t;
<<NULL;

-- 19. 创建本用例隔离的测试数据库
CREATE DATABASE lblbac088_db;

-- 20. 切换当前数据库或元数据查询范围
USE lblbac088_db;

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac088_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac088_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac088_a';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac088_s SET ('RD','QA','OPS');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac088_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac088_s';

-- 25. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac088_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac088_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac088_t';

-- 27. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbac088_p COMPONENTS lblbac088_a,lblbac088_s,lblbac088_t WITH LBACRULES;

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac088_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbac088_p';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac088_p.top COMPONENT lblbac088_a 'TOP', COMPONENT lblbac088_s 'RD', COMPONENT lblbac088_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac088_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac088_p' AND label_name='top';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac088_p.secret COMPONENT lblbac088_a 'SECRET', COMPONENT lblbac088_s 'RD', COMPONENT lblbac088_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac088_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac088_p' AND label_name='secret';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac088_p.internal COMPONENT lblbac088_a 'INTERNAL', COMPONENT lblbac088_s 'RD', COMPONENT lblbac088_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac088_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac088_p' AND label_name='internal';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac088_p.public COMPONENT lblbac088_a 'PUBLIC', COMPONENT lblbac088_s 'RD', COMPONENT lblbac088_t 'A1';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac088_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac088_p' AND label_name='public';

-- 37. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac088_p.wide COMPONENT lblbac088_a 'SECRET', COMPONENT lblbac088_s 'RD','QA', COMPONENT lblbac088_t 'ROOT';

-- 38. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac088_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac088_p' AND label_name='wide';

-- 39. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbac088_p TO USER root;

-- 40. 创建用例使用的普通用户
CREATE USER lblbac088_u 'LbacTest_2026!';

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbac088_db TO USER lblbac088_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbac088_db TO USER lblbac088_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbac088_db TO USER lblbac088_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbac088_db TO USER lblbac088_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbac088_db TO USER lblbac088_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbac088_db TO USER lblbac088_u;

-- 47. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac088_p.object COMPONENT lblbac088_a 'PUBLIC';

-- 48. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac088_p' AND MIN(label_name)='object' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac088_p' AND label_name='object';

-- 49. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac088_p.subject COMPONENT lblbac088_a 'PUBLIC', COMPONENT lblbac088_s 'RD';

-- 50. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac088_p' AND MIN(label_name)='subject' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac088_p' AND label_name='subject';

-- 51. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(v INT32 FIELD SECURED WITH object) SECURITY POLICY lblbac088_p;

-- 52. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,v) VALUES(1,1);

-- 53. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbac088_p.subject TO USER lblbac088_u FOR ALL ACCESS;

-- 54. 使用当前测试账号建立数据库连接
connect lblbac088_u/LbacTest_2026!;

-- 55. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 56. 切换当前数据库或元数据查询范围
USE lblbac088_db;

-- 57. 读取受保护数据并验证 LBAC 读权限
SELECT v FROM metrics;

-- 58. 切换当前数据库或元数据查询范围
USE lblbac088_db;

-- 59. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lblbac088_db;
REVOKE SECURITY LABEL lblbac088_p.subject FROM USER lblbac088_u;

-- 60. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac088_p.missing COMPONENT lblbac088_s 'RD';
-- 切回测试账号继续用例
connect lblbac088_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbac088_db;

-- 61. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac088_p' AND MIN(label_name)='missing' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac088_p' AND label_name='missing';

-- 62. 授予或撤销安全标签访问权限并验证授权行为
