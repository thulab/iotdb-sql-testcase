SET SQL_DIALECT=TABLE;
USE lblbac088_db;
GRANT SECURITY LABEL lblbac088_p.missing TO USER lblbac088_u FOR ALL ACCESS;
-- 切回测试账号继续用例
connect lblbac088_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbac088_db;

-- 63. 切换当前数据库或元数据查询范围
