-- 元素 UTF-8 字节边界精确断言

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew012_a_ok;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew012_a_zh;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew012_a_bad;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew012_a_long;
<<NULL;

-- 8. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew012_a_ok SET ('xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx');

-- 9. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew012_a_ok' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew012_a_ok';

-- 10. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew012_a_zh SET ('中中中中中中中中中中ab');

-- 11. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew012_a_zh' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew012_a_zh';

-- 12. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lblbacnew012_a_bad SET ('中中中中中中中中中中中');
<<SQLSTATE;

-- 13. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lblbacnew012_a_long SET ('xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx');
<<SQLSTATE;

-- 14. 清理本条命名空间；无通配删除；初始化未被忽略。；删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbacnew012_a_zh;
<<NULL;

-- 15. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbacnew012_a_ok;

-- 16. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 17. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 18. 结束清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 19. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lblbacnew012_a_ok;
<<NULL;

-- 20. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lblbacnew012_a_zh;
<<NULL;

-- 21. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lblbacnew012_a_bad;
<<NULL;

-- 22. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lblbacnew012_a_long;
<<NULL;
