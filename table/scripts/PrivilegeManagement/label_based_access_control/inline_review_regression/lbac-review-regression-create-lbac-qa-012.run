-- 系统表可见性差分夹具

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacqa012_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacqa012_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP USER lblbacqa012_v;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP ROLE lblbacqa012_r;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacqa012_p FROM USER root;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa012_p.top;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa012_p.secret;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa012_p.internal;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa012_p.public;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa012_p.wide;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacqa012_p;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacqa012_a;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacqa012_s;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacqa012_t;
<<NULL;

-- 18. 操作步骤: 构造有/无任意表权限、角色成员/非成员、本人/他人授权行，查询表列关系及 access/exemptions，并与 SYSTEM、SECURITY 对照。；预期结果: 表列关系仅对 SHOW TABLES 可见表开放；普通用户只见本人 USER 及所属 ROLE 授权/免除行。无关行服务端裁剪，角色授权 USE/IGNORE 不改变可见范围。；创建本用例隔离的测试数据库
CREATE DATABASE lblbacqa012_db;

-- 19. 切换当前数据库或元数据查询范围
USE lblbacqa012_db;

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacqa012_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacqa012_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacqa012_a';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacqa012_s SET ('RD','QA','OPS');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacqa012_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacqa012_s';

-- 24. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacqa012_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacqa012_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacqa012_t';

-- 26. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacqa012_p COMPONENTS lblbacqa012_a,lblbacqa012_s,lblbacqa012_t WITH LBACRULES;

-- 27. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa012_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacqa012_p';

-- 28. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacqa012_p TO USER root;

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa012_p.top COMPONENT lblbacqa012_a 'TOP', COMPONENT lblbacqa012_s 'RD', COMPONENT lblbacqa012_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa012_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa012_p' AND label_name='top';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa012_p.secret COMPONENT lblbacqa012_a 'SECRET', COMPONENT lblbacqa012_s 'RD', COMPONENT lblbacqa012_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa012_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa012_p' AND label_name='secret';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa012_p.internal COMPONENT lblbacqa012_a 'INTERNAL', COMPONENT lblbacqa012_s 'RD', COMPONENT lblbacqa012_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa012_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa012_p' AND label_name='internal';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa012_p.public COMPONENT lblbacqa012_a 'PUBLIC', COMPONENT lblbacqa012_s 'RD', COMPONENT lblbacqa012_t 'A1';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa012_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa012_p' AND label_name='public';

-- 37. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa012_p.wide COMPONENT lblbacqa012_a 'SECRET', COMPONENT lblbacqa012_s 'RD','QA', COMPONENT lblbacqa012_t 'ROOT';

-- 38. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa012_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa012_p' AND label_name='wide';

-- 39. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacqa012_p TO USER root;

-- 40. 创建用例使用的普通用户
CREATE USER lblbacqa012_u 'LbacTest_2026!';

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacqa012_db TO USER lblbacqa012_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacqa012_db TO USER lblbacqa012_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacqa012_db TO USER lblbacqa012_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacqa012_db TO USER lblbacqa012_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacqa012_db TO USER lblbacqa012_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacqa012_db TO USER lblbacqa012_u;

-- 47. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacqa012_p;

-- 48. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 49. 创建用例使用的普通用户
CREATE USER lblbacqa012_v 'LbacTest_2026!';

-- 50. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacqa012_db TO USER lblbacqa012_v;

-- 51. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacqa012_db TO USER lblbacqa012_v;

-- 52. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacqa012_db TO USER lblbacqa012_v;

-- 53. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacqa012_db TO USER lblbacqa012_v;

-- 54. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacqa012_db TO USER lblbacqa012_v;

-- 55. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacqa012_db TO USER lblbacqa012_v;

-- 56. 创建用例使用的角色
CREATE ROLE lblbacqa012_r;

-- 57. 授予或撤销用户的角色
GRANT ROLE lblbacqa012_r TO lblbacqa012_u;

-- 58. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacqa012_p.secret TO USER lblbacqa012_u FOR READ ACCESS;

-- 59. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacqa012_p.secret TO USER lblbacqa012_u FOR WRITE ACCESS;

-- 60. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacqa012_p.public TO USER lblbacqa012_v FOR READ ACCESS;

-- 61. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacqa012_p.public TO USER lblbacqa012_v FOR WRITE ACCESS;

-- 62. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacqa012_p.internal TO ROLE lblbacqa012_r FOR READ ACCESS;

-- 63. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacqa012_p.internal TO ROLE lblbacqa012_r FOR WRITE ACCESS;

-- 64. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE LBACREADTREE FOR lblbacqa012_p TO USER lblbacqa012_u;

-- 65. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE LBACREADARRAY FOR lblbacqa012_p TO USER lblbacqa012_v;

-- 66. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE LBACREADSET FOR lblbacqa012_p TO ROLE lblbacqa012_r;

-- 67. 修改 LBAC 安全策略并验证策略行为
ALTER SECURITY POLICY lblbacqa012_p IGNORE ROLE AUTHORIZATIONS;

-- 68. 使用当前测试账号建立数据库连接
connect lblbacqa012_u/LbacTest_2026!;

-- 69. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 70. 切换当前数据库或元数据查询范围
USE lblbacqa012_db;

-- 71. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_access WHERE policy_name='lblbacqa012_p' AND grantee='lblbacqa012_v';

-- 72. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=2 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_access WHERE policy_name='lblbacqa012_p' AND grantee='lblbacqa012_r';

-- 73. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
