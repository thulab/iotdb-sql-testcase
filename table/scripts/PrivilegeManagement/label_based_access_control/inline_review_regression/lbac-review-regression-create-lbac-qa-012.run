-- 75. 角色应分别保有 READ 与 WRITE 两个授权方向。；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_access WHERE policy_name='lblbacqa012_p' AND grantee='lblbacqa012_r' AND label_name='internal' AND access_type='READ';

-- 76. 查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_access WHERE policy_name='lblbacqa012_p' AND grantee='lblbacqa012_r' AND label_name='internal' AND access_type='WRITE';

