-- 59. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacqa008_p.secret TO USER lblbacqa008_u FOR WRITE ACCESS;
-- 切回测试账号继续用例
connect lblbacqa008_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbacqa008_db;

-- 60. 切换当前数据库或元数据查询范围
USE lblbacqa008_db;

-- 61. 更新测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
