connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lblbacqa007_db;
CREATE SECURITY LABEL lblbacqa007_p.both COMPONENT lblbacqa007_a 'SECRET', COMPONENT lblbacqa007_s 'RD', COMPONENT lblbacqa007_t 'A1';
-- 切回测试账号继续用例
connect lblbacqa007_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbacqa007_db;

-- 60. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa007_p' AND MIN(label_name)='both' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa007_p' AND label_name='both';

-- 61. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lblbacqa007_db;
REVOKE SECURITY LABEL lblbacqa007_p.internal FROM USER lblbacqa007_u;

-- 62. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacqa007_p.both TO USER lblbacqa007_u FOR WRITE ACCESS;

-- 63. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE LBACWRITEARRAY WRITE_DOWN FOR lblbacqa007_p TO USER lblbacqa007_u;
-- 切回测试账号继续用例
connect lblbacqa007_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbacqa007_db;

-- 64. 切换当前数据库或元数据查询范围
USE lblbacqa007_db;

-- 65. 删除测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
DELETE FROM wv WHERE tag_alias='d1';
<<SQLSTATE;

