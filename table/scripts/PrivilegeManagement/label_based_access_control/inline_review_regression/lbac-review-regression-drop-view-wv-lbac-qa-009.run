-- 视图 SELECT * 与集合运算整体拒绝

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacqa009_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacqa009_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacqa009_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa009_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa009_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa009_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa009_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacqa009_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacqa009_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacqa009_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacqa009_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacqa009_t;
<<NULL;

-- 16. 操作步骤: 视图映射可读 public 和不可读 secret，执行 SELECT *；再以UNION、UNION ALL 组合读取 secret 的分支与公开常量分支。；预期结果: 星号或任一集合分支触及无权列时整句拒绝，不先返回公开分支结果，也不通过布尔值、行数或错误差异泄露信息。；创建本用例隔离的测试数据库
CREATE DATABASE lblbacqa009_db;

-- 17. 切换当前数据库或元数据查询范围
USE lblbacqa009_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacqa009_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacqa009_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacqa009_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacqa009_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacqa009_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacqa009_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacqa009_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacqa009_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacqa009_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacqa009_p COMPONENTS lblbacqa009_a,lblbacqa009_s,lblbacqa009_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa009_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacqa009_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacqa009_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa009_p.top COMPONENT lblbacqa009_a 'TOP', COMPONENT lblbacqa009_s 'RD', COMPONENT lblbacqa009_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa009_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa009_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa009_p.secret COMPONENT lblbacqa009_a 'SECRET', COMPONENT lblbacqa009_s 'RD', COMPONENT lblbacqa009_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa009_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa009_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa009_p.internal COMPONENT lblbacqa009_a 'INTERNAL', COMPONENT lblbacqa009_s 'RD', COMPONENT lblbacqa009_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa009_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa009_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa009_p.public COMPONENT lblbacqa009_a 'PUBLIC', COMPONENT lblbacqa009_s 'RD', COMPONENT lblbacqa009_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa009_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa009_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacqa009_p.wide COMPONENT lblbacqa009_a 'SECRET', COMPONENT lblbacqa009_s 'RD','QA', COMPONENT lblbacqa009_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacqa009_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacqa009_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacqa009_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lblbacqa009_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacqa009_db TO USER lblbacqa009_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacqa009_db TO USER lblbacqa009_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacqa009_db TO USER lblbacqa009_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacqa009_db TO USER lblbacqa009_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacqa009_db TO USER lblbacqa009_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacqa009_db TO USER lblbacqa009_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacqa009_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 执行 CREATE 操作并验证用例行为
CREATE WRITABLE VIEW wv AS SELECT device,plain,high AS protected_alias FROM metrics WITH (schema_cascade=false);

-- 48. 执行 CREATE 操作并验证用例行为
CREATE VIEW lv AS SELECT device,plain,high AS protected_alias FROM metrics;

-- 49. 切换当前数据库或元数据查询范围
USE lblbacqa009_db;

-- 50. 使用当前测试账号建立数据库连接
connect lblbacqa009_u/LbacTest_2026!;

-- 51. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 52. 切换当前数据库或元数据查询范围
USE lblbacqa009_db;

-- 53. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT * FROM wv;
<<SQLSTATE;

-- 54. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT plain FROM wv UNION SELECT protected_alias FROM wv;
<<SQLSTATE;

-- 55. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT plain FROM wv UNION ALL SELECT protected_alias FROM wv;
<<SQLSTATE;

-- 56. 切换当前数据库或元数据查询范围
USE lblbacqa009_db;

-- 57. 执行 DROP 操作并验证用例行为
DROP VIEW lv;

-- 58. 执行 DROP 操作并验证用例行为
DROP VIEW wv;

-- 59. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
