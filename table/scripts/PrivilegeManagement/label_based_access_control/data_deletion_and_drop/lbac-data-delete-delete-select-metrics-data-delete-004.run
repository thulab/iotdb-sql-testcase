-- 53. 删除测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
DELETE FROM metrics WHERE device='d1';
<<SQLSTATE;

-- 54. 删除测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
DELETE FROM metrics WHERE time=1;
<<SQLSTATE;

-- 55. 删除测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
DELETE FROM metrics WHERE owner='alice';
<<SQLSTATE;

-- 56. 删除测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
DELETE FROM metrics WHERE high>0;
<<SQLSTATE;

-- 57. 切换当前数据库或元数据查询范围
USE lbdatadelete004_db;

-- 58. 授予或撤销安全标签访问权限并验证授权行为
