-- 解除列保护不要求 SECURITY

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataremove006_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataremove006_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataremove006_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataremove006_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataremove006_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataremove006_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataremove006_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataremove006_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataremove006_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataremove006_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataremove006_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataremove006_t;
<<NULL;

-- 16. 操作步骤: 明确撤销 SECURITY 后，由具备目标表 ALTER 和当前 Label READ+WRITE 的主体解除受保护列。；预期结果: 解除成功；列级保护修改由 ALTER 与 LBAC 控制，SECURITY 不是隐含前提。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataremove006_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbdataremove006_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataremove006_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataremove006_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataremove006_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataremove006_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataremove006_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataremove006_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataremove006_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataremove006_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataremove006_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataremove006_p COMPONENTS lbdataremove006_a,lbdataremove006_s,lbdataremove006_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataremove006_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataremove006_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataremove006_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataremove006_p.top COMPONENT lbdataremove006_a 'TOP', COMPONENT lbdataremove006_s 'RD', COMPONENT lbdataremove006_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataremove006_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataremove006_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataremove006_p.secret COMPONENT lbdataremove006_a 'SECRET', COMPONENT lbdataremove006_s 'RD', COMPONENT lbdataremove006_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataremove006_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataremove006_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataremove006_p.internal COMPONENT lbdataremove006_a 'INTERNAL', COMPONENT lbdataremove006_s 'RD', COMPONENT lbdataremove006_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataremove006_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataremove006_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataremove006_p.public COMPONENT lbdataremove006_a 'PUBLIC', COMPONENT lbdataremove006_s 'RD', COMPONENT lbdataremove006_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataremove006_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataremove006_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataremove006_p.wide COMPONENT lbdataremove006_a 'SECRET', COMPONENT lbdataremove006_s 'RD','QA', COMPONENT lbdataremove006_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataremove006_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataremove006_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataremove006_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbdataremove006_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataremove006_db TO USER lbdataremove006_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataremove006_db TO USER lbdataremove006_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataremove006_db TO USER lbdataremove006_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataremove006_db TO USER lbdataremove006_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataremove006_db TO USER lbdataremove006_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataremove006_db TO USER lbdataremove006_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataremove006_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataremove006_p.secret TO USER lbdataremove006_u FOR READ ACCESS;

-- 48. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataremove006_p.secret TO USER lbdataremove006_u FOR WRITE ACCESS;

-- 49. 使用当前测试账号建立数据库连接
connect lbdataremove006_u/LbacTest_2026!;

-- 50. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 51. 切换当前数据库或元数据查询范围
USE lbdataremove006_db;

-- 52. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN high DROP COLUMN SECURITY;

-- 53. 切换当前数据库或元数据查询范围
USE lbdataremove006_db;

-- 54. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbdataremove006_db' AND table_name='metrics' AND column_name='high' AND security_label IS NULL;

-- 55. 切换当前数据库或元数据查询范围
USE lbdataremove006_db;

-- 56. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(plain)=10 AND MIN(low)=20 AND MIN(high)=30 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;

-- 57. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lbdataremove006_db;
<<NULL;

-- 58. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
