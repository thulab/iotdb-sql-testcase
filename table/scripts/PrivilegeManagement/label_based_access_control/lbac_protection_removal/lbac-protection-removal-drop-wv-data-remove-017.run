-- 52. 切换当前数据库或元数据查询范围
USE lbdataremove017_db;

-- 53. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT protected_alias FROM wv;
<<SQLSTATE;

