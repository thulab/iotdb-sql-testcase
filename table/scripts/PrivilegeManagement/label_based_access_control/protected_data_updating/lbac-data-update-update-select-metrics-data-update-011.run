-- UPDATE 的 RBAC 先于 LBAC

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataupdate011_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataupdate011_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataupdate011_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate011_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate011_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate011_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate011_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate011_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataupdate011_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataupdate011_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataupdate011_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataupdate011_t;
<<NULL;

-- 16. 操作步骤: 用户有 owner Label WRITE，但无表模型 UPDATE 所需普通写权限，尝试更新 owner。；预期结果: RBAC 拒绝且不暴露 Label 比较细节；所有数据不变。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataupdate011_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbdataupdate011_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataupdate011_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataupdate011_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataupdate011_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataupdate011_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataupdate011_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataupdate011_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataupdate011_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataupdate011_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataupdate011_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataupdate011_p COMPONENTS lbdataupdate011_a,lbdataupdate011_s,lbdataupdate011_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate011_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataupdate011_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataupdate011_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate011_p.top COMPONENT lbdataupdate011_a 'TOP', COMPONENT lbdataupdate011_s 'RD', COMPONENT lbdataupdate011_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate011_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate011_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate011_p.secret COMPONENT lbdataupdate011_a 'SECRET', COMPONENT lbdataupdate011_s 'RD', COMPONENT lbdataupdate011_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate011_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate011_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate011_p.internal COMPONENT lbdataupdate011_a 'INTERNAL', COMPONENT lbdataupdate011_s 'RD', COMPONENT lbdataupdate011_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate011_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate011_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate011_p.public COMPONENT lbdataupdate011_a 'PUBLIC', COMPONENT lbdataupdate011_s 'RD', COMPONENT lbdataupdate011_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate011_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate011_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate011_p.wide COMPONENT lbdataupdate011_a 'SECRET', COMPONENT lbdataupdate011_s 'RD','QA', COMPONENT lbdataupdate011_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate011_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate011_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataupdate011_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbdataupdate011_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataupdate011_db TO USER lbdataupdate011_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataupdate011_db TO USER lbdataupdate011_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataupdate011_db TO USER lbdataupdate011_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataupdate011_db TO USER lbdataupdate011_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataupdate011_db TO USER lbdataupdate011_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataupdate011_db TO USER lbdataupdate011_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG ,owner STRING ATTRIBUTE SECURED WITH secret,site STRING ATTRIBUTE,plain INT32 FIELD,low INT32 FIELD,high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataupdate011_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,site,plain,low,high) VALUES(1,'d1','alice','west',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataupdate011_p.secret TO USER lbdataupdate011_u FOR READ ACCESS;

-- 48. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataupdate011_p.secret TO USER lbdataupdate011_u FOR WRITE ACCESS;

-- 49. 执行 REVOKE 操作并验证用例行为
REVOKE INSERT ON DATABASE lbdataupdate011_db FROM USER lbdataupdate011_u;

-- 50. 使用当前测试账号建立数据库连接
connect lbdataupdate011_u/LbacTest_2026!;

-- 51. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 52. 切换当前数据库或元数据查询范围
USE lbdataupdate011_db;

-- 53. 更新测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
UPDATE metrics SET owner='changed' WHERE device='d1';
<<SQLSTATE;

-- 54. 切换当前数据库或元数据查询范围
USE lbdataupdate011_db;

-- 55. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(owner)='alice' AND MIN(site)='west' AND MIN(high)=30 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;

-- 56. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lbdataupdate011_db;
<<NULL;

-- 57. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbdataupdate011_db;
<<NULL;

-- 58. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 59. 清理本用例创建的数据表
USE lbdataupdate011_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 60. 切换当前数据库或元数据查询范围
USE information_schema;

-- 61. 删除本用例隔离的测试数据库
DROP DATABASE lbdataupdate011_db;
<<NULL;

-- 62. 删除用例创建的普通用户
DROP USER lbdataupdate011_u;
<<NULL;

-- 63. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbdataupdate011_p FROM USER root;
<<NULL;

-- 64. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataupdate011_p.wide;
<<NULL;

-- 65. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataupdate011_p.public;
<<NULL;

-- 66. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataupdate011_p.internal;
<<NULL;

-- 67. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataupdate011_p.secret;
<<NULL;

-- 68. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataupdate011_p.top;
<<NULL;

-- 69. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbdataupdate011_p;
<<NULL;

-- 70. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdataupdate011_t;

-- 71. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdataupdate011_s;

-- 72. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdataupdate011_a;

-- 73. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

