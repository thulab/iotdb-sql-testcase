-- 保护目标与保护谓词需 WRITE 加 READ

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataupdate005_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataupdate005_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataupdate005_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate005_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate005_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate005_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate005_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate005_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataupdate005_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataupdate005_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataupdate005_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataupdate005_t;
<<NULL;

-- 16. 操作步骤: 以受保护 device 为条件更新另一 Label 保护的 owner，分别测试只缺 owner WRITE、只缺 device READ 和两者齐全。；预期结果: 仅 WRITE 与 READ 均齐全时成功；任一缺失整句拒绝，无部分设备或列更新。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataupdate005_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbdataupdate005_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataupdate005_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataupdate005_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataupdate005_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataupdate005_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataupdate005_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataupdate005_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataupdate005_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataupdate005_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataupdate005_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataupdate005_p COMPONENTS lbdataupdate005_a,lbdataupdate005_s,lbdataupdate005_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate005_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataupdate005_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataupdate005_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate005_p.top COMPONENT lbdataupdate005_a 'TOP', COMPONENT lbdataupdate005_s 'RD', COMPONENT lbdataupdate005_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate005_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate005_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate005_p.secret COMPONENT lbdataupdate005_a 'SECRET', COMPONENT lbdataupdate005_s 'RD', COMPONENT lbdataupdate005_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate005_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate005_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate005_p.internal COMPONENT lbdataupdate005_a 'INTERNAL', COMPONENT lbdataupdate005_s 'RD', COMPONENT lbdataupdate005_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate005_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate005_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate005_p.public COMPONENT lbdataupdate005_a 'PUBLIC', COMPONENT lbdataupdate005_s 'RD', COMPONENT lbdataupdate005_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate005_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate005_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate005_p.wide COMPONENT lbdataupdate005_a 'SECRET', COMPONENT lbdataupdate005_s 'RD','QA', COMPONENT lbdataupdate005_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate005_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate005_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataupdate005_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbdataupdate005_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataupdate005_db TO USER lbdataupdate005_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataupdate005_db TO USER lbdataupdate005_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataupdate005_db TO USER lbdataupdate005_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataupdate005_db TO USER lbdataupdate005_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataupdate005_db TO USER lbdataupdate005_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataupdate005_db TO USER lbdataupdate005_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG SECURED WITH secret,owner STRING ATTRIBUTE SECURED WITH secret,site STRING ATTRIBUTE,plain INT32 FIELD,low INT32 FIELD,high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataupdate005_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,site,plain,low,high) VALUES(1,'d1','alice','west',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataupdate005_p.secret TO USER lbdataupdate005_u FOR READ ACCESS;

-- 48. 使用当前测试账号建立数据库连接
connect lbdataupdate005_u/LbacTest_2026!;

-- 49. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 50. 切换当前数据库或元数据查询范围
USE lbdataupdate005_db;

-- 51. 更新测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
UPDATE metrics SET owner='changed' WHERE device='d1';
<<SQLSTATE;

-- 52. 切换当前数据库或元数据查询范围
