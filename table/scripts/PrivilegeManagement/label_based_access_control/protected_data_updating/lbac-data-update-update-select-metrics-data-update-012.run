-- 批量命中多设备更新保持原子

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataupdate012_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataupdate012_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataupdate012_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate012_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate012_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate012_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate012_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataupdate012_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataupdate012_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataupdate012_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataupdate012_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataupdate012_t;
<<NULL;

-- 16. 操作步骤: 有 owner WRITE 的用户，以未保护 TAG 条件一次更新至少三台设备的 owner；再构造所需 LBAC 不满足的执行。；预期结果: 权限满足时全部命中设备成功；任一必要检查失败时整句不修改任何设备。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataupdate012_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbdataupdate012_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataupdate012_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataupdate012_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataupdate012_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataupdate012_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataupdate012_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataupdate012_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataupdate012_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataupdate012_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataupdate012_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataupdate012_p COMPONENTS lbdataupdate012_a,lbdataupdate012_s,lbdataupdate012_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate012_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataupdate012_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataupdate012_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate012_p.top COMPONENT lbdataupdate012_a 'TOP', COMPONENT lbdataupdate012_s 'RD', COMPONENT lbdataupdate012_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate012_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate012_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate012_p.secret COMPONENT lbdataupdate012_a 'SECRET', COMPONENT lbdataupdate012_s 'RD', COMPONENT lbdataupdate012_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate012_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate012_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate012_p.internal COMPONENT lbdataupdate012_a 'INTERNAL', COMPONENT lbdataupdate012_s 'RD', COMPONENT lbdataupdate012_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate012_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate012_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate012_p.public COMPONENT lbdataupdate012_a 'PUBLIC', COMPONENT lbdataupdate012_s 'RD', COMPONENT lbdataupdate012_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate012_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate012_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataupdate012_p.wide COMPONENT lbdataupdate012_a 'SECRET', COMPONENT lbdataupdate012_s 'RD','QA', COMPONENT lbdataupdate012_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataupdate012_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataupdate012_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataupdate012_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbdataupdate012_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataupdate012_db TO USER lbdataupdate012_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataupdate012_db TO USER lbdataupdate012_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataupdate012_db TO USER lbdataupdate012_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataupdate012_db TO USER lbdataupdate012_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataupdate012_db TO USER lbdataupdate012_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataupdate012_db TO USER lbdataupdate012_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG ,owner STRING ATTRIBUTE SECURED WITH secret,site STRING ATTRIBUTE,plain INT32 FIELD,low INT32 FIELD,high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataupdate012_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,site,plain,low,high) VALUES(1,'d1','alice','west',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataupdate012_p.secret TO USER lbdataupdate012_u FOR READ ACCESS;

-- 48. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataupdate012_p.secret TO USER lbdataupdate012_u FOR WRITE ACCESS;

-- 49. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain) VALUES(2,'d2','alice',20),(3,'d3','alice',30);

-- 50. 使用当前测试账号建立数据库连接
connect lbdataupdate012_u/LbacTest_2026!;

-- 51. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 52. 切换当前数据库或元数据查询范围
USE lbdataupdate012_db;

-- 53. 更新测试数据并验证 LBAC 写入控制
UPDATE metrics SET owner='changed' WHERE device IS NOT NULL;

-- 54. 切换当前数据库或元数据查询范围
USE lbdataupdate012_db;

-- 55. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=3 AND COUNT(owner)=3 AND MIN(owner)='changed' AND MAX(owner)='changed' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;

-- 56. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataupdate012_db;
REVOKE SECURITY LABEL lbdataupdate012_p.secret FROM USER lbdataupdate012_u;
-- 切回测试账号继续用例
connect lbdataupdate012_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataupdate012_db;

-- 57. 切换当前数据库或元数据查询范围
USE lbdataupdate012_db;

-- 58. 更新测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
UPDATE metrics SET owner='forbidden' WHERE device IS NOT NULL;
<<SQLSTATE;

-- 59. 切换当前数据库或元数据查询范围
USE lbdataupdate012_db;

-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataupdate012_db;
-- 60. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=3 AND MIN(owner)='changed' AND MAX(owner)='changed' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;
-- 切回测试账号继续用例
connect lbdataupdate012_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataupdate012_db;

-- 61. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lbdataupdate012_db;
<<NULL;

-- 62. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
