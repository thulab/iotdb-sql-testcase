DROP SECURITY LABEL lblbac068_p.secret;
<<NULL;

-- 65. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac068_p.top;
<<NULL;

-- 66. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lblbac068_p;
<<NULL;

-- 67. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac068_t;

-- 68. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac068_s;

-- 69. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac068_a;

