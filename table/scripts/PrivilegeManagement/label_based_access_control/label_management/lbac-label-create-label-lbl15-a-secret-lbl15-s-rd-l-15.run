-- p_mix.l_full 存在，管理标签备注

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbl15_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbl15_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbl15_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl15_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl15_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl15_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl15_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl15_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbl15_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbl15_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbl15_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbl15_t;
<<NULL;

-- 16. 创建本用例隔离的测试数据库
CREATE DATABASE lbl15_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbl15_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbl15_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbl15_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbl15_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbl15_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbl15_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbl15_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbl15_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbl15_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbl15_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbl15_p COMPONENTS lbl15_a,lbl15_s,lbl15_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl15_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbl15_p';

-- 26. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl15_p.top COMPONENT lbl15_a 'TOP', COMPONENT lbl15_s 'RD', COMPONENT lbl15_t 'A1';

-- 27. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl15_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl15_p' AND label_name='top';

-- 28. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl15_p.secret COMPONENT lbl15_a 'SECRET', COMPONENT lbl15_s 'RD', COMPONENT lbl15_t 'A1';

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl15_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl15_p' AND label_name='secret';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl15_p.internal COMPONENT lbl15_a 'INTERNAL', COMPONENT lbl15_s 'RD', COMPONENT lbl15_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl15_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl15_p' AND label_name='internal';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl15_p.public COMPONENT lbl15_a 'PUBLIC', COMPONENT lbl15_s 'RD', COMPONENT lbl15_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl15_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl15_p' AND label_name='public';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl15_p.wide COMPONENT lbl15_a 'SECRET', COMPONENT lbl15_s 'RD','QA', COMPONENT lbl15_t 'ROOT';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl15_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl15_p' AND label_name='wide';

-- 36. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbl15_p TO USER root;

-- 37. 创建用例使用的普通用户
CREATE USER lbl15_u 'LbacTest_2026!';

-- 38. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbl15_db TO USER lbl15_u;

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbl15_db TO USER lbl15_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbl15_db TO USER lbl15_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbl15_db TO USER lbl15_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbl15_db TO USER lbl15_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbl15_db TO USER lbl15_u;

-- 44. 设置安全标签备注并验证元数据
COMMENT ON SECURITY LABEL lbl15_p.secret IS 'v1';

-- 45. 设置安全标签备注并验证元数据
COMMENT ON SECURITY LABEL lbl15_p.secret IS 'v2';

-- 46. 设置安全标签备注并验证元数据
COMMENT ON SECURITY LABEL lbl15_p.secret IS NULL;

-- 47. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 AND COUNT(remarks)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl15_p' AND label_name='secret';

-- 48. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
