-- 受保护列引用 policy.l_bound

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbl19_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbl19_p FROM USER root;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl19_p.top;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl19_p.secret;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl19_p.internal;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl19_p.public;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl19_p.wide;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbl19_p;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbl19_a;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbl19_s;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbl19_t;
<<NULL;

-- 15. 创建本用例隔离的测试数据库
CREATE DATABASE lbl19_db;

-- 16. 切换当前数据库或元数据查询范围
USE lbl19_db;

-- 17. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbl19_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 18. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbl19_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbl19_a';

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbl19_s SET ('RD','QA','OPS');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbl19_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbl19_s';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbl19_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbl19_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbl19_t';

-- 23. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbl19_p COMPONENTS lbl19_a,lbl19_s,lbl19_t WITH LBACRULES;

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl19_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbl19_p';

-- 25. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl19_p.top COMPONENT lbl19_a 'TOP', COMPONENT lbl19_s 'RD', COMPONENT lbl19_t 'A1';

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl19_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl19_p' AND label_name='top';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl19_p.secret COMPONENT lbl19_a 'SECRET', COMPONENT lbl19_s 'RD', COMPONENT lbl19_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl19_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl19_p' AND label_name='secret';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl19_p.internal COMPONENT lbl19_a 'INTERNAL', COMPONENT lbl19_s 'RD', COMPONENT lbl19_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl19_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl19_p' AND label_name='internal';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl19_p.public COMPONENT lbl19_a 'PUBLIC', COMPONENT lbl19_s 'RD', COMPONENT lbl19_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl19_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl19_p' AND label_name='public';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl19_p.wide COMPONENT lbl19_a 'SECRET', COMPONENT lbl19_s 'RD','QA', COMPONENT lbl19_t 'ROOT';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl19_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl19_p' AND label_name='wide';

-- 35. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbl19_p TO USER root;

-- 36. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbl19_p;

-- 37. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 38. 删除安全标签并验证依赖约束；本语句预期失败，需核对 SQLSTATE 及错误原因
DROP SECURITY LABEL lbl19_p.internal;
<<SQLSTATE;

-- 39. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbl19_db;
<<NULL;

-- 40. 清理本用例创建的数据表
DROP TABLE IF EXISTS metrics;
<<NULL;

