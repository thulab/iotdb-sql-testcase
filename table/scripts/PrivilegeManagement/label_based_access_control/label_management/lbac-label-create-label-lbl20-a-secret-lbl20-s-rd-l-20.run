DROP USER lbl20_v;
<<NULL;

-- 71. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbl20_p FROM USER root;
<<NULL;

-- 72. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbl20_p.wide;
<<NULL;

-- 73. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbl20_p.public;
<<NULL;

-- 74. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbl20_p.internal;
<<NULL;

-- 75. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbl20_p.top;
<<NULL;

-- 76. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbl20_p;
<<NULL;

-- 77. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbl20_t;

-- 78. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbl20_s;

-- 79. 删除安全标签组件并验证引用约束
