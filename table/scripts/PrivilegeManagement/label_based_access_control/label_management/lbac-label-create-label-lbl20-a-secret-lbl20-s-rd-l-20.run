-- 标签被多个主体及列引用

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbl20_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbl20_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP USER lbl20_v;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbl20_p FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl20_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl20_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl20_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl20_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbl20_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbl20_p;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbl20_a;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbl20_s;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbl20_t;
<<NULL;

-- 17. 创建本用例隔离的测试数据库
CREATE DATABASE lbl20_db;

-- 18. 切换当前数据库或元数据查询范围
USE lbl20_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbl20_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbl20_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbl20_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbl20_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbl20_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbl20_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbl20_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbl20_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbl20_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbl20_p COMPONENTS lbl20_a,lbl20_s,lbl20_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl20_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbl20_p';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl20_p.top COMPONENT lbl20_a 'TOP', COMPONENT lbl20_s 'RD', COMPONENT lbl20_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl20_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl20_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl20_p.secret COMPONENT lbl20_a 'SECRET', COMPONENT lbl20_s 'RD', COMPONENT lbl20_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl20_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl20_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl20_p.internal COMPONENT lbl20_a 'INTERNAL', COMPONENT lbl20_s 'RD', COMPONENT lbl20_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl20_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl20_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl20_p.public COMPONENT lbl20_a 'PUBLIC', COMPONENT lbl20_s 'RD', COMPONENT lbl20_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl20_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl20_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbl20_p.wide COMPONENT lbl20_a 'SECRET', COMPONENT lbl20_s 'RD','QA', COMPONENT lbl20_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbl20_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbl20_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbl20_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbl20_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbl20_db TO USER lbl20_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbl20_db TO USER lbl20_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbl20_db TO USER lbl20_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbl20_db TO USER lbl20_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbl20_db TO USER lbl20_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbl20_db TO USER lbl20_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbl20_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbl20_p.secret TO USER lbl20_u FOR ALL ACCESS;

-- 48. 创建用例使用的普通用户
CREATE USER lbl20_v 'LbacTest_2026!';

-- 49. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbl20_db TO USER lbl20_v;

-- 50. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbl20_db TO USER lbl20_v;

-- 51. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbl20_db TO USER lbl20_v;

-- 52. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbl20_db TO USER lbl20_v;

-- 53. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbl20_db TO USER lbl20_v;

-- 54. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbl20_db TO USER lbl20_v;

-- 55. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbl20_p.secret TO USER lbl20_v FOR ALL ACCESS;

-- 56. 删除安全标签并验证依赖约束；本语句预期失败，需核对 SQLSTATE 及错误原因
DROP SECURITY LABEL lbl20_p.secret;
<<SQLSTATE;

-- 57. 授予或撤销安全标签访问权限并验证授权行为
REVOKE SECURITY LABEL lbl20_p.secret FROM USER lbl20_u;

-- 58. 删除安全标签并验证依赖约束；本语句预期失败，需核对 SQLSTATE 及错误原因
DROP SECURITY LABEL lbl20_p.secret;
<<SQLSTATE;

-- 60. 切换当前数据库或元数据查询范围
USE lbl20_db;

-- 61. 授予或撤销安全标签访问权限并验证授权行为
REVOKE SECURITY LABEL lbl20_p.secret FROM USER lbl20_v;

-- 62. 删除安全标签并验证依赖约束；本语句预期失败，需核对 SQLSTATE 及错误原因
DROP SECURITY LABEL lbl20_p.secret;
<<SQLSTATE;

-- 63. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN high DROP COLUMN SECURITY;

-- 64. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbl20_p.secret;

-- 65. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbl20_db;
<<NULL;

-- 66. 清理本用例创建的数据表
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 67. 切换当前数据库或元数据查询范围
