DROP SECURITY LABEL lbl13_p.internal;
<<NULL;

-- 57. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbl13_p.secret;
<<NULL;

-- 58. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbl13_p.top;
<<NULL;

-- 59. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbl13_p;
<<NULL;

-- 60. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbl13_t;

-- 61. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbl13_s;

-- 62. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbl13_a;

