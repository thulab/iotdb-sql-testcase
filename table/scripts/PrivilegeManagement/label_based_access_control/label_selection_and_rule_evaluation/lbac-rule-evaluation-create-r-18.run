<<NULL;

-- 61. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbr18_p FROM USER root;
<<NULL;

-- 62. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbr18_p.wide;
<<NULL;

-- 63. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbr18_p.public;
<<NULL;

-- 64. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbr18_p.internal;
<<NULL;

-- 65. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbr18_p.secret;
<<NULL;

-- 66. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbr18_p.top;
<<NULL;

-- 67. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbr18_p;
<<NULL;

-- 68. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbr18_t;

-- 69. 删除安全标签组件并验证引用约束
