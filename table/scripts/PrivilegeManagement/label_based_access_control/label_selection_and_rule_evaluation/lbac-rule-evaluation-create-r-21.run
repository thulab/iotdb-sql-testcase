-- 策略启用角色，用户及多个角色各有标签

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbr21_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbr21_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP ROLE lbr21_r;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbr21_p FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbr21_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbr21_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbr21_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbr21_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbr21_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbr21_p.part_left;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbr21_p.part_right;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbr21_p.target;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbr21_p;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbr21_a;
<<NULL;

-- 18. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbr21_s;
<<NULL;

-- 19. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbr21_t;
<<NULL;

-- 20. 创建本用例隔离的测试数据库
CREATE DATABASE lbr21_db;

-- 21. 切换当前数据库或元数据查询范围
USE lbr21_db;

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbr21_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbr21_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbr21_a';

-- 24. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbr21_s SET ('RD','QA','OPS');

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbr21_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbr21_s';

-- 26. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbr21_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 27. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbr21_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbr21_t';

-- 28. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbr21_p COMPONENTS lbr21_a,lbr21_s,lbr21_t WITH LBACRULES;

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbr21_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbr21_p';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbr21_p.top COMPONENT lbr21_a 'TOP', COMPONENT lbr21_s 'RD', COMPONENT lbr21_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbr21_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbr21_p' AND label_name='top';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbr21_p.secret COMPONENT lbr21_a 'SECRET', COMPONENT lbr21_s 'RD', COMPONENT lbr21_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbr21_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbr21_p' AND label_name='secret';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbr21_p.internal COMPONENT lbr21_a 'INTERNAL', COMPONENT lbr21_s 'RD', COMPONENT lbr21_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbr21_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbr21_p' AND label_name='internal';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbr21_p.public COMPONENT lbr21_a 'PUBLIC', COMPONENT lbr21_s 'RD', COMPONENT lbr21_t 'A1';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbr21_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbr21_p' AND label_name='public';

-- 38. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbr21_p.wide COMPONENT lbr21_a 'SECRET', COMPONENT lbr21_s 'RD','QA', COMPONENT lbr21_t 'ROOT';

-- 39. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbr21_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbr21_p' AND label_name='wide';

-- 40. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbr21_p TO USER root;

-- 41. 创建用例使用的普通用户
CREATE USER lbr21_u 'LbacTest_2026!';

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbr21_db TO USER lbr21_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbr21_db TO USER lbr21_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbr21_db TO USER lbr21_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbr21_db TO USER lbr21_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbr21_db TO USER lbr21_u;

-- 47. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbr21_db TO USER lbr21_u;

-- 48. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbr21_p;

-- 49. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 50. 创建用例使用的角色
CREATE ROLE lbr21_r;

-- 51. 授予或撤销用户的角色
GRANT ROLE lbr21_r TO lbr21_u;

-- 52. 修改 LBAC 安全策略并验证策略行为
ALTER SECURITY POLICY lbr21_p USE ROLE AUTHORIZATIONS;

-- 53. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbr21_p.part_left COMPONENT lbr21_a 'PUBLIC',COMPONENT lbr21_s 'RD',COMPONENT lbr21_t 'A';

-- 54. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbr21_p' AND MIN(label_name)='part_left' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbr21_p' AND label_name='part_left';

-- 55. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbr21_p.part_right COMPONENT lbr21_a 'SECRET',COMPONENT lbr21_s 'QA',COMPONENT lbr21_t 'B';

-- 56. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbr21_p' AND MIN(label_name)='part_right' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbr21_p' AND label_name='part_right';

-- 57. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbr21_p.target COMPONENT lbr21_a 'SECRET',COMPONENT lbr21_s 'RD','QA',COMPONENT lbr21_t 'A1','B';

-- 58. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbr21_p' AND MIN(label_name)='target' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbr21_p' AND label_name='target';

-- 59. 创建用于验证 LBAC 保护的数据表
CREATE TABLE merged(v INT32 FIELD SECURED WITH target) SECURITY POLICY lbr21_p;

-- 60. 写入测试数据并验证 LBAC 写入控制
INSERT INTO merged(time,v) VALUES(1,1);

-- 61. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbr21_p.part_left TO USER lbr21_u FOR READ ACCESS;

-- 62. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbr21_p.part_right TO ROLE lbr21_r FOR READ ACCESS;

-- 63. 使用当前测试账号建立数据库连接
connect lbr21_u/LbacTest_2026!;

-- 64. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 65. 切换当前数据库或元数据查询范围
USE lbr21_db;

-- 66. 读取受保护数据并验证 LBAC 读权限
SELECT v FROM merged;

-- 67. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbr21_db;
<<NULL;

-- 68. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 69. 清理本用例创建的数据表
USE lbr21_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

DROP TABLE IF EXISTS merged;

