-- 切回测试账号继续用例
connect lbr11_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbr11_db;

-- 65. 切换当前数据库或元数据查询范围
USE lbr11_db;

-- 66. 读取受保护数据并验证 LBAC 读权限
