-- 同类型多组件豁免的 ordinal 展开

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacnew008_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacnew008_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacnew008_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew008_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew008_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew008_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew008_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew008_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew008_p.object;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew008_p.subject;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacnew008_p;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew008_a;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew008_s;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew008_t;
<<NULL;

-- 18. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew008_s2;
<<NULL;

-- 19. 操作步骤: Policy 含两个 SET 和一个 ARRAY；授 LBACREADSET，查 exemptions 并读取两个 SET 均不满足的列。；预期结果: 两个 SET 对应 ordinal 均获豁免；ARRAY 仍检查；ordinal 与 Policy 顺序一致。；创建本用例隔离的测试数据库
CREATE DATABASE lblbacnew008_db;

-- 20. 切换当前数据库或元数据查询范围
USE lblbacnew008_db;

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew008_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew008_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew008_a';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew008_s SET ('RD','QA','OPS');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew008_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew008_s';

-- 25. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew008_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew008_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew008_t';

-- 27. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacnew008_p COMPONENTS lblbacnew008_a,lblbacnew008_s,lblbacnew008_t WITH LBACRULES;

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew008_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacnew008_p';

-- 29. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew008_p TO USER root;

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew008_p.top COMPONENT lblbacnew008_a 'TOP', COMPONENT lblbacnew008_s 'RD', COMPONENT lblbacnew008_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew008_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew008_p' AND label_name='top';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew008_p.secret COMPONENT lblbacnew008_a 'SECRET', COMPONENT lblbacnew008_s 'RD', COMPONENT lblbacnew008_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew008_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew008_p' AND label_name='secret';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew008_p.internal COMPONENT lblbacnew008_a 'INTERNAL', COMPONENT lblbacnew008_s 'RD', COMPONENT lblbacnew008_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew008_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew008_p' AND label_name='internal';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew008_p.public COMPONENT lblbacnew008_a 'PUBLIC', COMPONENT lblbacnew008_s 'RD', COMPONENT lblbacnew008_t 'A1';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew008_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew008_p' AND label_name='public';

-- 38. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew008_p.wide COMPONENT lblbacnew008_a 'SECRET', COMPONENT lblbacnew008_s 'RD','QA', COMPONENT lblbacnew008_t 'ROOT';

-- 39. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew008_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew008_p' AND label_name='wide';

-- 40. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew008_p TO USER root;

-- 41. 创建用例使用的普通用户
CREATE USER lblbacnew008_u 'LbacTest_2026!';

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacnew008_db TO USER lblbacnew008_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacnew008_db TO USER lblbacnew008_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacnew008_db TO USER lblbacnew008_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacnew008_db TO USER lblbacnew008_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacnew008_db TO USER lblbacnew008_u;

-- 47. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacnew008_db TO USER lblbacnew008_u;

-- 48. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew008_s2 SET ('X','Y');

-- 49. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew008_s2' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew008_s2';

-- 50. 修改 LBAC 安全策略并验证策略行为
ALTER SECURITY POLICY lblbacnew008_p ADD SECURITY LABEL COMPONENT lblbacnew008_s2;

-- 51. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew008_p.object COMPONENT lblbacnew008_a 'SECRET', COMPONENT lblbacnew008_s 'QA', COMPONENT lblbacnew008_s2 'Y';

-- 52. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew008_p' AND MIN(label_name)='object' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew008_p' AND label_name='object';

-- 53. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew008_p.subject COMPONENT lblbacnew008_a 'SECRET', COMPONENT lblbacnew008_s 'RD', COMPONENT lblbacnew008_s2 'X';

-- 54. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew008_p' AND MIN(label_name)='subject' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew008_p' AND label_name='subject';

-- 55. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG,high INT32 FIELD SECURED WITH object) SECURITY POLICY lblbacnew008_p;

-- 56. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew008_p.subject TO USER lblbacnew008_u FOR READ ACCESS;

-- 57. 使用当前测试账号建立数据库连接
connect lblbacnew008_u/LbacTest_2026!;

-- 58. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 59. 切换当前数据库或元数据查询范围
USE lblbacnew008_db;

-- 60. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT high FROM metrics ORDER BY time;
<<SQLSTATE;

