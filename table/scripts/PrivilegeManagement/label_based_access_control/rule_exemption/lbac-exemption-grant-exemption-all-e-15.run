-- u_no_rbac 有 ALL 免除但无普通表权限

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbe15_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbe15_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP USER lbe15_v;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbe15_p FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe15_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe15_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe15_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe15_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe15_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbe15_p;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe15_a;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe15_s;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe15_t;
<<NULL;

-- 17. 创建本用例隔离的测试数据库
CREATE DATABASE lbe15_db;

-- 18. 切换当前数据库或元数据查询范围
USE lbe15_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe15_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe15_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe15_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe15_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe15_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe15_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe15_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe15_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe15_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbe15_p COMPONENTS lbe15_a,lbe15_s,lbe15_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe15_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbe15_p';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe15_p.top COMPONENT lbe15_a 'TOP', COMPONENT lbe15_s 'RD', COMPONENT lbe15_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe15_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe15_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe15_p.secret COMPONENT lbe15_a 'SECRET', COMPONENT lbe15_s 'RD', COMPONENT lbe15_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe15_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe15_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe15_p.internal COMPONENT lbe15_a 'INTERNAL', COMPONENT lbe15_s 'RD', COMPONENT lbe15_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe15_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe15_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe15_p.public COMPONENT lbe15_a 'PUBLIC', COMPONENT lbe15_s 'RD', COMPONENT lbe15_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe15_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe15_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe15_p.wide COMPONENT lbe15_a 'SECRET', COMPONENT lbe15_s 'RD','QA', COMPONENT lbe15_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe15_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe15_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbe15_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbe15_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbe15_db TO USER lbe15_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbe15_db TO USER lbe15_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbe15_db TO USER lbe15_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbe15_db TO USER lbe15_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbe15_db TO USER lbe15_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbe15_db TO USER lbe15_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbe15_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbe15_p.secret TO USER lbe15_u FOR ALL ACCESS;

-- 48. 创建用例使用的普通用户
CREATE USER lbe15_v 'LbacTest_2026!';

-- 49. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbe15_db TO USER lbe15_v;

-- 50. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbe15_p TO USER lbe15_v;

-- 51. 使用当前测试账号建立数据库连接
connect lbe15_v/LbacTest_2026!;

-- 52. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 53. 切换当前数据库或元数据查询范围
USE lbe15_db;

-- 54. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT high FROM metrics ORDER BY time;
<<SQLSTATE;

-- 55. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbe15_db;
<<NULL;

-- 56. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 57. 清理本用例创建的数据表
USE lbe15_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 58. 切换当前数据库或元数据查询范围
USE information_schema;

-- 59. 删除本用例隔离的测试数据库
DROP DATABASE lbe15_db;
<<NULL;

-- 60. 删除用例创建的普通用户
DROP USER lbe15_u;
<<NULL;

-- 61. 删除用例创建的普通用户
DROP USER lbe15_v;
<<NULL;

-- 62. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbe15_p FROM USER root;
<<NULL;

-- 63. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe15_p.wide;
<<NULL;

-- 64. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe15_p.public;
<<NULL;

-- 65. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe15_p.internal;
<<NULL;

-- 66. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe15_p.secret;
<<NULL;

-- 67. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe15_p.top;
<<NULL;

-- 68. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbe15_p;
<<NULL;

-- 69. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbe15_t;

-- 70. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbe15_s;

-- 71. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbe15_a;

-- 72. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

