-- Policy 含两个映射同名规则的 SET 组件

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbe21_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbe21_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbe21_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe21_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe21_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe21_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe21_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe21_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbe21_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe21_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe21_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe21_t;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe21extra;
<<NULL;

-- 17. 创建本用例隔离的测试数据库
CREATE DATABASE lbe21_db;

-- 18. 切换当前数据库或元数据查询范围
USE lbe21_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe21_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe21_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe21_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe21_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe21_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe21_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe21_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe21_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe21_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbe21_p COMPONENTS lbe21_a,lbe21_s,lbe21_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe21_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbe21_p';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe21_p.top COMPONENT lbe21_a 'TOP', COMPONENT lbe21_s 'RD', COMPONENT lbe21_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe21_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe21_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe21_p.secret COMPONENT lbe21_a 'SECRET', COMPONENT lbe21_s 'RD', COMPONENT lbe21_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe21_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe21_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe21_p.internal COMPONENT lbe21_a 'INTERNAL', COMPONENT lbe21_s 'RD', COMPONENT lbe21_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe21_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe21_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe21_p.public COMPONENT lbe21_a 'PUBLIC', COMPONENT lbe21_s 'RD', COMPONENT lbe21_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe21_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe21_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe21_p.wide COMPONENT lbe21_a 'SECRET', COMPONENT lbe21_s 'RD','QA', COMPONENT lbe21_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe21_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe21_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbe21_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbe21_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbe21_db TO USER lbe21_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbe21_db TO USER lbe21_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbe21_db TO USER lbe21_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbe21_db TO USER lbe21_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbe21_db TO USER lbe21_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbe21_db TO USER lbe21_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbe21_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbe21_p.secret TO USER lbe21_u FOR ALL ACCESS;

-- 48. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe21extra SET ('A');

-- 49. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe21extra' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe21extra';

-- 50. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics DROP SECURITY POLICY;

-- 51. 修改 LBAC 安全策略并验证策略行为
ALTER SECURITY POLICY lbe21_p ADD SECURITY LABEL COMPONENT lbe21extra;

-- 52. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE LBACREADSET FOR lbe21_p TO USER lbe21_u;

-- 53. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=2 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policy_exemptions WHERE policy_name='lbe21_p' AND grantee='lbe21_u' AND rule_name='LBACREADSET';

-- 54. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbe21_db;
<<NULL;

-- 55. 清理本用例创建的数据表
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 56. 切换当前数据库或元数据查询范围
USE information_schema;

-- 57. 删除本用例隔离的测试数据库
DROP DATABASE lbe21_db;
<<NULL;

-- 58. 删除用例创建的普通用户
DROP USER lbe21_u;
<<NULL;

-- 59. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbe21_p FROM USER root;
<<NULL;

-- 60. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe21_p.wide;
<<NULL;

-- 61. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe21_p.public;
<<NULL;

-- 62. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe21_p.internal;
<<NULL;

-- 63. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe21_p.secret;
<<NULL;

-- 64. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbe21_p.top;
<<NULL;

-- 65. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbe21_p;
<<NULL;

-- 66. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbe21extra;
<<NULL;

-- 67. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbe21_t;

-- 68. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbe21_s;

-- 69. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbe21_a;

-- 70. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 71. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 72. 结束清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 73. 结束清理：删除本用例对象
DROP DATABASE lbe21_db;
<<NULL;

-- 74. 结束清理：删除本用例对象
DROP USER lbe21_u;
<<NULL;

-- 75. 结束清理：删除本用例对象
REVOKE EXEMPTION ON RULE ALL FOR lbe21_p FROM USER root;
<<NULL;

-- 76. 结束清理：删除本用例对象
DROP SECURITY LABEL lbe21_p.top;
<<NULL;

-- 77. 结束清理：删除本用例对象
DROP SECURITY LABEL lbe21_p.secret;
<<NULL;

-- 78. 结束清理：删除本用例对象
DROP SECURITY LABEL lbe21_p.internal;
<<NULL;

-- 79. 结束清理：删除本用例对象
DROP SECURITY LABEL lbe21_p.public;
<<NULL;

-- 80. 结束清理：删除本用例对象
DROP SECURITY LABEL lbe21_p.wide;
<<NULL;

-- 81. 结束清理：删除本用例对象
DROP SECURITY POLICY lbe21_p;
