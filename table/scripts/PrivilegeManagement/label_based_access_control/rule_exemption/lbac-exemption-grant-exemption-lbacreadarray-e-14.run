-- 仅在 p_array 授予 READARRAY 免除

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbe14_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbe14_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbe14_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbe14_p2 FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe14_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe14_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe14_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe14_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe14_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbe14_p2.other;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbe14_p;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbe14_p2;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe14_a;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe14_s;
<<NULL;

-- 18. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbe14_t;
<<NULL;

-- 19. 操作步骤: 分别访问 p_array、p_mix 中原本因 ARRAY 失败的对象。；预期结果: p_array 可跳过 ARRAY 读规则，p_mix 仍执行；同名 rule_name 不跨 Policy 生效。；创建本用例隔离的测试数据库
CREATE DATABASE lbe14_db;

-- 20. 切换当前数据库或元数据查询范围
USE lbe14_db;

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe14_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe14_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe14_a';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe14_s SET ('RD','QA','OPS');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe14_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe14_s';

-- 25. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbe14_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbe14_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbe14_t';

-- 27. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbe14_p COMPONENTS lbe14_a,lbe14_s,lbe14_t WITH LBACRULES;

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe14_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbe14_p';

-- 29. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbe14_p TO USER root;

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe14_p.top COMPONENT lbe14_a 'TOP', COMPONENT lbe14_s 'RD', COMPONENT lbe14_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe14_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe14_p' AND label_name='top';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe14_p.secret COMPONENT lbe14_a 'SECRET', COMPONENT lbe14_s 'RD', COMPONENT lbe14_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe14_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe14_p' AND label_name='secret';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe14_p.internal COMPONENT lbe14_a 'INTERNAL', COMPONENT lbe14_s 'RD', COMPONENT lbe14_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe14_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe14_p' AND label_name='internal';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe14_p.public COMPONENT lbe14_a 'PUBLIC', COMPONENT lbe14_s 'RD', COMPONENT lbe14_t 'A1';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe14_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe14_p' AND label_name='public';

-- 38. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe14_p.wide COMPONENT lbe14_a 'SECRET', COMPONENT lbe14_s 'RD','QA', COMPONENT lbe14_t 'ROOT';

-- 39. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe14_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe14_p' AND label_name='wide';

-- 40. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbe14_p TO USER root;

-- 41. 创建用例使用的普通用户
CREATE USER lbe14_u 'LbacTest_2026!';

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbe14_db TO USER lbe14_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbe14_db TO USER lbe14_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbe14_db TO USER lbe14_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbe14_db TO USER lbe14_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbe14_db TO USER lbe14_u;

-- 47. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbe14_db TO USER lbe14_u;

-- 48. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbe14_p;

-- 49. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 50. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbe14_p2 COMPONENTS lbe14_a WITH LBACRULES;

-- 51. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe14_p2' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbe14_p2';

-- 52. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbe14_p2 TO USER root;

-- 53. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbe14_p2.other COMPONENT lbe14_a 'SECRET';

-- 54. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbe14_p2' AND MIN(label_name)='other' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbe14_p2' AND label_name='other';

-- 55. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbe14_p2.other TO USER lbe14_u FOR ALL ACCESS;

-- 56. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE LBACREADARRAY FOR lbe14_p2 TO USER lbe14_u;

-- 57. 创建用于验证 LBAC 保护的数据表
CREATE TABLE other(v INT32 FIELD SECURED WITH other) SECURITY POLICY lbe14_p2;

-- 58. 使用当前测试账号建立数据库连接
connect lbe14_u/LbacTest_2026!;

-- 59. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 60. 切换当前数据库或元数据查询范围
USE lbe14_db;

-- 61. 读取受保护数据并验证 LBAC 读权限
SELECT v FROM other;

-- 62. 切换当前数据库或元数据查询范围
USE lbe14_db;

-- 63. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT high FROM metrics ORDER BY time;
<<SQLSTATE;

-- 64. 写入测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
