-- 存在管理员、本人、无关用户及角色授权

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbg17_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbg17_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP USER lbg17_v;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbg17_p FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg17_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg17_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg17_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg17_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg17_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbg17_p;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbg17_a;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbg17_s;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbg17_t;
<<NULL;

-- 17. 创建本用例隔离的测试数据库
CREATE DATABASE lbg17_db;

-- 18. 切换当前数据库或元数据查询范围
USE lbg17_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbg17_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbg17_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbg17_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbg17_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbg17_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbg17_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbg17_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbg17_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbg17_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbg17_p COMPONENTS lbg17_a,lbg17_s,lbg17_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg17_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbg17_p';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg17_p.top COMPONENT lbg17_a 'TOP', COMPONENT lbg17_s 'RD', COMPONENT lbg17_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg17_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg17_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg17_p.secret COMPONENT lbg17_a 'SECRET', COMPONENT lbg17_s 'RD', COMPONENT lbg17_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg17_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg17_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg17_p.internal COMPONENT lbg17_a 'INTERNAL', COMPONENT lbg17_s 'RD', COMPONENT lbg17_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg17_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg17_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg17_p.public COMPONENT lbg17_a 'PUBLIC', COMPONENT lbg17_s 'RD', COMPONENT lbg17_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg17_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg17_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg17_p.wide COMPONENT lbg17_a 'SECRET', COMPONENT lbg17_s 'RD','QA', COMPONENT lbg17_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg17_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg17_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbg17_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbg17_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbg17_db TO USER lbg17_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbg17_db TO USER lbg17_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbg17_db TO USER lbg17_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbg17_db TO USER lbg17_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbg17_db TO USER lbg17_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbg17_db TO USER lbg17_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbg17_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbg17_p.secret TO USER lbg17_u FOR ALL ACCESS;

-- 48. 创建用例使用的普通用户
CREATE USER lbg17_v 'LbacTest_2026!';

-- 49. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbg17_db TO USER lbg17_v;

-- 50. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbg17_db TO USER lbg17_v;

-- 51. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbg17_db TO USER lbg17_v;

-- 52. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbg17_db TO USER lbg17_v;

-- 53. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbg17_db TO USER lbg17_v;

-- 54. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbg17_db TO USER lbg17_v;

-- 55. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbg17_p.public TO USER lbg17_v FOR ALL ACCESS;

-- 56. 使用当前测试账号建立数据库连接
connect lbg17_u/LbacTest_2026!;

-- 57. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 58. 切换当前数据库或元数据查询范围
USE lbg17_db;

-- 59. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_access WHERE policy_name='lbg17_p' AND grantee='lbg17_v';

-- 60. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbg17_db;
<<NULL;

-- 61. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 62. 清理本用例创建的数据表
USE lbg17_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 63. 切换当前数据库或元数据查询范围
USE information_schema;

-- 64. 删除本用例隔离的测试数据库
DROP DATABASE lbg17_db;
<<NULL;

-- 65. 删除用例创建的普通用户
DROP USER lbg17_u;
<<NULL;

-- 66. 删除用例创建的普通用户
DROP USER lbg17_v;
<<NULL;

-- 67. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbg17_p FROM USER root;
<<NULL;

-- 68. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg17_p.wide;
<<NULL;

-- 69. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg17_p.public;
<<NULL;

-- 70. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg17_p.internal;
<<NULL;

-- 71. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg17_p.secret;
<<NULL;

-- 72. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg17_p.top;
<<NULL;

-- 73. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbg17_p;
<<NULL;

-- 74. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbg17_t;

-- 75. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbg17_s;

-- 76. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbg17_a;

-- 77. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

