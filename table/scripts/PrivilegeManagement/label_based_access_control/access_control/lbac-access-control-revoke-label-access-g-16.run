-- 已有种子数据与普通 RBAC 权限

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbg16_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbg16_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbg16_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg16_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg16_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg16_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg16_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg16_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbg16_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbg16_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbg16_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbg16_t;
<<NULL;

-- 16. 创建本用例隔离的测试数据库
CREATE DATABASE lbg16_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbg16_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbg16_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbg16_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbg16_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbg16_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbg16_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbg16_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbg16_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbg16_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbg16_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbg16_p COMPONENTS lbg16_a,lbg16_s,lbg16_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg16_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbg16_p';

-- 26. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg16_p.top COMPONENT lbg16_a 'TOP', COMPONENT lbg16_s 'RD', COMPONENT lbg16_t 'A1';

-- 27. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg16_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg16_p' AND label_name='top';

-- 28. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg16_p.secret COMPONENT lbg16_a 'SECRET', COMPONENT lbg16_s 'RD', COMPONENT lbg16_t 'A1';

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg16_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg16_p' AND label_name='secret';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg16_p.internal COMPONENT lbg16_a 'INTERNAL', COMPONENT lbg16_s 'RD', COMPONENT lbg16_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg16_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg16_p' AND label_name='internal';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg16_p.public COMPONENT lbg16_a 'PUBLIC', COMPONENT lbg16_s 'RD', COMPONENT lbg16_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg16_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg16_p' AND label_name='public';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg16_p.wide COMPONENT lbg16_a 'SECRET', COMPONENT lbg16_s 'RD','QA', COMPONENT lbg16_t 'ROOT';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg16_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg16_p' AND label_name='wide';

-- 36. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbg16_p TO USER root;

-- 37. 创建用例使用的普通用户
CREATE USER lbg16_u 'LbacTest_2026!';

-- 38. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbg16_db TO USER lbg16_u;

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbg16_db TO USER lbg16_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbg16_db TO USER lbg16_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbg16_db TO USER lbg16_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbg16_db TO USER lbg16_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbg16_db TO USER lbg16_u;

-- 44. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbg16_p;

-- 45. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 46. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbg16_p.secret TO USER lbg16_u FOR READ ACCESS;

-- 47. 使用当前测试账号建立数据库连接
connect lbg16_u/LbacTest_2026!;

-- 48. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 49. 切换当前数据库或元数据查询范围
USE lbg16_db;

-- 50. 读取受保护数据并验证 LBAC 读权限
SELECT high FROM metrics ORDER BY time;

-- 51. 切换当前数据库或元数据查询范围
USE lbg16_db;

-- 52. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbg16_db;
REVOKE SECURITY LABEL lbg16_p.secret FROM USER lbg16_u;
-- 切回测试账号继续用例
connect lbg16_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbg16_db;

-- 53. 切换当前数据库或元数据查询范围
USE lbg16_db;

-- 54. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT high FROM metrics ORDER BY time;
<<SQLSTATE;

-- 55. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbg16_db;
<<NULL;

-- 56. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 57. 清理本用例创建的数据表
USE lbg16_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 58. 切换当前数据库或元数据查询范围
USE information_schema;

-- 59. 删除本用例隔离的测试数据库
DROP DATABASE lbg16_db;
<<NULL;

-- 60. 删除用例创建的普通用户
DROP USER lbg16_u;
<<NULL;

-- 61. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbg16_p FROM USER root;
<<NULL;

-- 62. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg16_p.wide;
<<NULL;

-- 63. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg16_p.public;
<<NULL;

-- 64. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg16_p.internal;
<<NULL;

-- 65. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg16_p.secret;
<<NULL;

-- 66. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbg16_p.top;
<<NULL;

-- 67. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbg16_p;
<<NULL;

-- 68. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbg16_t;

-- 69. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbg16_s;

-- 70. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbg16_a;

-- 71. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

