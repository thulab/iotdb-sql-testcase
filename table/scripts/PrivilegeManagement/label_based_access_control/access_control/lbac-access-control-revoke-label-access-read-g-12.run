<<NULL;

-- 69. 结束清理：删除本用例对象
DROP SECURITY LABEL lbg12_p.top;
<<NULL;

-- 70. 结束清理：删除本用例对象
DROP SECURITY LABEL lbg12_p.secret;
<<NULL;

-- 71. 结束清理：删除本用例对象
DROP SECURITY LABEL lbg12_p.internal;
<<NULL;

