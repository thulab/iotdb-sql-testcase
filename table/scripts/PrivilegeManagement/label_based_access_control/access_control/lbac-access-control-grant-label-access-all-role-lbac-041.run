-- 授予角色 ALL Label

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbac041_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbac041_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP ROLE lblbac041_r;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbac041_p FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac041_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac041_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac041_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac041_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac041_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbac041_p;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac041_a;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac041_s;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac041_t;
<<NULL;

-- 17. 创建本用例隔离的测试数据库
CREATE DATABASE lblbac041_db;

-- 18. 切换当前数据库或元数据查询范围
USE lblbac041_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac041_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac041_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac041_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac041_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac041_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac041_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac041_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac041_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac041_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbac041_p COMPONENTS lblbac041_a,lblbac041_s,lblbac041_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac041_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbac041_p';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac041_p.top COMPONENT lblbac041_a 'TOP', COMPONENT lblbac041_s 'RD', COMPONENT lblbac041_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac041_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac041_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac041_p.secret COMPONENT lblbac041_a 'SECRET', COMPONENT lblbac041_s 'RD', COMPONENT lblbac041_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac041_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac041_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac041_p.internal COMPONENT lblbac041_a 'INTERNAL', COMPONENT lblbac041_s 'RD', COMPONENT lblbac041_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac041_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac041_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac041_p.public COMPONENT lblbac041_a 'PUBLIC', COMPONENT lblbac041_s 'RD', COMPONENT lblbac041_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac041_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac041_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac041_p.wide COMPONENT lblbac041_a 'SECRET', COMPONENT lblbac041_s 'RD','QA', COMPONENT lblbac041_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac041_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac041_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbac041_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lblbac041_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbac041_db TO USER lblbac041_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbac041_db TO USER lblbac041_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbac041_db TO USER lblbac041_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbac041_db TO USER lblbac041_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbac041_db TO USER lblbac041_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbac041_db TO USER lblbac041_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbac041_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 创建用例使用的角色
CREATE ROLE lblbac041_r;

-- 48. 授予或撤销用户的角色
GRANT ROLE lblbac041_r TO lblbac041_u;

-- 49. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbac041_p.secret TO ROLE lblbac041_r FOR ALL ACCESS;

-- 50. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lblbac041_db;
<<NULL;

-- 51. 清理本用例创建的数据表
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 52. 切换当前数据库或元数据查询范围
USE information_schema;

-- 53. 删除本用例隔离的测试数据库
DROP DATABASE lblbac041_db;
<<NULL;

-- 54. 删除用例创建的普通用户
DROP USER lblbac041_u;
<<NULL;

-- 55. 删除用例创建的角色
DROP ROLE lblbac041_r;
<<NULL;

-- 56. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lblbac041_p FROM USER root;
<<NULL;

-- 57. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac041_p.wide;
<<NULL;

