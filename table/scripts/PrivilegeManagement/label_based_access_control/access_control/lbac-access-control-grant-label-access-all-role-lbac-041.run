DROP SECURITY LABEL lblbac041_p.public;
<<NULL;

-- 59. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac041_p.internal;
<<NULL;

-- 60. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac041_p.secret;
<<NULL;

-- 61. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac041_p.top;
<<NULL;

-- 62. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lblbac041_p;
<<NULL;

-- 63. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac041_t;

-- 64. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac041_s;

-- 65. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac041_a;

