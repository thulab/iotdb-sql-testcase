-- 两个 Policy 可有同名标签

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbg18_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbg18_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbg18_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbg18_p2 FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg18_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg18_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg18_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg18_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg18_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbg18_p2.secret;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbg18_p;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbg18_p2;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbg18_a;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbg18_s;
<<NULL;

-- 18. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbg18_t;
<<NULL;

-- 19. 创建本用例隔离的测试数据库
CREATE DATABASE lbg18_db;

-- 20. 切换当前数据库或元数据查询范围
USE lbg18_db;

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbg18_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbg18_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbg18_a';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbg18_s SET ('RD','QA','OPS');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbg18_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbg18_s';

-- 25. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbg18_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbg18_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbg18_t';

-- 27. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbg18_p COMPONENTS lbg18_a,lbg18_s,lbg18_t WITH LBACRULES;

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg18_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbg18_p';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg18_p.top COMPONENT lbg18_a 'TOP', COMPONENT lbg18_s 'RD', COMPONENT lbg18_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg18_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg18_p' AND label_name='top';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg18_p.secret COMPONENT lbg18_a 'SECRET', COMPONENT lbg18_s 'RD', COMPONENT lbg18_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg18_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg18_p' AND label_name='secret';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg18_p.internal COMPONENT lbg18_a 'INTERNAL', COMPONENT lbg18_s 'RD', COMPONENT lbg18_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg18_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg18_p' AND label_name='internal';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg18_p.public COMPONENT lbg18_a 'PUBLIC', COMPONENT lbg18_s 'RD', COMPONENT lbg18_t 'A1';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg18_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg18_p' AND label_name='public';

-- 37. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg18_p.wide COMPONENT lbg18_a 'SECRET', COMPONENT lbg18_s 'RD','QA', COMPONENT lbg18_t 'ROOT';

-- 38. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg18_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg18_p' AND label_name='wide';

-- 39. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbg18_p TO USER root;

-- 40. 创建用例使用的普通用户
CREATE USER lbg18_u 'LbacTest_2026!';

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbg18_db TO USER lbg18_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbg18_db TO USER lbg18_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbg18_db TO USER lbg18_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbg18_db TO USER lbg18_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbg18_db TO USER lbg18_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbg18_db TO USER lbg18_u;

-- 47. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbg18_p;

-- 48. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 49. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbg18_p2 COMPONENTS lbg18_a,lbg18_s,lbg18_t WITH LBACRULES;

-- 50. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg18_p2' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbg18_p2';

-- 51. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbg18_p2.secret COMPONENT lbg18_a 'SECRET';

-- 52. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbg18_p2' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbg18_p2' AND label_name='secret';

-- 53. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbg18_p2.secret TO USER lbg18_u FOR READ ACCESS;

-- 54. 使用当前测试账号建立数据库连接
connect lbg18_u/LbacTest_2026!;

-- 55. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 56. 切换当前数据库或元数据查询范围
USE lbg18_db;

-- 57. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT high FROM metrics ORDER BY time;
<<SQLSTATE;

-- 58. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbg18_db;
<<NULL;

-- 59. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 60. 清理本用例创建的数据表
USE lbg18_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 61. 切换当前数据库或元数据查询范围
USE information_schema;

-- 62. 删除本用例隔离的测试数据库
DROP DATABASE lbg18_db;
<<NULL;

-- 63. 删除用例创建的普通用户
DROP USER lbg18_u;
<<NULL;

-- 64. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbg18_p FROM USER root;
<<NULL;

-- 65. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbg18_p2 FROM USER root;
