REVOKE EXEMPTION ON RULE ALL FOR lbg14_p FROM USER root;
<<NULL;

-- 70. 结束清理：删除本用例对象
DROP SECURITY LABEL lbg14_p.top;
<<NULL;

-- 71. 结束清理：删除本用例对象
DROP SECURITY LABEL lbg14_p.secret;
<<NULL;

-- 72. 结束清理：删除本用例对象
DROP SECURITY LABEL lbg14_p.internal;
<<NULL;

-- 73. 结束清理：删除本用例对象
DROP SECURITY LABEL lbg14_p.public;
