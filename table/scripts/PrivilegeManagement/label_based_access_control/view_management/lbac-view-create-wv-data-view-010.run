-- 通过可写视图 DELETE FROM

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataview010_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataview010_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataview010_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview010_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview010_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview010_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview010_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview010_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview010_p.both;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataview010_p;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataview010_a;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataview010_s;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataview010_t;
<<NULL;

-- 17. 操作步骤: 通过映射同一源表的可写视图，分别按未保护 TAG 和受保护谓词删除，组合全保护列 WRITE 与谓词 READ。；预期结果: 权限矩阵与直接删除源表一致；缺任一源列 WRITE 或谓词 READ 时源表零变化。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataview010_db;

-- 18. 切换当前数据库或元数据查询范围
USE lbdataview010_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataview010_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataview010_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataview010_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataview010_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataview010_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataview010_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataview010_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataview010_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataview010_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataview010_p COMPONENTS lbdataview010_a,lbdataview010_s,lbdataview010_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview010_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataview010_p';

-- 27. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataview010_p TO USER root;

-- 28. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview010_p.top COMPONENT lbdataview010_a 'TOP', COMPONENT lbdataview010_s 'RD', COMPONENT lbdataview010_t 'A1';

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview010_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview010_p' AND label_name='top';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview010_p.secret COMPONENT lbdataview010_a 'SECRET', COMPONENT lbdataview010_s 'RD', COMPONENT lbdataview010_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview010_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview010_p' AND label_name='secret';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview010_p.internal COMPONENT lbdataview010_a 'INTERNAL', COMPONENT lbdataview010_s 'RD', COMPONENT lbdataview010_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview010_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview010_p' AND label_name='internal';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview010_p.public COMPONENT lbdataview010_a 'PUBLIC', COMPONENT lbdataview010_s 'RD', COMPONENT lbdataview010_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview010_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview010_p' AND label_name='public';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview010_p.wide COMPONENT lbdataview010_a 'SECRET', COMPONENT lbdataview010_s 'RD','QA', COMPONENT lbdataview010_t 'ROOT';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview010_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview010_p' AND label_name='wide';

-- 38. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataview010_p TO USER root;

-- 39. 创建用例使用的普通用户
CREATE USER lbdataview010_u 'LbacTest_2026!';

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataview010_db TO USER lbdataview010_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataview010_db TO USER lbdataview010_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataview010_db TO USER lbdataview010_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataview010_db TO USER lbdataview010_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataview010_db TO USER lbdataview010_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataview010_db TO USER lbdataview010_u;

-- 46. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataview010_p;

-- 47. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 48. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN device SECURED WITH internal;

-- 49. 执行 CREATE 操作并验证用例行为
CREATE WRITABLE VIEW wv AS SELECT device AS tag_alias,low AS public_alias,owner,plain,high FROM metrics WITH (schema_cascade=false);

-- 50. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataview010_p.internal TO USER lbdataview010_u FOR WRITE ACCESS;

-- 51. 使用当前测试账号建立数据库连接
connect lbdataview010_u/LbacTest_2026!;

-- 52. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 53. 切换当前数据库或元数据查询范围
USE lbdataview010_db;

-- 54. 删除测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
DELETE FROM wv WHERE tag_alias='d1';
<<SQLSTATE;

-- 55. 删除测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
DELETE DEVICES FROM wv WHERE tag_alias='d1';
<<SQLSTATE;

-- 56. 切换当前数据库或元数据查询范围
USE lbdataview010_db;

-- 57. 切换当前数据库或元数据查询范围
USE lbdataview010_db;

-- 切回管理员账号执行数据完整性断言
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataview010_db;
-- 58. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(plain)=10 AND MIN(low)=20 AND MIN(high)=30 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;
-- 切回测试账号继续用例
connect lbdataview010_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataview010_db;

-- 59. 创建安全标签并验证标签值和组件映射
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataview010_db;
CREATE SECURITY LABEL lbdataview010_p.both COMPONENT lbdataview010_a 'SECRET', COMPONENT lbdataview010_s 'RD', COMPONENT lbdataview010_t 'A1';
-- 切回测试账号继续用例
connect lbdataview010_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataview010_db;

-- 60. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview010_p' AND MIN(label_name)='both' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview010_p' AND label_name='both';

-- 61. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataview010_db;
REVOKE SECURITY LABEL lbdataview010_p.internal FROM USER lbdataview010_u;

-- 62. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataview010_p.both TO USER lbdataview010_u FOR WRITE ACCESS;

-- 63. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE LBACWRITEARRAY WRITE_DOWN FOR lbdataview010_p TO USER lbdataview010_u;
-- 切回测试账号继续用例
connect lbdataview010_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataview010_db;

-- 64. 切换当前数据库或元数据查询范围
USE lbdataview010_db;

-- 65. 删除测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
DELETE FROM wv WHERE tag_alias='d1';
<<SQLSTATE;

-- 66. 切换当前数据库或元数据查询范围
USE lbdataview010_db;

-- 67. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataview010_db;
REVOKE SECURITY LABEL lbdataview010_p.both FROM USER lbdataview010_u;

-- 68. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataview010_p.both TO USER lbdataview010_u FOR WRITE ACCESS;

-- 69. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbdataview010_p.internal TO USER lbdataview010_u FOR READ ACCESS;
-- 切回测试账号继续用例
connect lbdataview010_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataview010_db;

-- 70. 切换当前数据库或元数据查询范围
USE lbdataview010_db;

-- 71. 删除测试数据并验证 LBAC 写入控制
DELETE FROM wv WHERE tag_alias='d1';

-- 72. 切换当前数据库或元数据查询范围
USE lbdataview010_db;

-- 73. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;

-- 74. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
