connect root/TimechoDB@2021;

-- 58. 清理本用例创建的数据表
USE lbdataview017_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 59. 切换当前数据库或元数据查询范围
USE information_schema;

-- 60. 删除本用例隔离的测试数据库
DROP DATABASE lbdataview017_db;
<<NULL;

