-- 60. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac106_p.secret;
<<NULL;

-- 61. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac106_p.top;
<<NULL;

-- 62. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lblbac106_p;
<<NULL;

-- 63. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac106_t;

-- 64. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac106_s;

-- 65. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac106_a;

