-- 无 LBAC 凭证创建可写视图

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataview001_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataview001_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataview001_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview001_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview001_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview001_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview001_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview001_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataview001_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataview001_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataview001_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataview001_t;
<<NULL;

-- 16. 操作步骤: 无源列 READ、WRITE、但具备创建视图普通权限的用户，按真实语法创建可写视图并仅查看其元数据。；预期结果: 创建成功，不在创建时检查源列 LBAC；源表权限前提仍遵循现有视图 RBAC 规则。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataview001_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbdataview001_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataview001_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataview001_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataview001_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataview001_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataview001_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataview001_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataview001_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataview001_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataview001_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataview001_p COMPONENTS lbdataview001_a,lbdataview001_s,lbdataview001_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview001_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataview001_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataview001_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview001_p.top COMPONENT lbdataview001_a 'TOP', COMPONENT lbdataview001_s 'RD', COMPONENT lbdataview001_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview001_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview001_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview001_p.secret COMPONENT lbdataview001_a 'SECRET', COMPONENT lbdataview001_s 'RD', COMPONENT lbdataview001_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview001_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview001_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview001_p.internal COMPONENT lbdataview001_a 'INTERNAL', COMPONENT lbdataview001_s 'RD', COMPONENT lbdataview001_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview001_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview001_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview001_p.public COMPONENT lbdataview001_a 'PUBLIC', COMPONENT lbdataview001_s 'RD', COMPONENT lbdataview001_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview001_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview001_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview001_p.wide COMPONENT lbdataview001_a 'SECRET', COMPONENT lbdataview001_s 'RD','QA', COMPONENT lbdataview001_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview001_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview001_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataview001_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbdataview001_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataview001_db TO USER lbdataview001_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataview001_db TO USER lbdataview001_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataview001_db TO USER lbdataview001_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataview001_db TO USER lbdataview001_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataview001_db TO USER lbdataview001_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataview001_db TO USER lbdataview001_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataview001_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 使用当前测试账号建立数据库连接
connect lbdataview001_u/LbacTest_2026!;

-- 48. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 49. 切换当前数据库或元数据查询范围
USE lbdataview001_db;

-- 50. 执行 CREATE 操作并验证用例行为
CREATE WRITABLE VIEW wv AS SELECT device,plain,high AS protected_alias FROM metrics WITH (schema_cascade=false);

-- 51. 执行 CREATE 操作并验证用例行为
CREATE VIEW lv AS SELECT device,plain,high AS protected_alias FROM metrics;

-- 52. 切换当前数据库或元数据查询范围
USE lbdataview001_db;

-- 53. 切换当前数据库或元数据查询范围
USE lbdataview001_db;

-- 54. 执行 DESCRIBE 操作并验证用例行为
DESCRIBE wv;

-- 55. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT * FROM wv;
<<SQLSTATE;

-- 56. 切换当前数据库或元数据查询范围
USE lbdataview001_db;

-- 57. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataview001_db;
GRANT SECURITY LABEL lbdataview001_p.secret TO USER lbdataview001_u FOR READ ACCESS;
-- 切回测试账号继续用例
connect lbdataview001_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataview001_db;

-- 58. 切换当前数据库或元数据查询范围
USE lbdataview001_db;

-- 59. 读取受保护数据并验证 LBAC 读权限
SELECT * FROM wv;

-- 60. 切换当前数据库或元数据查询范围
USE lbdataview001_db;

-- 61. 执行 DROP 操作并验证用例行为
DROP VIEW lv;

-- 62. 执行 DROP 操作并验证用例行为
DROP VIEW wv;

