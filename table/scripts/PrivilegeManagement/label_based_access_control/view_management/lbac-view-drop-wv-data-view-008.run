SET SQL_DIALECT=TABLE;
USE lbdataview008_db;
-- 61. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(high)=99 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics WHERE time=2;
-- 切回测试账号继续用例
connect lbdataview008_u/LbacTest_2026!;
