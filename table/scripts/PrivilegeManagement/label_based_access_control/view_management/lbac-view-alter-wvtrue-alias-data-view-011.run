-- 可写视图 DROP COLUMN 的级联分支

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataview011_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataview011_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataview011_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview011_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview011_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview011_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview011_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataview011_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataview011_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataview011_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataview011_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataview011_t;
<<NULL;

-- 16. 操作步骤: 对分别启用和禁用 schema_cascade、均映射受保护源列的可写视图，由有无源 Label WRITE 的主体删除映射列。；预期结果: 级联时缺 WRITE 拒绝，齐全则源列和映射同删；非级联仅删视图映射并保留源列保护；失败均原子不变。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataview011_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbdataview011_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataview011_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataview011_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataview011_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataview011_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataview011_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataview011_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataview011_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataview011_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataview011_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataview011_p COMPONENTS lbdataview011_a,lbdataview011_s,lbdataview011_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview011_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataview011_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataview011_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview011_p.top COMPONENT lbdataview011_a 'TOP', COMPONENT lbdataview011_s 'RD', COMPONENT lbdataview011_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview011_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview011_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview011_p.secret COMPONENT lbdataview011_a 'SECRET', COMPONENT lbdataview011_s 'RD', COMPONENT lbdataview011_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview011_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview011_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview011_p.internal COMPONENT lbdataview011_a 'INTERNAL', COMPONENT lbdataview011_s 'RD', COMPONENT lbdataview011_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview011_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview011_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview011_p.public COMPONENT lbdataview011_a 'PUBLIC', COMPONENT lbdataview011_s 'RD', COMPONENT lbdataview011_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview011_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview011_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataview011_p.wide COMPONENT lbdataview011_a 'SECRET', COMPONENT lbdataview011_s 'RD','QA', COMPONENT lbdataview011_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataview011_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataview011_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataview011_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbdataview011_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataview011_db TO USER lbdataview011_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataview011_db TO USER lbdataview011_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataview011_db TO USER lbdataview011_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataview011_db TO USER lbdataview011_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataview011_db TO USER lbdataview011_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataview011_db TO USER lbdataview011_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataview011_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 执行 CREATE 操作并验证用例行为
CREATE WRITABLE VIEW wvfalse AS SELECT device,high AS alias FROM metrics WITH (schema_cascade=false);

-- 48. 使用当前测试账号建立数据库连接
connect lbdataview011_u/LbacTest_2026!;

-- 49. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 50. 切换当前数据库或元数据查询范围
USE lbdataview011_db;

-- 51. 执行 ALTER 操作并验证用例行为
ALTER VIEW wvfalse DROP COLUMN alias;

-- 52. 切换当前数据库或元数据查询范围
USE lbdataview011_db;

-- 53. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbdataview011_db' AND table_name='metrics' AND column_name='high' AND security_label='secret';

-- 54. 执行 CREATE 操作并验证用例行为
CREATE WRITABLE VIEW wvtrue AS SELECT device,high AS alias FROM metrics WITH (schema_cascade=true);

-- 55. 切换当前数据库或元数据查询范围
USE lbdataview011_db;

-- 56. 执行 ALTER 操作并验证用例行为；本语句预期失败，需核对 SQLSTATE 及错误原因
ALTER VIEW wvtrue DROP COLUMN alias;
<<SQLSTATE;

-- 57. 切换当前数据库或元数据查询范围
USE lbdataview011_db;

-- 58. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbdataview011_db' AND table_name='metrics' AND column_name='high' AND security_label='secret';

-- 59. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataview011_db;
GRANT SECURITY LABEL lbdataview011_p.secret TO USER lbdataview011_u FOR WRITE ACCESS;

-- 60. 切换当前数据库或元数据查询范围
USE lbdataview011_db;

-- 61. 执行 ALTER 操作并验证用例行为
ALTER VIEW wvtrue DROP COLUMN alias;
-- 切回测试账号继续用例
connect lbdataview011_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataview011_db;

-- 62. 切换当前数据库或元数据查询范围
USE lbdataview011_db;

-- 63. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbdataview011_db' AND table_name='metrics' AND column_name='high';

-- 64. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lbdataview011_db;
<<NULL;

-- 65. 执行 DROP 操作并验证用例行为
DROP VIEW IF EXISTS wvtrue;

-- 66. 执行 DROP 操作并验证用例行为
DROP VIEW IF EXISTS wvfalse;

-- 67. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbdataview011_db;
<<NULL;

-- 68. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 69. 清理本用例创建的数据表
USE lbdataview011_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 70. 切换当前数据库或元数据查询范围
USE information_schema;

-- 71. 删除本用例隔离的测试数据库
DROP DATABASE lbdataview011_db;
<<NULL;

-- 72. 删除用例创建的普通用户
DROP USER lbdataview011_u;
<<NULL;

-- 73. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbdataview011_p FROM USER root;
<<NULL;

-- 74. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataview011_p.wide;
<<NULL;

-- 75. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataview011_p.public;
<<NULL;

-- 76. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataview011_p.internal;
<<NULL;

-- 77. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataview011_p.secret;
<<NULL;

-- 78. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataview011_p.top;
<<NULL;

-- 79. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbdataview011_p;
<<NULL;

-- 80. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdataview011_t;

-- 81. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdataview011_s;

-- 82. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdataview011_a;

-- 83. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

