-- 跨不同 Policy 表的 JOIN

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacx011_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacx011_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacx011_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacx011_p2 FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx011_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx011_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx011_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx011_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx011_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx011_p2.second;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacx011_p;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacx011_p2;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacx011_a;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacx011_s;
<<NULL;

-- 18. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacx011_t;
<<NULL;

-- 19. 操作步骤: JOIN 两张绑定不同 Policy 的表并同时引用两侧保护列，依次撤销任一侧 READ Label。；预期结果: 两侧按各自 Policy 独立选择 Label 并检查；缺任一侧 READ 时整条查询失败，不返回另一侧或已授权列的部分结果。；创建本用例隔离的测试数据库
CREATE DATABASE lblbacx011_db;

-- 20. 切换当前数据库或元数据查询范围
USE lblbacx011_db;

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacx011_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacx011_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacx011_a';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacx011_s SET ('RD','QA','OPS');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacx011_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacx011_s';

-- 25. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacx011_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacx011_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacx011_t';

-- 27. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacx011_p COMPONENTS lblbacx011_a,lblbacx011_s,lblbacx011_t WITH LBACRULES;

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx011_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacx011_p';

-- 29. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacx011_p TO USER root;

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx011_p.top COMPONENT lblbacx011_a 'TOP', COMPONENT lblbacx011_s 'RD', COMPONENT lblbacx011_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx011_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx011_p' AND label_name='top';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx011_p.secret COMPONENT lblbacx011_a 'SECRET', COMPONENT lblbacx011_s 'RD', COMPONENT lblbacx011_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx011_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx011_p' AND label_name='secret';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx011_p.internal COMPONENT lblbacx011_a 'INTERNAL', COMPONENT lblbacx011_s 'RD', COMPONENT lblbacx011_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx011_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx011_p' AND label_name='internal';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx011_p.public COMPONENT lblbacx011_a 'PUBLIC', COMPONENT lblbacx011_s 'RD', COMPONENT lblbacx011_t 'A1';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx011_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx011_p' AND label_name='public';

-- 38. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx011_p.wide COMPONENT lblbacx011_a 'SECRET', COMPONENT lblbacx011_s 'RD','QA', COMPONENT lblbacx011_t 'ROOT';

-- 39. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx011_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx011_p' AND label_name='wide';

-- 40. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacx011_p TO USER root;

-- 41. 创建用例使用的普通用户
CREATE USER lblbacx011_u 'LbacTest_2026!';

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacx011_db TO USER lblbacx011_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacx011_db TO USER lblbacx011_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacx011_db TO USER lblbacx011_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacx011_db TO USER lblbacx011_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacx011_db TO USER lblbacx011_u;

-- 47. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacx011_db TO USER lblbacx011_u;

-- 48. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG ,owner STRING ATTRIBUTE ,site STRING ATTRIBUTE,plain INT32 FIELD,low INT32 FIELD,high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacx011_p;

-- 49. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,site,plain,low,high) VALUES(1,'d1','alice','west',10,20,30);

-- 50. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacx011_p2 COMPONENTS lblbacx011_a WITH LBACRULES;

-- 51. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx011_p2' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacx011_p2';

-- 52. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacx011_p2 TO USER root;

-- 53. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx011_p2.second COMPONENT lblbacx011_a 'SECRET';

-- 54. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx011_p2' AND MIN(label_name)='second' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx011_p2' AND label_name='second';

-- 55. 创建用于验证 LBAC 保护的数据表
CREATE TABLE peer(device STRING TAG,v INT32 FIELD SECURED WITH second) SECURITY POLICY lblbacx011_p2;

-- 56. 写入测试数据并验证 LBAC 写入控制
INSERT INTO peer(time,device,v) VALUES(1,'d1',40);

-- 57. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacx011_p.secret TO USER lblbacx011_u FOR READ ACCESS;

-- 58. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacx011_p2.second TO USER lblbacx011_u FOR READ ACCESS;

-- 59. 使用当前测试账号建立数据库连接
connect lblbacx011_u/LbacTest_2026!;

-- 60. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 61. 切换当前数据库或元数据查询范围
USE lblbacx011_db;

-- 62. 读取受保护数据并验证 LBAC 读权限
SELECT m.high,p.v FROM metrics m JOIN peer p ON m.device=p.device;

-- 63. 切换当前数据库或元数据查询范围
USE lblbacx011_db;

-- 64. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lblbacx011_db;
REVOKE SECURITY LABEL lblbacx011_p.secret FROM USER lblbacx011_u;
-- 切回测试账号继续用例
connect lblbacx011_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbacx011_db;

-- 65. 切换当前数据库或元数据查询范围
USE lblbacx011_db;

-- 66. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
