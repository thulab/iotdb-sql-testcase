-- 备注与展示不改变访问判断

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacx024_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacx024_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacx024_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx024_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx024_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx024_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx024_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx024_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacx024_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacx024_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacx024_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacx024_t;
<<NULL;

-- 16. 操作步骤: 为 Component、Policy、Label 新增、替换、清空备注；执行 DESCRIBE/SHOW CREATE；比较前后授权访问矩阵。；预期结果: 备注和元数据展示不改变标签与权限；DESCRIBE/SHOW CREATE 不增加 LBAC 读检查；仍遵循普通权限。；创建本用例隔离的测试数据库
CREATE DATABASE lblbacx024_db;

-- 17. 切换当前数据库或元数据查询范围
USE lblbacx024_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacx024_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacx024_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacx024_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacx024_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacx024_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacx024_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacx024_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacx024_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacx024_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacx024_p COMPONENTS lblbacx024_a,lblbacx024_s,lblbacx024_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx024_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacx024_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacx024_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx024_p.top COMPONENT lblbacx024_a 'TOP', COMPONENT lblbacx024_s 'RD', COMPONENT lblbacx024_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx024_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx024_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx024_p.secret COMPONENT lblbacx024_a 'SECRET', COMPONENT lblbacx024_s 'RD', COMPONENT lblbacx024_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx024_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx024_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx024_p.internal COMPONENT lblbacx024_a 'INTERNAL', COMPONENT lblbacx024_s 'RD', COMPONENT lblbacx024_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx024_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx024_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx024_p.public COMPONENT lblbacx024_a 'PUBLIC', COMPONENT lblbacx024_s 'RD', COMPONENT lblbacx024_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx024_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx024_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx024_p.wide COMPONENT lblbacx024_a 'SECRET', COMPONENT lblbacx024_s 'RD','QA', COMPONENT lblbacx024_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx024_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx024_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacx024_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lblbacx024_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacx024_db TO USER lblbacx024_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacx024_db TO USER lblbacx024_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacx024_db TO USER lblbacx024_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacx024_db TO USER lblbacx024_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacx024_db TO USER lblbacx024_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacx024_db TO USER lblbacx024_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG ,owner STRING ATTRIBUTE ,site STRING ATTRIBUTE,plain INT32 FIELD,low INT32 FIELD,high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacx024_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,site,plain,low,high) VALUES(1,'d1','alice','west',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacx024_p.secret TO USER lblbacx024_u FOR READ ACCESS;

-- 48. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacx024_p.secret TO USER lblbacx024_u FOR WRITE ACCESS;

-- 49. 设置组件备注并验证元数据
COMMENT ON SECURITY LABEL COMPONENT lblbacx024_a IS '中文备注';

-- 50. 设置组件备注并验证元数据
COMMENT ON SECURITY LABEL COMPONENT lblbacx024_a IS 'it''s changed';

-- 51. 设置组件备注并验证元数据
COMMENT ON SECURITY LABEL COMPONENT lblbacx024_a IS NULL;

-- 52. 设置策略备注并验证元数据
COMMENT ON SECURITY POLICY lblbacx024_p IS '中文备注';

-- 53. 设置策略备注并验证元数据
COMMENT ON SECURITY POLICY lblbacx024_p IS 'it''s changed';

-- 54. 设置策略备注并验证元数据
COMMENT ON SECURITY POLICY lblbacx024_p IS NULL;

-- 55. 设置安全标签备注并验证元数据
COMMENT ON SECURITY LABEL lblbacx024_p.secret IS '中文备注';

-- 56. 设置安全标签备注并验证元数据
COMMENT ON SECURITY LABEL lblbacx024_p.secret IS 'it''s changed';

-- 57. 设置安全标签备注并验证元数据
COMMENT ON SECURITY LABEL lblbacx024_p.secret IS NULL;

-- 58. 使用当前测试账号建立数据库连接
connect lblbacx024_u/LbacTest_2026!;

-- 59. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 60. 切换当前数据库或元数据查询范围
USE lblbacx024_db;

-- 61. 执行 DESCRIBE 操作并验证用例行为
DESCRIBE metrics;

-- 62. 查询对象信息并验证 LBAC 可见性
SHOW CREATE TABLE metrics;

-- 63. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN MIN(high)=30 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;

-- 64. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,high) VALUES(2,'d1',99);

-- 65. 切换当前数据库或元数据查询范围
USE lblbacx024_db;

-- 66. 授予或撤销安全标签访问权限并验证授权行为
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lblbacx024_db;
REVOKE SECURITY LABEL lblbacx024_p.secret FROM USER lblbacx024_u;
-- 切回测试账号继续用例
connect lblbacx024_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbacx024_db;

-- 67. 切换当前数据库或元数据查询范围
USE lblbacx024_db;

-- 68. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT high FROM metrics ORDER BY time;
<<SQLSTATE;

-- 69. 写入测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
INSERT INTO metrics(time,device,high) VALUES(3,'d1',99);
<<SQLSTATE;

-- 70. 切换当前数据库或元数据查询范围
USE lblbacx024_db;

-- 71. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=2 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;

-- 72. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lblbacx024_db;
<<NULL;

-- 73. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lblbacx024_db;
<<NULL;

-- 74. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 75. 清理本用例创建的数据表
