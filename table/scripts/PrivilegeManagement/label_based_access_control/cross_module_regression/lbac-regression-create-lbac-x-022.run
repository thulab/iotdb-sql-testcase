-- SECURITY 管理权不隐含数据读权

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacx022_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacx022_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacx022_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx022_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx022_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx022_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx022_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacx022_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacx022_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacx022_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacx022_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacx022_t;
<<NULL;

-- 16. 操作步骤: 仅授予 sec_admin SECURITY 和必要元数据权限，不授表 SELECT 或 Label，尝试查询敏感业务列。；预期结果: 由 RBAC 或 LBAC 明确拒绝且不返回数据；管理安全元数据不等于获得业务表权限或 Label。；创建本用例隔离的测试数据库
CREATE DATABASE lblbacx022_db;

-- 17. 切换当前数据库或元数据查询范围
USE lblbacx022_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacx022_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacx022_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacx022_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacx022_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacx022_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacx022_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacx022_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacx022_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacx022_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacx022_p COMPONENTS lblbacx022_a,lblbacx022_s,lblbacx022_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx022_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacx022_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacx022_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx022_p.top COMPONENT lblbacx022_a 'TOP', COMPONENT lblbacx022_s 'RD', COMPONENT lblbacx022_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx022_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx022_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx022_p.secret COMPONENT lblbacx022_a 'SECRET', COMPONENT lblbacx022_s 'RD', COMPONENT lblbacx022_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx022_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx022_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx022_p.internal COMPONENT lblbacx022_a 'INTERNAL', COMPONENT lblbacx022_s 'RD', COMPONENT lblbacx022_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx022_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx022_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx022_p.public COMPONENT lblbacx022_a 'PUBLIC', COMPONENT lblbacx022_s 'RD', COMPONENT lblbacx022_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx022_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx022_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacx022_p.wide COMPONENT lblbacx022_a 'SECRET', COMPONENT lblbacx022_s 'RD','QA', COMPONENT lblbacx022_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacx022_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacx022_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacx022_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lblbacx022_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacx022_db TO USER lblbacx022_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacx022_db TO USER lblbacx022_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacx022_db TO USER lblbacx022_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacx022_db TO USER lblbacx022_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacx022_db TO USER lblbacx022_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacx022_db TO USER lblbacx022_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG ,owner STRING ATTRIBUTE ,site STRING ATTRIBUTE,plain INT32 FIELD,low INT32 FIELD,high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacx022_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,site,plain,low,high) VALUES(1,'d1','alice','west',10,20,30);

-- 47. 执行 REVOKE 操作并验证用例行为
REVOKE SELECT ON DATABASE lblbacx022_db FROM USER lblbacx022_u;

-- 48. 执行 REVOKE 操作并验证用例行为
REVOKE INSERT ON DATABASE lblbacx022_db FROM USER lblbacx022_u;

-- 49. 执行 GRANT 操作并验证用例行为
GRANT SECURITY TO USER lblbacx022_u;

-- 50. 使用当前测试账号建立数据库连接
connect lblbacx022_u/LbacTest_2026!;

-- 51. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 52. 切换当前数据库或元数据查询范围
USE lblbacx022_db;

-- 53. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT high FROM metrics ORDER BY time;
<<SQLSTATE;

-- 54. 写入测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
INSERT INTO metrics(time,device,high) VALUES(2,'d1',99);
<<SQLSTATE;

-- 55. 切换当前数据库或元数据查询范围
USE lblbacx022_db;

-- 切回管理员账号执行数据完整性断言
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lblbacx022_db;
-- 56. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;
-- 切回测试账号继续用例
connect lblbacx022_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbacx022_db;

-- 57. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lblbacx022_db;
<<NULL;

-- 58. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lblbacx022_db;
<<NULL;

-- 59. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 60. 清理本用例创建的数据表
USE lblbacx022_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 61. 切换当前数据库或元数据查询范围
USE information_schema;

-- 62. 删除本用例隔离的测试数据库
DROP DATABASE lblbacx022_db;
<<NULL;

-- 63. 删除用例创建的普通用户
DROP USER lblbacx022_u;
<<NULL;

-- 64. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lblbacx022_p FROM USER root;
<<NULL;

-- 65. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbacx022_p.wide;
<<NULL;

-- 66. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbacx022_p.public;
<<NULL;

-- 67. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbacx022_p.internal;
<<NULL;

-- 68. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbacx022_p.secret;
<<NULL;

-- 69. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbacx022_p.top;
<<NULL;

-- 70. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lblbacx022_p;
<<NULL;

-- 71. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbacx022_t;

-- 72. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbacx022_s;

-- 73. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbacx022_a;

-- 74. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 75. 结束清理：切换到表模型 SQL 方言
