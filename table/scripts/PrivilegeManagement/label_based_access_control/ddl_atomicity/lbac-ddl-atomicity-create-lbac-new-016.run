-- 58. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE LBACWRITEARRAY WRITE_DOWN FOR lblbacnew016_p TO USER lblbacnew016_u;
-- 切回测试账号继续用例
connect lblbacnew016_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
