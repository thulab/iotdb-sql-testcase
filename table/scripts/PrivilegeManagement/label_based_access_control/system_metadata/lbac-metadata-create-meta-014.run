-- 依赖对象 DROP 保护与原子性

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbmeta014_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbmeta014_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbmeta014_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta014_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta014_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta014_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta014_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta014_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbmeta014_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbmeta014_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbmeta014_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbmeta014_t;
<<NULL;

-- 16. 操作步骤: 尝试删除被 Policy 引用的 Component、被主体或列使用的 Label、被表使用的 Policy；再按依赖顺序解除后删除。；预期结果: 有依赖时明确拒绝，7 张安全表及 tables/columns和访问行为不变，错误不泄露无权主体或表详情；解除列绑定、授权和免除权后可逐级删除且无孤儿。；创建本用例隔离的测试数据库
CREATE DATABASE lbmeta014_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbmeta014_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbmeta014_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbmeta014_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbmeta014_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbmeta014_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbmeta014_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbmeta014_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbmeta014_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbmeta014_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbmeta014_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbmeta014_p COMPONENTS lbmeta014_a,lbmeta014_s,lbmeta014_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta014_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbmeta014_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbmeta014_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta014_p.top COMPONENT lbmeta014_a 'TOP', COMPONENT lbmeta014_s 'RD', COMPONENT lbmeta014_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta014_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta014_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta014_p.secret COMPONENT lbmeta014_a 'SECRET', COMPONENT lbmeta014_s 'RD', COMPONENT lbmeta014_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta014_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta014_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta014_p.internal COMPONENT lbmeta014_a 'INTERNAL', COMPONENT lbmeta014_s 'RD', COMPONENT lbmeta014_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta014_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta014_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta014_p.public COMPONENT lbmeta014_a 'PUBLIC', COMPONENT lbmeta014_s 'RD', COMPONENT lbmeta014_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta014_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta014_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta014_p.wide COMPONENT lbmeta014_a 'SECRET', COMPONENT lbmeta014_s 'RD','QA', COMPONENT lbmeta014_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta014_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta014_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbmeta014_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbmeta014_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbmeta014_db TO USER lbmeta014_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbmeta014_db TO USER lbmeta014_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbmeta014_db TO USER lbmeta014_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbmeta014_db TO USER lbmeta014_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbmeta014_db TO USER lbmeta014_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbmeta014_db TO USER lbmeta014_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbmeta014_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbmeta014_p.secret TO USER lbmeta014_u FOR READ ACCESS;

-- 48. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbmeta014_p.secret TO USER lbmeta014_u FOR WRITE ACCESS;

-- 49. 删除安全标签组件并验证引用约束；本语句预期失败，需核对 SQLSTATE 及错误原因
DROP SECURITY LABEL COMPONENT lbmeta014_a;
<<SQLSTATE;

-- 50. 删除 LBAC 安全策略并验证依赖约束；本语句预期失败，需核对 SQLSTATE 及错误原因
DROP SECURITY POLICY lbmeta014_p;
<<SQLSTATE;

-- 51. 删除安全标签并验证依赖约束；本语句预期失败，需核对 SQLSTATE 及错误原因
DROP SECURITY LABEL lbmeta014_p.secret;
<<SQLSTATE;

-- 52. 切换当前数据库或元数据查询范围
USE lbmeta014_db;

-- 53. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(plain)=10 AND MIN(low)=20 AND MIN(high)=30 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;

-- 54. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbmeta014_db' AND table_name='metrics' AND column_name='high' AND security_label='secret';

-- 55. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics DROP SECURITY POLICY;

-- 56. 删除安全标签并验证依赖约束；本语句预期失败，需核对 SQLSTATE 及错误原因
DROP SECURITY LABEL lbmeta014_p.secret;
<<SQLSTATE;

-- 57. 授予或撤销安全标签访问权限并验证授权行为
REVOKE SECURITY LABEL lbmeta014_p.secret FROM USER lbmeta014_u;

-- 58. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta014_p.secret;

-- 59. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta014_p' AND label_name='secret';

-- 60. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lbmeta014_db;
<<NULL;

-- 61. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbmeta014_db;
<<NULL;

-- 62. 清理本用例创建的数据表
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 63. 切换当前数据库或元数据查询范围
USE information_schema;

-- 64. 删除本用例隔离的测试数据库
DROP DATABASE lbmeta014_db;
<<NULL;

-- 65. 删除用例创建的普通用户
DROP USER lbmeta014_u;
<<NULL;

-- 66. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbmeta014_p FROM USER root;
<<NULL;

-- 67. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta014_p.wide;
<<NULL;

-- 68. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta014_p.public;
<<NULL;

-- 69. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta014_p.internal;
<<NULL;

-- 70. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta014_p.top;
<<NULL;

-- 71. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbmeta014_p;
<<NULL;

-- 72. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbmeta014_t;

-- 73. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbmeta014_s;

-- 74. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbmeta014_a;

-- 75. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

