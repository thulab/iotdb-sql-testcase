-- 62. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta005_p.secret;
<<NULL;

-- 63. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta005_p.top;
<<NULL;

-- 64. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbmeta005_p;
<<NULL;

-- 65. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbmeta005_t;

-- 66. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbmeta005_s;

-- 67. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbmeta005_a;

