-- 59. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta005_p.wide;
<<NULL;

-- 60. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta005_p.public;
<<NULL;

-- 61. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta005_p.internal;
