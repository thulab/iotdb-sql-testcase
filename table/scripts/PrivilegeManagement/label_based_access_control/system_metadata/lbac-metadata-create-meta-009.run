-- 60. 执行 REVOKE 操作并验证用例行为
REVOKE CREATE ON DATABASE lbmeta009_db FROM USER lbmeta009_u;

-- 61. 执行 REVOKE 操作并验证用例行为
REVOKE DROP ON DATABASE lbmeta009_db FROM USER lbmeta009_u;

-- 62. 授予测试用户执行目标操作所需的数据库权限
