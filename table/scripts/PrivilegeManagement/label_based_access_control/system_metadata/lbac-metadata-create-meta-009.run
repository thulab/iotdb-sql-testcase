-- 表列保护关系按普通权限可见

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbmeta009_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbmeta009_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP USER lbmeta009_v;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbmeta009_p FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta009_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta009_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta009_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta009_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta009_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbmeta009_p;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbmeta009_a;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbmeta009_s;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbmeta009_t;
<<NULL;

-- 17. 操作步骤: SYSTEM、两个各仅有一张表任意普通权限的用户及无权用户，查询表/列关系表并与 SHOW TABLES 对照；随后撤销普通权限。；预期结果: SYSTEM 看全部；普通用户仅见有任意普通权限的表及其列关系，无权用户为 0。过滤、join、count、视图不可绕过；撤权后只隐藏行，不删除真实元数据。；创建本用例隔离的测试数据库
CREATE DATABASE lbmeta009_db;

-- 18. 切换当前数据库或元数据查询范围
USE lbmeta009_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbmeta009_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbmeta009_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbmeta009_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbmeta009_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbmeta009_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbmeta009_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbmeta009_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbmeta009_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbmeta009_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbmeta009_p COMPONENTS lbmeta009_a,lbmeta009_s,lbmeta009_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta009_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbmeta009_p';

-- 27. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbmeta009_p TO USER root;

-- 28. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta009_p.top COMPONENT lbmeta009_a 'TOP', COMPONENT lbmeta009_s 'RD', COMPONENT lbmeta009_t 'A1';

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta009_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta009_p' AND label_name='top';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta009_p.secret COMPONENT lbmeta009_a 'SECRET', COMPONENT lbmeta009_s 'RD', COMPONENT lbmeta009_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta009_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta009_p' AND label_name='secret';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta009_p.internal COMPONENT lbmeta009_a 'INTERNAL', COMPONENT lbmeta009_s 'RD', COMPONENT lbmeta009_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta009_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta009_p' AND label_name='internal';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta009_p.public COMPONENT lbmeta009_a 'PUBLIC', COMPONENT lbmeta009_s 'RD', COMPONENT lbmeta009_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta009_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta009_p' AND label_name='public';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta009_p.wide COMPONENT lbmeta009_a 'SECRET', COMPONENT lbmeta009_s 'RD','QA', COMPONENT lbmeta009_t 'ROOT';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta009_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta009_p' AND label_name='wide';

-- 38. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbmeta009_p TO USER root;

-- 39. 创建用例使用的普通用户
CREATE USER lbmeta009_u 'LbacTest_2026!';

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbmeta009_db TO USER lbmeta009_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbmeta009_db TO USER lbmeta009_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbmeta009_db TO USER lbmeta009_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbmeta009_db TO USER lbmeta009_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbmeta009_db TO USER lbmeta009_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbmeta009_db TO USER lbmeta009_u;

-- 46. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbmeta009_p;

-- 47. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 48. 创建用于验证 LBAC 保护的数据表
CREATE TABLE second(v INT32 FIELD SECURED WITH secret) SECURITY POLICY lbmeta009_p;

-- 49. 创建用例使用的普通用户
CREATE USER lbmeta009_v 'LbacTest_2026!';

-- 50. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbmeta009_db TO USER lbmeta009_v;

-- 51. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbmeta009_db TO USER lbmeta009_v;

-- 52. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbmeta009_db TO USER lbmeta009_v;

-- 53. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbmeta009_db TO USER lbmeta009_v;

-- 54. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbmeta009_db TO USER lbmeta009_v;

-- 55. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbmeta009_db TO USER lbmeta009_v;

-- 56. 执行 REVOKE 操作并验证用例行为
REVOKE SELECT ON DATABASE lbmeta009_db FROM USER lbmeta009_u;

-- 57. 执行 REVOKE 操作并验证用例行为
REVOKE INSERT ON DATABASE lbmeta009_db FROM USER lbmeta009_u;

-- 58. 执行 REVOKE 操作并验证用例行为
