connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbmeta009_db;
REVOKE SELECT ON TABLE lbmeta009_db.metrics FROM USER lbmeta009_u;
-- 切回测试账号继续用例
connect lbmeta009_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;

-- 71. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
