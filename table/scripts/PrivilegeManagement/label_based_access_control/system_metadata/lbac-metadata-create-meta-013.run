-- 表列保护绑定、换标、解除与删除

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbmeta013_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbmeta013_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbmeta013_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta013_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta013_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta013_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta013_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbmeta013_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbmeta013_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbmeta013_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbmeta013_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbmeta013_t;
<<NULL;

-- 16. 操作步骤: 依次执行表绑定、四类列绑定、换标、解除列保护、表解绑、DROP TABLE/DATABASE，每步核对关系表与 SHOW CREATE。；预期结果: 表绑定需 ALTER；换标需 ALTER+旧 READ/WRITE+新 WRITE；列解除需 ALTER+旧 READ/WRITE；表解绑需 ALTER+SECURITY 并清空列关系；DROP 仅按普通 DDL 且保留全局定义。；创建本用例隔离的测试数据库
CREATE DATABASE lbmeta013_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbmeta013_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbmeta013_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbmeta013_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbmeta013_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbmeta013_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbmeta013_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbmeta013_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbmeta013_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbmeta013_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbmeta013_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbmeta013_p COMPONENTS lbmeta013_a,lbmeta013_s,lbmeta013_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta013_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbmeta013_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbmeta013_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta013_p.top COMPONENT lbmeta013_a 'TOP', COMPONENT lbmeta013_s 'RD', COMPONENT lbmeta013_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta013_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta013_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta013_p.secret COMPONENT lbmeta013_a 'SECRET', COMPONENT lbmeta013_s 'RD', COMPONENT lbmeta013_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta013_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta013_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta013_p.internal COMPONENT lbmeta013_a 'INTERNAL', COMPONENT lbmeta013_s 'RD', COMPONENT lbmeta013_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta013_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta013_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta013_p.public COMPONENT lbmeta013_a 'PUBLIC', COMPONENT lbmeta013_s 'RD', COMPONENT lbmeta013_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta013_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta013_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbmeta013_p.wide COMPONENT lbmeta013_a 'SECRET', COMPONENT lbmeta013_s 'RD','QA', COMPONENT lbmeta013_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbmeta013_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbmeta013_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbmeta013_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbmeta013_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbmeta013_db TO USER lbmeta013_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbmeta013_db TO USER lbmeta013_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbmeta013_db TO USER lbmeta013_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbmeta013_db TO USER lbmeta013_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbmeta013_db TO USER lbmeta013_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbmeta013_db TO USER lbmeta013_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbmeta013_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbmeta013_p.secret TO USER lbmeta013_u FOR READ ACCESS;

-- 48. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lbmeta013_p.secret TO USER lbmeta013_u FOR WRITE ACCESS;

-- 49. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics DROP SECURITY POLICY;

-- 50. 使用当前测试账号建立数据库连接
connect lbmeta013_u/LbacTest_2026!;

-- 51. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 52. 切换当前数据库或元数据查询范围
USE lbmeta013_db;

-- 53. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ADD SECURITY POLICY lbmeta013_p;

-- 54. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN time SECURED WITH secret;

-- 55. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN device SECURED WITH secret;

-- 56. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN owner SECURED WITH secret;

-- 57. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN high SECURED WITH secret;

-- 58. 切换当前数据库或元数据查询范围
USE lbmeta013_db;

-- 59. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbmeta013_db' AND table_name='metrics' AND column_name='time' AND security_label='secret';

-- 60. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbmeta013_db' AND table_name='metrics' AND column_name='device' AND security_label='secret';

-- 61. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbmeta013_db' AND table_name='metrics' AND column_name='owner' AND security_label='secret';

-- 62. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbmeta013_db' AND table_name='metrics' AND column_name='high' AND security_label='secret';

-- 63. 切换当前数据库或元数据查询范围
USE lbmeta013_db;

-- 64. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN time DROP COLUMN SECURITY;

-- 65. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN device DROP COLUMN SECURITY;

-- 66. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN owner DROP COLUMN SECURITY;

-- 67. 修改数据表的 LBAC 保护配置
ALTER TABLE metrics ALTER COLUMN high DROP COLUMN SECURITY;

-- 68. 切换当前数据库或元数据查询范围
USE lbmeta013_db;

-- 69. 修改数据表的 LBAC 保护配置
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbmeta013_db;
ALTER TABLE metrics DROP SECURITY POLICY;
-- 切回测试账号继续用例
connect lbmeta013_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbmeta013_db;

-- 70. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.columns WHERE database='lbmeta013_db' AND table_name='metrics' AND security_label IS NOT NULL;

-- 71. 切换当前数据库或元数据查询范围
USE lbmeta013_db;

-- 72. 清理本用例创建的数据表
DROP TABLE metrics;
<<NULL;

-- 73. 切换当前数据库或元数据查询范围
USE lbmeta013_db;

-- 74. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbmeta013_p';

-- 75. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lbmeta013_db;
<<NULL;

-- 76. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbmeta013_db;
<<NULL;

-- 77. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 78. 清理本用例创建的数据表
USE lbmeta013_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 79. 切换当前数据库或元数据查询范围
USE information_schema;

-- 80. 删除本用例隔离的测试数据库
DROP DATABASE lbmeta013_db;
<<NULL;

-- 81. 删除用例创建的普通用户
DROP USER lbmeta013_u;
<<NULL;

-- 82. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbmeta013_p FROM USER root;
<<NULL;

-- 83. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta013_p.wide;
<<NULL;

-- 84. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta013_p.public;
<<NULL;

-- 85. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta013_p.internal;
<<NULL;

-- 86. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta013_p.secret;
<<NULL;

-- 87. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbmeta013_p.top;
<<NULL;

-- 88. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbmeta013_p;
<<NULL;

-- 89. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbmeta013_t;

-- 90. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbmeta013_s;

-- 91. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbmeta013_a;

