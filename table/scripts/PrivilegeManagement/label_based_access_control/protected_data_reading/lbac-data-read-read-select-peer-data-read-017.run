connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lbdataread017_db;
GRANT SECURITY LABEL lbdataread017_p.secret TO USER lbdataread017_u FOR READ ACCESS;
-- 切回测试账号继续用例
connect lbdataread017_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lbdataread017_db;

-- 58. 切换当前数据库或元数据查询范围
USE lbdataread017_db;

-- 59. 读取受保护数据并验证 LBAC 读权限
SELECT m.plain,p.threshold FROM metrics m JOIN peer p ON m.high=p.threshold;

-- 60. 读取受保护数据并验证 LBAC 读权限
SELECT m.plain,p.threshold FROM metrics m LEFT JOIN peer p ON m.high=p.threshold;

-- 61. 读取受保护数据并验证 LBAC 读权限
SELECT m.plain,p.threshold FROM peer p LEFT JOIN metrics m ON m.high=p.threshold;

-- 62. 读取受保护数据并验证 LBAC 读权限
SELECT m.plain,p.threshold FROM peer p RIGHT JOIN metrics m ON m.high=p.threshold;

