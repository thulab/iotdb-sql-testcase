-- DESCRIBE 与 SHOW CREATE 的展示差异

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbdataread020_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbdataread020_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataread020_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataread020_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataread020_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataread020_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataread020_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbdataread020_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbdataread020_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataread020_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataread020_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbdataread020_t;
<<NULL;

-- 16. 操作步骤: 无任何 Label、具备元数据命令普通权限的用户，对受保护表执行 DESCRIBE 和 SHOW CREATE TABLE。；预期结果: 两者均成功且不需 LBAC；DESCRIBE 不展示 Label，SHOW CREATE 展示表 Policy 与列 Label；均不泄露列值或主体授权。；创建本用例隔离的测试数据库
CREATE DATABASE lbdataread020_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbdataread020_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataread020_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataread020_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataread020_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataread020_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataread020_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataread020_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbdataread020_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbdataread020_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbdataread020_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbdataread020_p COMPONENTS lbdataread020_a,lbdataread020_s,lbdataread020_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataread020_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbdataread020_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataread020_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataread020_p.top COMPONENT lbdataread020_a 'TOP', COMPONENT lbdataread020_s 'RD', COMPONENT lbdataread020_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataread020_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataread020_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataread020_p.secret COMPONENT lbdataread020_a 'SECRET', COMPONENT lbdataread020_s 'RD', COMPONENT lbdataread020_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataread020_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataread020_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataread020_p.internal COMPONENT lbdataread020_a 'INTERNAL', COMPONENT lbdataread020_s 'RD', COMPONENT lbdataread020_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataread020_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataread020_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataread020_p.public COMPONENT lbdataread020_a 'PUBLIC', COMPONENT lbdataread020_s 'RD', COMPONENT lbdataread020_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataread020_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataread020_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbdataread020_p.wide COMPONENT lbdataread020_a 'SECRET', COMPONENT lbdataread020_s 'RD','QA', COMPONENT lbdataread020_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbdataread020_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbdataread020_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbdataread020_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbdataread020_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbdataread020_db TO USER lbdataread020_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbdataread020_db TO USER lbdataread020_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbdataread020_db TO USER lbdataread020_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbdataread020_db TO USER lbdataread020_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbdataread020_db TO USER lbdataread020_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbdataread020_db TO USER lbdataread020_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbdataread020_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 使用当前测试账号建立数据库连接
connect lbdataread020_u/LbacTest_2026!;

-- 48. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 49. 切换当前数据库或元数据查询范围
USE lbdataread020_db;

-- 50. 执行 DESCRIBE 操作并验证用例行为
DESCRIBE metrics;

-- 51. 查询对象信息并验证 LBAC 可见性
SHOW CREATE TABLE metrics;

-- 52. 清理本条额外视图及表；失败路径同样执行；切换当前数据库或元数据查询范围
USE lbdataread020_db;
<<NULL;

-- 53. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbdataread020_db;
<<NULL;

-- 54. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 55. 清理本用例创建的数据表
USE lbdataread020_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 56. 切换当前数据库或元数据查询范围
USE information_schema;

-- 57. 删除本用例隔离的测试数据库
DROP DATABASE lbdataread020_db;
<<NULL;

-- 58. 删除用例创建的普通用户
DROP USER lbdataread020_u;
<<NULL;

-- 59. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbdataread020_p FROM USER root;
<<NULL;

-- 60. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataread020_p.wide;
<<NULL;

-- 61. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataread020_p.public;
<<NULL;

-- 62. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataread020_p.internal;
<<NULL;

-- 63. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataread020_p.secret;
<<NULL;

-- 64. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbdataread020_p.top;
<<NULL;

-- 65. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbdataread020_p;
<<NULL;

-- 66. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdataread020_t;

-- 67. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdataread020_s;

-- 68. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdataread020_a;

-- 69. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 70. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 71. 结束清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 72. 结束清理：删除本用例对象
DROP DATABASE lbdataread020_db;
<<NULL;

-- 73. 结束清理：删除本用例对象
DROP USER lbdataread020_u;
<<NULL;

-- 74. 结束清理：删除本用例对象
REVOKE EXEMPTION ON RULE ALL FOR lbdataread020_p FROM USER root;
<<NULL;

-- 75. 结束清理：删除本用例对象
DROP SECURITY LABEL lbdataread020_p.top;
<<NULL;

-- 76. 结束清理：删除本用例对象
DROP SECURITY LABEL lbdataread020_p.secret;
<<NULL;

-- 77. 结束清理：删除本用例对象
DROP SECURITY LABEL lbdataread020_p.internal;
<<NULL;

-- 78. 结束清理：删除本用例对象
DROP SECURITY LABEL lbdataread020_p.public;
<<NULL;

-- 79. 结束清理：删除本用例对象
DROP SECURITY LABEL lbdataread020_p.wide;
<<NULL;

-- 80. 结束清理：删除本用例对象
