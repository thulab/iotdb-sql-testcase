-- u_plain 无 SECURITY 权限

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbm01_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbm01_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbm01_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbm01_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbm01_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbm01_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbm01_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbm01_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbm01_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbm01_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbm01_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbm01_t;
<<NULL;

-- 16. 操作步骤: 查询策略、组件、元素、策略组件规则、标签五张 security_* LBAC 定义表。；预期结果: 五表定义数据均可查询；不因缺 SECURITY 拒绝，敏感授权和免除数据不混入其中。；创建本用例隔离的测试数据库
CREATE DATABASE lbm01_db;

-- 17. 切换当前数据库或元数据查询范围
USE lbm01_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbm01_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbm01_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbm01_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbm01_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbm01_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbm01_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbm01_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbm01_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbm01_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbm01_p COMPONENTS lbm01_a,lbm01_s,lbm01_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbm01_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbm01_p';

-- 26. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbm01_p TO USER root;

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbm01_p.top COMPONENT lbm01_a 'TOP', COMPONENT lbm01_s 'RD', COMPONENT lbm01_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbm01_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbm01_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbm01_p.secret COMPONENT lbm01_a 'SECRET', COMPONENT lbm01_s 'RD', COMPONENT lbm01_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbm01_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbm01_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbm01_p.internal COMPONENT lbm01_a 'INTERNAL', COMPONENT lbm01_s 'RD', COMPONENT lbm01_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbm01_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbm01_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbm01_p.public COMPONENT lbm01_a 'PUBLIC', COMPONENT lbm01_s 'RD', COMPONENT lbm01_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbm01_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbm01_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbm01_p.wide COMPONENT lbm01_a 'SECRET', COMPONENT lbm01_s 'RD','QA', COMPONENT lbm01_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbm01_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbm01_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbm01_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbm01_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbm01_db TO USER lbm01_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbm01_db TO USER lbm01_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbm01_db TO USER lbm01_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbm01_db TO USER lbm01_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbm01_db TO USER lbm01_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbm01_db TO USER lbm01_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lbm01_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 执行 REVOKE 操作并验证用例行为
REVOKE SELECT ON DATABASE lbm01_db FROM USER lbm01_u;

-- 48. 执行 REVOKE 操作并验证用例行为
REVOKE INSERT ON DATABASE lbm01_db FROM USER lbm01_u;

-- 49. 执行 REVOKE 操作并验证用例行为
REVOKE DELETE ON DATABASE lbm01_db FROM USER lbm01_u;

-- 50. 执行 REVOKE 操作并验证用例行为
REVOKE ALTER ON DATABASE lbm01_db FROM USER lbm01_u;

-- 51. 执行 REVOKE 操作并验证用例行为
REVOKE CREATE ON DATABASE lbm01_db FROM USER lbm01_u;

-- 52. 执行 REVOKE 操作并验证用例行为
REVOKE DROP ON DATABASE lbm01_db FROM USER lbm01_u;

-- 53. 使用当前测试账号建立数据库连接
connect lbm01_u/LbacTest_2026!;

-- 54. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 55. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbm01_p';

-- 56. 查询 LBAC 元数据并核对断言条件
SELECT policy_name, component_count, rule_set, role_authorizations, remarks FROM information_schema.security_policies WHERE policy_name='lbm01_p';

-- 57. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbm01_a';

-- 58. 查询 LBAC 元数据并核对断言条件
SELECT component_name, component_type, element_count, remarks FROM information_schema.security_label_components WHERE component_name='lbm01_a';

-- 59. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=4 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_component_elements WHERE component_name='lbm01_a';

-- 60. 查询 LBAC 元数据并核对断言条件
SELECT * FROM information_schema.security_label_component_elements WHERE component_name='lbm01_a';

-- 61. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=3 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policy_component_rules WHERE policy_name='lbm01_p';

-- 62. 查询 LBAC 元数据并核对断言条件
SELECT * FROM information_schema.security_policy_component_rules WHERE policy_name='lbm01_p';

-- 63. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=5 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbm01_p';

-- 64. 查询 LBAC 元数据并核对断言条件
SELECT label_name, policy_name, label_value, remarks FROM information_schema.security_labels WHERE policy_name='lbm01_p' ORDER BY label_name;

