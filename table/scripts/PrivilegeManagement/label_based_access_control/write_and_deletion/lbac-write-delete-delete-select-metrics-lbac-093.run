-- ARRAY 同等级写

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbac093_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbac093_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbac093_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac093_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac093_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac093_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac093_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac093_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac093_p.subject;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac093_p.object;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbac093_p;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac093_a;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac093_s;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac093_t;
<<NULL;

-- 18. 创建本用例隔离的测试数据库
CREATE DATABASE lblbac093_db;

-- 19. 切换当前数据库或元数据查询范围
USE lblbac093_db;

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac093_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac093_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac093_a';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac093_s SET ('RD','QA','OPS');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac093_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac093_s';

-- 24. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac093_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac093_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac093_t';

-- 26. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbac093_p COMPONENTS lblbac093_a,lblbac093_s,lblbac093_t WITH LBACRULES;

-- 27. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac093_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbac093_p';

-- 28. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac093_p.top COMPONENT lblbac093_a 'TOP', COMPONENT lblbac093_s 'RD', COMPONENT lblbac093_t 'A1';

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac093_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac093_p' AND label_name='top';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac093_p.secret COMPONENT lblbac093_a 'SECRET', COMPONENT lblbac093_s 'RD', COMPONENT lblbac093_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac093_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac093_p' AND label_name='secret';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac093_p.internal COMPONENT lblbac093_a 'INTERNAL', COMPONENT lblbac093_s 'RD', COMPONENT lblbac093_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac093_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac093_p' AND label_name='internal';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac093_p.public COMPONENT lblbac093_a 'PUBLIC', COMPONENT lblbac093_s 'RD', COMPONENT lblbac093_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac093_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac093_p' AND label_name='public';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac093_p.wide COMPONENT lblbac093_a 'SECRET', COMPONENT lblbac093_s 'RD','QA', COMPONENT lblbac093_t 'ROOT';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac093_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac093_p' AND label_name='wide';

-- 38. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbac093_p TO USER root;

-- 39. 创建用例使用的普通用户
CREATE USER lblbac093_u 'LbacTest_2026!';

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbac093_db TO USER lblbac093_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbac093_db TO USER lblbac093_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbac093_db TO USER lblbac093_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbac093_db TO USER lblbac093_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbac093_db TO USER lblbac093_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbac093_db TO USER lblbac093_u;

-- 46. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac093_p.subject COMPONENT lblbac093_a 'SECRET';

-- 47. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac093_p' AND MIN(label_name)='subject' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac093_p' AND label_name='subject';

-- 48. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac093_p.object COMPONENT lblbac093_a 'SECRET';

-- 49. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac093_p' AND MIN(label_name)='object' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac093_p' AND label_name='object';

-- 50. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG,v INT32 FIELD SECURED WITH object) SECURITY POLICY lblbac093_p;

-- 51. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,v) VALUES(1,'d1',20);

-- 52. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbac093_p.subject TO USER lblbac093_u FOR WRITE ACCESS;

-- 53. 使用当前测试账号建立数据库连接
connect lblbac093_u/LbacTest_2026!;

-- 54. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 55. 切换当前数据库或元数据查询范围
USE lblbac093_db;

-- 56. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,v) VALUES(2,'d1',99);

-- 57. 切换当前数据库或元数据查询范围
USE lblbac093_db;

-- 58. 断言应返回整数1，否则 CAST 失败；执行断言查询，条件不满足时使断言失败
SELECT CAST(CASE WHEN COUNT(*)=2 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM metrics;

-- 59. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lblbac093_db;
<<NULL;

-- 60. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 61. 清理本用例创建的数据表
USE lblbac093_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 62. 切换当前数据库或元数据查询范围
USE information_schema;

-- 63. 删除本用例隔离的测试数据库
DROP DATABASE lblbac093_db;
<<NULL;

-- 64. 删除用例创建的普通用户
DROP USER lblbac093_u;
<<NULL;

-- 65. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lblbac093_p FROM USER root;
<<NULL;

-- 66. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac093_p.object;
<<NULL;

-- 67. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac093_p.subject;
<<NULL;

-- 68. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac093_p.wide;
<<NULL;

-- 69. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac093_p.public;
<<NULL;

-- 70. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac093_p.internal;
<<NULL;

-- 71. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac093_p.secret;
<<NULL;

-- 72. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac093_p.top;
<<NULL;

-- 73. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lblbac093_p;

-- 74. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac093_t;

-- 75. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac093_s;

-- 76. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac093_a;

-- 77. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 78. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

