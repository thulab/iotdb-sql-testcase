-- 70. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdatainsert010_s;

-- 71. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbdatainsert010_a;

