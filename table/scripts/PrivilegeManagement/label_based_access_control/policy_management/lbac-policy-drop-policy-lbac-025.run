-- 43. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac025_p.wide;
<<NULL;

-- 44. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac025_p.public;
<<NULL;

-- 45. 删除安全标签并验证依赖约束
