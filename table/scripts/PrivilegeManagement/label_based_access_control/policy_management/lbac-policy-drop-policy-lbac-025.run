<<NULL;

-- 46. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac025_p.secret;
<<NULL;

-- 47. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac025_p.top;
<<NULL;

-- 48. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lblbac025_p;
<<NULL;

-- 49. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac025_t;

-- 50. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac025_s;

-- 51. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac025_a;

