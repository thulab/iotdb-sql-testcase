DROP SECURITY LABEL lbp02_p.top;
<<NULL;

-- 61. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbp02_p2;
<<NULL;

-- 62. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbp02_p;

-- 63. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbp02_t;

-- 64. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbp02_s;

-- 65. 删除安全标签组件并验证引用约束
