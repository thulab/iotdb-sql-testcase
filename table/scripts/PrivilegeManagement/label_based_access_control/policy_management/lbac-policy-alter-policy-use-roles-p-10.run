-- 新建 p_role，验证角色授权开关

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbp10_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbp10_p FROM USER root;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbp10_p.top;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbp10_p.secret;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbp10_p.internal;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbp10_p.public;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbp10_p.wide;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbp10_p;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbp10_a;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbp10_s;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbp10_t;
<<NULL;

-- 15. 创建本用例隔离的测试数据库
CREATE DATABASE lbp10_db;

-- 16. 切换当前数据库或元数据查询范围
USE lbp10_db;

-- 17. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbp10_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 18. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbp10_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbp10_a';

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbp10_s SET ('RD','QA','OPS');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbp10_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbp10_s';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbp10_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbp10_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbp10_t';

-- 23. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbp10_p COMPONENTS lbp10_a,lbp10_s,lbp10_t WITH LBACRULES;

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbp10_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbp10_p';

-- 25. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbp10_p.top COMPONENT lbp10_a 'TOP', COMPONENT lbp10_s 'RD', COMPONENT lbp10_t 'A1';

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbp10_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbp10_p' AND label_name='top';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbp10_p.secret COMPONENT lbp10_a 'SECRET', COMPONENT lbp10_s 'RD', COMPONENT lbp10_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbp10_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbp10_p' AND label_name='secret';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbp10_p.internal COMPONENT lbp10_a 'INTERNAL', COMPONENT lbp10_s 'RD', COMPONENT lbp10_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbp10_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbp10_p' AND label_name='internal';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbp10_p.public COMPONENT lbp10_a 'PUBLIC', COMPONENT lbp10_s 'RD', COMPONENT lbp10_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbp10_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbp10_p' AND label_name='public';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbp10_p.wide COMPONENT lbp10_a 'SECRET', COMPONENT lbp10_s 'RD','QA', COMPONENT lbp10_t 'ROOT';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbp10_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbp10_p' AND label_name='wide';

-- 35. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbp10_p TO USER root;

-- 36. 修改 LBAC 安全策略并验证策略行为
ALTER SECURITY POLICY lbp10_p USE ROLE AUTHORIZATIONS;

-- 37. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(role_authorizations)='USED' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbp10_p';

-- 38. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lbp10_db;
<<NULL;

-- 39. 清理本用例创建的数据表
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 40. 切换当前数据库或元数据查询范围
USE information_schema;

-- 41. 删除本用例隔离的测试数据库
DROP DATABASE lbp10_db;
<<NULL;

-- 42. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lbp10_p FROM USER root;
<<NULL;

-- 43. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbp10_p.wide;
<<NULL;

-- 44. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbp10_p.public;
<<NULL;

-- 45. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbp10_p.internal;
<<NULL;

-- 46. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbp10_p.secret;
<<NULL;

-- 47. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbp10_p.top;
<<NULL;

-- 48. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbp10_p;
<<NULL;

-- 49. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbp10_t;

-- 50. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbp10_s;

-- 51. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbp10_a;

-- 52. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 53. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

