DROP SECURITY LABEL lbp10_p.top;
<<NULL;

-- 58. 结束清理：删除本用例对象
DROP SECURITY LABEL lbp10_p.secret;
<<NULL;

-- 59. 结束清理：删除本用例对象
DROP SECURITY LABEL lbp10_p.internal;
