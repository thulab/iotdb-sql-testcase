<<NULL;

-- 56. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbp07_p.secret;
<<NULL;

-- 57. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lbp07_p.top;
<<NULL;

-- 58. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lbp07_p;
<<NULL;

-- 59. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbp07_t;

-- 60. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbp07_s;

-- 61. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbp07_a;

