-- 被表使用时追加 Component

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbac024_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbac024_p FROM USER root;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac024_p.top;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac024_p.secret;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac024_p.internal;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac024_p.public;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac024_p.wide;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbac024_p;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac024_a;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac024_s;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac024_t;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac024extra;
<<NULL;

-- 16. 创建本用例隔离的测试数据库
CREATE DATABASE lblbac024_db;

-- 17. 切换当前数据库或元数据查询范围
USE lblbac024_db;

-- 18. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac024_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 19. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac024_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac024_a';

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac024_s SET ('RD','QA','OPS');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac024_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac024_s';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac024_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac024_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac024_t';

-- 24. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbac024_p COMPONENTS lblbac024_a,lblbac024_s,lblbac024_t WITH LBACRULES;

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac024_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbac024_p';

-- 26. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac024_p.top COMPONENT lblbac024_a 'TOP', COMPONENT lblbac024_s 'RD', COMPONENT lblbac024_t 'A1';

-- 27. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac024_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac024_p' AND label_name='top';

-- 28. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac024_p.secret COMPONENT lblbac024_a 'SECRET', COMPONENT lblbac024_s 'RD', COMPONENT lblbac024_t 'A1';

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac024_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac024_p' AND label_name='secret';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac024_p.internal COMPONENT lblbac024_a 'INTERNAL', COMPONENT lblbac024_s 'RD', COMPONENT lblbac024_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac024_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac024_p' AND label_name='internal';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac024_p.public COMPONENT lblbac024_a 'PUBLIC', COMPONENT lblbac024_s 'RD', COMPONENT lblbac024_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac024_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac024_p' AND label_name='public';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac024_p.wide COMPONENT lblbac024_a 'SECRET', COMPONENT lblbac024_s 'RD','QA', COMPONENT lblbac024_t 'ROOT';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac024_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac024_p' AND label_name='wide';

-- 36. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbac024_p TO USER root;

-- 37. 创建用于验证 LBAC 保护的数据表
CREATE TABLE bound(v INT32 FIELD) SECURITY POLICY lblbac024_p;

-- 38. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac024extra SET ('X');

-- 39. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac024extra' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac024extra';

-- 40. 修改 LBAC 安全策略并验证策略行为；本语句预期失败，需核对 SQLSTATE 及错误原因
ALTER SECURITY POLICY lblbac024_p ADD SECURITY LABEL COMPONENT lblbac024extra;
<<SQLSTATE;

-- 41. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lblbac024_db;
<<NULL;

-- 42. 清理本用例创建的数据表
DROP TABLE IF EXISTS metrics;
<<NULL;

-- 43. 切换当前数据库或元数据查询范围
USE information_schema;

-- 44. 删除本用例隔离的测试数据库
DROP DATABASE lblbac024_db;
<<NULL;

-- 45. 授予或撤销 LBAC 规则豁免并验证豁免行为
REVOKE EXEMPTION ON RULE ALL FOR lblbac024_p FROM USER root;
<<NULL;

-- 46. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac024_p.wide;
<<NULL;

-- 47. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac024_p.public;
<<NULL;

-- 48. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac024_p.internal;
<<NULL;

-- 49. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac024_p.secret;
<<NULL;

-- 50. 删除安全标签并验证依赖约束
DROP SECURITY LABEL lblbac024_p.top;
<<NULL;

-- 51. 删除 LBAC 安全策略并验证依赖约束
DROP SECURITY POLICY lblbac024_p;
<<NULL;

-- 52. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac024extra;
<<NULL;

-- 53. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac024_t;

-- 54. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac024_s;

-- 55. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac024_a;

-- 56. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 57. 结束清理：切换到表模型 SQL 方言
