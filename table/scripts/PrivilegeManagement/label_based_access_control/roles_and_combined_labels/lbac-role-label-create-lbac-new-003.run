-- READ 与 WRITE 合并输入隔离

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacnew003_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacnew003_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP ROLE lblbacnew003_r;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacnew003_p FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew003_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew003_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew003_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew003_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew003_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacnew003_p;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew003_a;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew003_s;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew003_t;
<<NULL;

-- 17. 创建本用例隔离的测试数据库
CREATE DATABASE lblbacnew003_db;

-- 18. 切换当前数据库或元数据查询范围
USE lblbacnew003_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew003_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew003_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew003_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew003_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew003_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew003_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew003_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew003_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew003_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacnew003_p COMPONENTS lblbacnew003_a,lblbacnew003_s,lblbacnew003_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew003_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacnew003_p';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew003_p.top COMPONENT lblbacnew003_a 'TOP', COMPONENT lblbacnew003_s 'RD', COMPONENT lblbacnew003_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew003_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew003_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew003_p.secret COMPONENT lblbacnew003_a 'SECRET', COMPONENT lblbacnew003_s 'RD', COMPONENT lblbacnew003_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew003_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew003_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew003_p.internal COMPONENT lblbacnew003_a 'INTERNAL', COMPONENT lblbacnew003_s 'RD', COMPONENT lblbacnew003_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew003_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew003_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew003_p.public COMPONENT lblbacnew003_a 'PUBLIC', COMPONENT lblbacnew003_s 'RD', COMPONENT lblbacnew003_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew003_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew003_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew003_p.wide COMPONENT lblbacnew003_a 'SECRET', COMPONENT lblbacnew003_s 'RD','QA', COMPONENT lblbacnew003_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew003_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew003_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew003_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lblbacnew003_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacnew003_db TO USER lblbacnew003_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacnew003_db TO USER lblbacnew003_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacnew003_db TO USER lblbacnew003_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacnew003_db TO USER lblbacnew003_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacnew003_db TO USER lblbacnew003_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacnew003_db TO USER lblbacnew003_u;

-- 45. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacnew003_p;

-- 46. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 47. 创建用例使用的角色
CREATE ROLE lblbacnew003_r;

-- 48. 授予或撤销用户的角色
GRANT ROLE lblbacnew003_r TO lblbacnew003_u;

-- 49. 修改 LBAC 安全策略并验证策略行为
ALTER SECURITY POLICY lblbacnew003_p USE ROLE AUTHORIZATIONS;

-- 50. 创建用于验证 LBAC 保护的数据表
CREATE TABLE public_target(v INT32 FIELD SECURED WITH public) SECURITY POLICY lblbacnew003_p;

-- 51. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew003_p.secret TO USER lblbacnew003_u FOR READ ACCESS;

-- 52. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew003_p.public TO ROLE lblbacnew003_r FOR WRITE ACCESS;

-- 53. 使用当前测试账号建立数据库连接
connect lblbacnew003_u/LbacTest_2026!;

-- 54. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 55. 切换当前数据库或元数据查询范围
USE lblbacnew003_db;

-- 56. 读取受保护数据并验证 LBAC 读权限
SELECT high FROM metrics ORDER BY time;

-- 57. 写入测试数据并验证 LBAC 写入控制
INSERT INTO public_target(time,v) VALUES(1,1);

-- 58. 写入测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
INSERT INTO metrics(time,device,high) VALUES(2,'d1',99);
<<SQLSTATE;

-- 59. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
USE lblbacnew003_db;
<<NULL;

-- 60. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 61. 清理本用例创建的数据表
USE lblbacnew003_db;
DROP TABLE IF EXISTS metrics;
<<NULL;

DROP TABLE IF EXISTS public_target;

