-- 读标签逐组件合并而非逐标签择一

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacnew001_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacnew001_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP ROLE lblbacnew001_r;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacnew001_p FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew001_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew001_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew001_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew001_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew001_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew001_p.part_left;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew001_p.part_right;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew001_p.target;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacnew001_p;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew001_a;
<<NULL;

-- 18. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew001_s;
<<NULL;

-- 19. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew001_t;
<<NULL;

-- 20. 创建本用例隔离的测试数据库
CREATE DATABASE lblbacnew001_db;

-- 21. 切换当前数据库或元数据查询范围
USE lblbacnew001_db;

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew001_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew001_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew001_a';

-- 24. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew001_s SET ('RD','QA','OPS');

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew001_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew001_s';

-- 26. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew001_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 27. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew001_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew001_t';

-- 28. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacnew001_p COMPONENTS lblbacnew001_a,lblbacnew001_s,lblbacnew001_t WITH LBACRULES;

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew001_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacnew001_p';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew001_p.top COMPONENT lblbacnew001_a 'TOP', COMPONENT lblbacnew001_s 'RD', COMPONENT lblbacnew001_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew001_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew001_p' AND label_name='top';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew001_p.secret COMPONENT lblbacnew001_a 'SECRET', COMPONENT lblbacnew001_s 'RD', COMPONENT lblbacnew001_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew001_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew001_p' AND label_name='secret';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew001_p.internal COMPONENT lblbacnew001_a 'INTERNAL', COMPONENT lblbacnew001_s 'RD', COMPONENT lblbacnew001_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew001_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew001_p' AND label_name='internal';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew001_p.public COMPONENT lblbacnew001_a 'PUBLIC', COMPONENT lblbacnew001_s 'RD', COMPONENT lblbacnew001_t 'A1';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew001_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew001_p' AND label_name='public';

-- 38. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew001_p.wide COMPONENT lblbacnew001_a 'SECRET', COMPONENT lblbacnew001_s 'RD','QA', COMPONENT lblbacnew001_t 'ROOT';

-- 39. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew001_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew001_p' AND label_name='wide';

-- 40. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew001_p TO USER root;

-- 41. 创建用例使用的普通用户
CREATE USER lblbacnew001_u 'LbacTest_2026!';

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacnew001_db TO USER lblbacnew001_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacnew001_db TO USER lblbacnew001_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacnew001_db TO USER lblbacnew001_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacnew001_db TO USER lblbacnew001_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacnew001_db TO USER lblbacnew001_u;

-- 47. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacnew001_db TO USER lblbacnew001_u;

-- 48. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacnew001_p;

-- 49. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 50. 创建用例使用的角色
CREATE ROLE lblbacnew001_r;

-- 51. 授予或撤销用户的角色
GRANT ROLE lblbacnew001_r TO lblbacnew001_u;

-- 52. 修改 LBAC 安全策略并验证策略行为
ALTER SECURITY POLICY lblbacnew001_p USE ROLE AUTHORIZATIONS;

-- 53. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew001_p.part_left COMPONENT lblbacnew001_a 'PUBLIC',COMPONENT lblbacnew001_s 'RD',COMPONENT lblbacnew001_t 'A';

-- 54. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew001_p' AND MIN(label_name)='part_left' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew001_p' AND label_name='part_left';

-- 55. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew001_p.part_right COMPONENT lblbacnew001_a 'SECRET',COMPONENT lblbacnew001_s 'QA',COMPONENT lblbacnew001_t 'B';

-- 56. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew001_p' AND MIN(label_name)='part_right' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew001_p' AND label_name='part_right';

-- 57. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew001_p.target COMPONENT lblbacnew001_a 'SECRET',COMPONENT lblbacnew001_s 'RD','QA',COMPONENT lblbacnew001_t 'A1','B';

-- 58. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew001_p' AND MIN(label_name)='target' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew001_p' AND label_name='target';

-- 59. 创建用于验证 LBAC 保护的数据表
CREATE TABLE merged(v INT32 FIELD SECURED WITH target) SECURITY POLICY lblbacnew001_p;

-- 60. 写入测试数据并验证 LBAC 写入控制
INSERT INTO merged(time,v) VALUES(1,1);

-- 61. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew001_p.part_left TO USER lblbacnew001_u FOR READ ACCESS;

-- 62. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew001_p.part_right TO ROLE lblbacnew001_r FOR READ ACCESS;

-- 63. 使用当前测试账号建立数据库连接
connect lblbacnew001_u/LbacTest_2026!;

-- 64. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 65. 切换当前数据库或元数据查询范围
USE lblbacnew001_db;

-- 66. 读取受保护数据并验证 LBAC 读权限
SELECT v FROM merged;

-- 67. 清理本条命名空间；无通配删除；初始化未被忽略。；切换当前数据库或元数据查询范围
