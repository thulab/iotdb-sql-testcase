-- 新标签向量版本触发组件补拉

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacnew018_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacnew018_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacnew018_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew018_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew018_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew018_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew018_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew018_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew018_p.newversion;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacnew018_p;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew018_a;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew018_s;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew018_t;
<<NULL;

-- 17. 操作步骤: DN 缓存组件 v1；CN ADD 元素生成 v2 并创建含新元素的 Label；DN 读取该 Label。；预期结果: Label 所需版本高于本地组件版本时补拉；使用 v2 正确比较，无未知元素误放行。；创建本用例隔离的测试数据库
CREATE DATABASE lblbacnew018_db;

-- 18. 切换当前数据库或元数据查询范围
USE lblbacnew018_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew018_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew018_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew018_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew018_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew018_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew018_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew018_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew018_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew018_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacnew018_p COMPONENTS lblbacnew018_a,lblbacnew018_s,lblbacnew018_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew018_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacnew018_p';

-- 27. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew018_p TO USER root;

-- 28. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew018_p.top COMPONENT lblbacnew018_a 'TOP', COMPONENT lblbacnew018_s 'RD', COMPONENT lblbacnew018_t 'A1';

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew018_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew018_p' AND label_name='top';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew018_p.secret COMPONENT lblbacnew018_a 'SECRET', COMPONENT lblbacnew018_s 'RD', COMPONENT lblbacnew018_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew018_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew018_p' AND label_name='secret';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew018_p.internal COMPONENT lblbacnew018_a 'INTERNAL', COMPONENT lblbacnew018_s 'RD', COMPONENT lblbacnew018_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew018_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew018_p' AND label_name='internal';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew018_p.public COMPONENT lblbacnew018_a 'PUBLIC', COMPONENT lblbacnew018_s 'RD', COMPONENT lblbacnew018_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew018_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew018_p' AND label_name='public';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew018_p.wide COMPONENT lblbacnew018_a 'SECRET', COMPONENT lblbacnew018_s 'RD','QA', COMPONENT lblbacnew018_t 'ROOT';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew018_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew018_p' AND label_name='wide';

-- 38. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew018_p TO USER root;

-- 39. 创建用例使用的普通用户
CREATE USER lblbacnew018_u 'LbacTest_2026!';

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacnew018_db TO USER lblbacnew018_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacnew018_db TO USER lblbacnew018_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacnew018_db TO USER lblbacnew018_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacnew018_db TO USER lblbacnew018_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacnew018_db TO USER lblbacnew018_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacnew018_db TO USER lblbacnew018_u;

-- 46. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacnew018_p;

-- 47. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 48. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew018_p.secret TO USER lblbacnew018_u FOR READ ACCESS;

-- 49. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew018_p.secret TO USER lblbacnew018_u FOR WRITE ACCESS;

-- 50. 使用当前测试账号建立数据库连接
connect lblbacnew018_u/LbacTest_2026!;

-- 51. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 52. 切换当前数据库或元数据查询范围
USE lblbacnew018_db;

-- 53. 读取受保护数据并验证 LBAC 读权限
SELECT high FROM metrics ORDER BY time;

-- 54. 切换当前数据库或元数据查询范围
USE lblbacnew018_db;

-- 55. 修改安全标签组件并验证元素操作
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lblbacnew018_db;
ALTER SECURITY LABEL COMPONENT lblbacnew018_s ADD ELEMENT 'NEW';

-- 56. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew018_p.newversion COMPONENT lblbacnew018_a 'SECRET', COMPONENT lblbacnew018_s 'NEW', COMPONENT lblbacnew018_t 'A1';
-- 切回测试账号继续用例
connect lblbacnew018_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbacnew018_db;

-- 57. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew018_p' AND MIN(label_name)='newversion' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew018_p' AND label_name='newversion';

-- 58. 修改数据表的 LBAC 保护配置
-- 切回管理员账号执行权限管理
connect root/TimechoDB@2021;
SET SQL_DIALECT=TABLE;
USE lblbacnew018_db;
ALTER TABLE metrics ALTER COLUMN high SECURED WITH newversion;
-- 切回测试账号继续用例
connect lblbacnew018_u/LbacTest_2026!;
SET SQL_DIALECT=TABLE;
USE lblbacnew018_db;

-- 59. 切换当前数据库或元数据查询范围
USE lblbacnew018_db;

-- 60. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
