-- DROP 重建同名组件防 ABA

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacnew019_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacnew019_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacnew019_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew019_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew019_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew019_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew019_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew019_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew019_p.object;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew019_p.subject;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacnew019_p;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew019_a;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew019_s;
<<NULL;

-- 17. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew019_t;
<<NULL;

-- 18. 操作步骤: 清理依赖后删除组件；同名创建不同元素集合及新 Policy/Label；在保留旧缓存的 DN 访问。；预期结果: 全局版本单调递增；新 Label 不使用旧同名组件；重启快照后 counter 仍不倒退。；创建本用例隔离的测试数据库
CREATE DATABASE lblbacnew019_db;

-- 19. 切换当前数据库或元数据查询范围
USE lblbacnew019_db;

-- 20. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew019_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 21. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew019_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew019_a';

-- 22. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew019_s SET ('RD','QA','OPS');

-- 23. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew019_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew019_s';

-- 24. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew019_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 25. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew019_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew019_t';

-- 26. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacnew019_p COMPONENTS lblbacnew019_a,lblbacnew019_s,lblbacnew019_t WITH LBACRULES;

-- 27. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew019_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacnew019_p';

-- 28. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew019_p TO USER root;

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew019_p.top COMPONENT lblbacnew019_a 'TOP', COMPONENT lblbacnew019_s 'RD', COMPONENT lblbacnew019_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew019_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew019_p' AND label_name='top';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew019_p.secret COMPONENT lblbacnew019_a 'SECRET', COMPONENT lblbacnew019_s 'RD', COMPONENT lblbacnew019_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew019_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew019_p' AND label_name='secret';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew019_p.internal COMPONENT lblbacnew019_a 'INTERNAL', COMPONENT lblbacnew019_s 'RD', COMPONENT lblbacnew019_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew019_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew019_p' AND label_name='internal';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew019_p.public COMPONENT lblbacnew019_a 'PUBLIC', COMPONENT lblbacnew019_s 'RD', COMPONENT lblbacnew019_t 'A1';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew019_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew019_p' AND label_name='public';

-- 37. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew019_p.wide COMPONENT lblbacnew019_a 'SECRET', COMPONENT lblbacnew019_s 'RD','QA', COMPONENT lblbacnew019_t 'ROOT';

-- 38. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew019_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew019_p' AND label_name='wide';

-- 39. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew019_p TO USER root;

-- 40. 创建用例使用的普通用户
CREATE USER lblbacnew019_u 'LbacTest_2026!';

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacnew019_db TO USER lblbacnew019_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacnew019_db TO USER lblbacnew019_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacnew019_db TO USER lblbacnew019_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacnew019_db TO USER lblbacnew019_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacnew019_db TO USER lblbacnew019_u;

-- 46. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacnew019_db TO USER lblbacnew019_u;

-- 47. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacnew019_p;

-- 48. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 49. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew019_p.secret TO USER lblbacnew019_u FOR READ ACCESS;

-- 50. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew019_p.secret TO USER lblbacnew019_u FOR WRITE ACCESS;

-- 51. 使用当前测试账号建立数据库连接
connect lblbacnew019_u/LbacTest_2026!;

-- 52. 切换到表模型 SQL 方言
