-- ALTER POLICY 角色开关失效广播

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbacnew020_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lblbacnew020_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP ROLE lblbacnew020_r;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbacnew020_p FROM USER root;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew020_p.top;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew020_p.secret;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew020_p.internal;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew020_p.public;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbacnew020_p.wide;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbacnew020_p;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew020_a;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew020_s;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbacnew020_t;
<<NULL;

-- 17. 操作步骤: 各 DN 预热 IGNORE Policy；切 USE 后读写；再切回 IGNORE；采集失效广播确认。；预期结果: ALTER POLICY 失效 policy 缓存；后续请求按新角色开关加载标签及豁免；无长期旧结论。；创建本用例隔离的测试数据库
CREATE DATABASE lblbacnew020_db;

-- 18. 切换当前数据库或元数据查询范围
USE lblbacnew020_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew020_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew020_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew020_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew020_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew020_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew020_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbacnew020_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbacnew020_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbacnew020_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbacnew020_p COMPONENTS lblbacnew020_a,lblbacnew020_s,lblbacnew020_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew020_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbacnew020_p';

-- 27. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew020_p TO USER root;

-- 28. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew020_p.top COMPONENT lblbacnew020_a 'TOP', COMPONENT lblbacnew020_s 'RD', COMPONENT lblbacnew020_t 'A1';

-- 29. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew020_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew020_p' AND label_name='top';

-- 30. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew020_p.secret COMPONENT lblbacnew020_a 'SECRET', COMPONENT lblbacnew020_s 'RD', COMPONENT lblbacnew020_t 'A1';

-- 31. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew020_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew020_p' AND label_name='secret';

-- 32. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew020_p.internal COMPONENT lblbacnew020_a 'INTERNAL', COMPONENT lblbacnew020_s 'RD', COMPONENT lblbacnew020_t 'A1';

-- 33. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew020_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew020_p' AND label_name='internal';

-- 34. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew020_p.public COMPONENT lblbacnew020_a 'PUBLIC', COMPONENT lblbacnew020_s 'RD', COMPONENT lblbacnew020_t 'A1';

-- 35. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew020_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew020_p' AND label_name='public';

-- 36. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbacnew020_p.wide COMPONENT lblbacnew020_a 'SECRET', COMPONENT lblbacnew020_s 'RD','QA', COMPONENT lblbacnew020_t 'ROOT';

-- 37. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbacnew020_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbacnew020_p' AND label_name='wide';

-- 38. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbacnew020_p TO USER root;

-- 39. 创建用例使用的普通用户
CREATE USER lblbacnew020_u 'LbacTest_2026!';

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lblbacnew020_db TO USER lblbacnew020_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lblbacnew020_db TO USER lblbacnew020_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lblbacnew020_db TO USER lblbacnew020_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lblbacnew020_db TO USER lblbacnew020_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lblbacnew020_db TO USER lblbacnew020_u;

-- 45. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lblbacnew020_db TO USER lblbacnew020_u;

-- 46. 创建用于验证 LBAC 保护的数据表
CREATE TABLE metrics(device STRING TAG, owner STRING ATTRIBUTE, plain INT32 FIELD, low INT32 FIELD SECURED WITH internal, high INT32 FIELD SECURED WITH secret) SECURITY POLICY lblbacnew020_p;

-- 47. 写入测试数据并验证 LBAC 写入控制
INSERT INTO metrics(time,device,owner,plain,low,high) VALUES(1,'d1','alice',10,20,30);

-- 48. 创建用例使用的角色
CREATE ROLE lblbacnew020_r;

-- 49. 授予或撤销用户的角色
GRANT ROLE lblbacnew020_r TO lblbacnew020_u;

-- 50. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew020_p.secret TO ROLE lblbacnew020_r FOR READ ACCESS;

-- 51. 授予或撤销安全标签访问权限并验证授权行为
GRANT SECURITY LABEL lblbacnew020_p.secret TO ROLE lblbacnew020_r FOR WRITE ACCESS;

-- 52. 修改 LBAC 安全策略并验证策略行为
ALTER SECURITY POLICY lblbacnew020_p IGNORE ROLE AUTHORIZATIONS;

-- 53. 使用当前测试账号建立数据库连接
connect lblbacnew020_u/LbacTest_2026!;

-- 54. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 55. 切换当前数据库或元数据查询范围
USE lblbacnew020_db;

-- 56. 读取受保护数据并验证 LBAC 读权限；本语句预期失败，需核对 SQLSTATE 及错误原因
SELECT high FROM metrics ORDER BY time;
<<SQLSTATE;

-- 57. 写入测试数据并验证 LBAC 写入控制；本语句预期失败，需核对 SQLSTATE 及错误原因
