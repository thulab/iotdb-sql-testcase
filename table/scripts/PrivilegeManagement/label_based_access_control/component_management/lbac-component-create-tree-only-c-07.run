-- 用单一元素创建三类组件

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc07_aa;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc07_as;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc07_at;
<<NULL;

-- 7. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbc07_aa ARRAY ('ONLY');

-- 8. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbc07_aa' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc07_aa';

-- 9. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbc07_as SET ('ONLY');

-- 10. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbc07_as' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc07_as';

-- 11. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbc07_at TREE ('ONLY' ROOT);

-- 12. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbc07_at' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc07_at';

-- 13. 清理本条命名空间；无通配删除；初始化未被忽略。；删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbc07_at;
<<NULL;

-- 14. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbc07_as;
<<NULL;

-- 15. 删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lbc07_aa;

-- 16. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 17. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 18. 结束清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 19. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lbc07_aa;
<<NULL;

-- 20. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lbc07_as;
<<NULL;

-- 21. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lbc07_at;
<<NULL;
