-- ARRAY ADD ELEMENT AFTER

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lblbac009_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lblbac009_p FROM USER root;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac009_p.top;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac009_p.secret;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac009_p.internal;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac009_p.public;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lblbac009_p.wide;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lblbac009_p;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac009_a;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac009_s;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac009_t;
<<NULL;

-- 15. 创建本用例隔离的测试数据库
CREATE DATABASE lblbac009_db;

-- 16. 切换当前数据库或元数据查询范围
USE lblbac009_db;

-- 17. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac009_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 18. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac009_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac009_a';

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac009_s SET ('RD','QA','OPS');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac009_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac009_s';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac009_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lblbac009_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac009_t';

-- 23. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lblbac009_p COMPONENTS lblbac009_a,lblbac009_s,lblbac009_t WITH LBACRULES;

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac009_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lblbac009_p';

-- 25. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac009_p.top COMPONENT lblbac009_a 'TOP', COMPONENT lblbac009_s 'RD', COMPONENT lblbac009_t 'A1';

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac009_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac009_p' AND label_name='top';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac009_p.secret COMPONENT lblbac009_a 'SECRET', COMPONENT lblbac009_s 'RD', COMPONENT lblbac009_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac009_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac009_p' AND label_name='secret';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac009_p.internal COMPONENT lblbac009_a 'INTERNAL', COMPONENT lblbac009_s 'RD', COMPONENT lblbac009_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac009_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac009_p' AND label_name='internal';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac009_p.public COMPONENT lblbac009_a 'PUBLIC', COMPONENT lblbac009_s 'RD', COMPONENT lblbac009_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac009_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac009_p' AND label_name='public';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lblbac009_p.wide COMPONENT lblbac009_a 'SECRET', COMPONENT lblbac009_s 'RD','QA', COMPONENT lblbac009_t 'ROOT';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lblbac009_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lblbac009_p' AND label_name='wide';

-- 35. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lblbac009_p TO USER root;

-- 36. 修改安全标签组件并验证元素操作
ALTER SECURITY LABEL COMPONENT lblbac009_a ADD ELEMENT 'MID' AFTER 'SECRET';

-- 37. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(ordinal)=3 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_component_elements WHERE component_name='lblbac009_a' AND element_value='MID';

