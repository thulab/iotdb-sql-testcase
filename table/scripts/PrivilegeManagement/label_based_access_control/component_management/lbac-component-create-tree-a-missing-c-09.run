-- 创建非法类型或非法 TREE 节点

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc09_a;
<<NULL;

-- 5. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lbc09_a LIST ('A');
<<SQLSTATE;

-- 6. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lbc09_a TREE ('A');
<<SQLSTATE;

-- 7. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lbc09_a TREE ('A' UNDER 'MISSING');
<<SQLSTATE;

-- 8. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 9. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 10. 结束清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 11. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lbc09_a;
<<NULL;
