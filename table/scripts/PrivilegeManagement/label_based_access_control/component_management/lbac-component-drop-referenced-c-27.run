-- u_plain 无 SECURITY 权限

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP DATABASE lbc27_db;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP USER lbc27_u;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
REVOKE EXEMPTION ON RULE ALL FOR lbc27_p FROM USER root;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbc27_p.top;
<<NULL;

-- 8. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbc27_p.secret;
<<NULL;

-- 9. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbc27_p.internal;
<<NULL;

-- 10. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbc27_p.public;
<<NULL;

-- 11. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL lbc27_p.wide;
<<NULL;

-- 12. 前置清理：删除本用例遗留对象
DROP SECURITY POLICY lbc27_p;
<<NULL;

-- 13. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc27_a;
<<NULL;

-- 14. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc27_s;
<<NULL;

-- 15. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc27_t;
<<NULL;

-- 16. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc27new;
<<NULL;

-- 17. 创建本用例隔离的测试数据库
CREATE DATABASE lbc27_db;

-- 18. 切换当前数据库或元数据查询范围
USE lbc27_db;

-- 19. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbc27_a ARRAY ('TOP','SECRET','INTERNAL','PUBLIC');

-- 20. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbc27_a' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc27_a';

-- 21. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbc27_s SET ('RD','QA','OPS');

-- 22. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbc27_s' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc27_s';

-- 23. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lbc27_t TREE ('ROOT' ROOT,'A' UNDER 'ROOT','A1' UNDER 'A','B' UNDER 'ROOT');

-- 24. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_name)='lbc27_t' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc27_t';

-- 25. 创建 LBAC 安全策略并验证规则配置
CREATE SECURITY POLICY lbc27_p COMPONENTS lbc27_a,lbc27_s,lbc27_t WITH LBACRULES;

-- 26. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbc27_p' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_policies WHERE policy_name='lbc27_p';

-- 27. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbc27_p.top COMPONENT lbc27_a 'TOP', COMPONENT lbc27_s 'RD', COMPONENT lbc27_t 'A1';

-- 28. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbc27_p' AND MIN(label_name)='top' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbc27_p' AND label_name='top';

-- 29. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbc27_p.secret COMPONENT lbc27_a 'SECRET', COMPONENT lbc27_s 'RD', COMPONENT lbc27_t 'A1';

-- 30. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbc27_p' AND MIN(label_name)='secret' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbc27_p' AND label_name='secret';

-- 31. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbc27_p.internal COMPONENT lbc27_a 'INTERNAL', COMPONENT lbc27_s 'RD', COMPONENT lbc27_t 'A1';

-- 32. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbc27_p' AND MIN(label_name)='internal' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbc27_p' AND label_name='internal';

-- 33. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbc27_p.public COMPONENT lbc27_a 'PUBLIC', COMPONENT lbc27_s 'RD', COMPONENT lbc27_t 'A1';

-- 34. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbc27_p' AND MIN(label_name)='public' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbc27_p' AND label_name='public';

-- 35. 创建安全标签并验证标签值和组件映射
CREATE SECURITY LABEL lbc27_p.wide COMPONENT lbc27_a 'SECRET', COMPONENT lbc27_s 'RD','QA', COMPONENT lbc27_t 'ROOT';

-- 36. [创建结果断言]：查询元数据并验证对象创建成功
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(policy_name)='lbc27_p' AND MIN(label_name)='wide' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_labels WHERE policy_name='lbc27_p' AND label_name='wide';

-- 37. 授予或撤销 LBAC 规则豁免并验证豁免行为
GRANT EXEMPTION ON RULE ALL FOR lbc27_p TO USER root;

-- 38. 创建用例使用的普通用户
CREATE USER lbc27_u 'LbacTest_2026!';

-- 39. 授予测试用户执行目标操作所需的数据库权限
GRANT SELECT ON DATABASE lbc27_db TO USER lbc27_u;

-- 40. 授予测试用户执行目标操作所需的数据库权限
GRANT INSERT ON DATABASE lbc27_db TO USER lbc27_u;

-- 41. 授予测试用户执行目标操作所需的数据库权限
GRANT DELETE ON DATABASE lbc27_db TO USER lbc27_u;

-- 42. 授予测试用户执行目标操作所需的数据库权限
GRANT ALTER ON DATABASE lbc27_db TO USER lbc27_u;

-- 43. 授予测试用户执行目标操作所需的数据库权限
GRANT CREATE ON DATABASE lbc27_db TO USER lbc27_u;

-- 44. 授予测试用户执行目标操作所需的数据库权限
GRANT DROP ON DATABASE lbc27_db TO USER lbc27_u;

-- 45. 使用当前测试账号建立数据库连接
connect lbc27_u/LbacTest_2026!;

-- 46. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 47. 切换当前数据库或元数据查询范围
USE lbc27_db;

-- 48. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lbc27new SET ('X');
<<SQLSTATE;

-- 49. 修改安全标签组件并验证元素操作；本语句预期失败，需核对 SQLSTATE 及错误原因
ALTER SECURITY LABEL COMPONENT lbc27_a ADD ELEMENT 'X' AFTER 'TOP';
<<SQLSTATE;

-- 50. 设置组件备注并验证元数据；本语句预期失败，需核对 SQLSTATE 及错误原因
COMMENT ON SECURITY LABEL COMPONENT lbc27_a IS 'x';
<<SQLSTATE;

-- 51. 删除安全标签组件并验证引用约束；本语句预期失败，需核对 SQLSTATE 及错误原因
DROP SECURITY LABEL COMPONENT lbc27_a;
<<SQLSTATE;

