-- 创建 TREE 组件成功

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac003_a;
<<NULL;

-- 5. 创建安全标签组件并验证组件定义
CREATE SECURITY LABEL COMPONENT lblbac003_a TREE ('ROOT' ROOT,'A' UNDER 'ROOT');

-- 6. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=1 AND MIN(component_type)='TREE' THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac003_a';

-- 7. 清理本条命名空间；无通配删除；初始化未被忽略。；删除安全标签组件并验证引用约束
DROP SECURITY LABEL COMPONENT lblbac003_a;
<<NULL;

-- 8. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 9. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 10. 结束清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 11. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lblbac003_a;
<<NULL;
