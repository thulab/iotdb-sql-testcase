-- 组件内元素重复

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lblbac005_a0;
<<NULL;

-- 5. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lblbac005_a0 SET ('RD','RD');
<<SQLSTATE;

-- 6. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lblbac005_a0';

-- 7. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 8. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 9. 结束清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 10. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lblbac005_a0;
<<NULL;
