-- 独立 SET 组件使用含保留字符的元素

-- 1. 使用当前测试账号建立数据库连接
connect root/TimechoDB@2021;

-- 2. 切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 3. 前置清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 4. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc06_a0;
<<NULL;

-- 5. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc06_a1;
<<NULL;

-- 6. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc06_a2;
<<NULL;

-- 7. 前置清理：删除本用例遗留对象
DROP SECURITY LABEL COMPONENT lbc06_a3;
<<NULL;

-- 8. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lbc06_a0 SET ('A(B');
<<SQLSTATE;

-- 9. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc06_a0';

-- 10. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lbc06_a1 SET ('A)B');
<<SQLSTATE;

-- 11. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc06_a1';

-- 12. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lbc06_a2 SET ('A,B');
<<SQLSTATE;

-- 13. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc06_a2';

-- 14. 创建安全标签组件并验证组件定义；本语句预期失败，需核对 SQLSTATE 及错误原因
CREATE SECURITY LABEL COMPONENT lbc06_a3 SET ('A:B');
<<SQLSTATE;

-- 15. 断言应返回整数1，否则 CAST 失败；查询 LBAC 元数据并核对断言条件
SELECT CAST(CASE WHEN COUNT(*)=0 THEN '1' ELSE 'LBAC_ASSERT_FAIL' END AS INT32) AS ok FROM information_schema.security_label_components WHERE component_name='lbc06_a3';

-- 16. 结束清理：重新连接管理员账号
connect root/TimechoDB@2021;

-- 17. 结束清理：切换到表模型 SQL 方言
SET SQL_DIALECT=TABLE;

-- 18. 结束清理：切换到元数据空间
USE information_schema;
<<NULL;

-- 19. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lbc06_a0;
<<NULL;

-- 20. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lbc06_a1;
<<NULL;

-- 21. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lbc06_a2;
<<NULL;

-- 22. 结束清理：删除本用例对象
DROP SECURITY LABEL COMPONENT lbc06_a3;
<<NULL;
