// 新设备下新增测点同样补列
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.db2;<<NULL;
create database root.db2;
create timeseries root.db2.dev01.s1 datatype=double;
insert into root.db2.dev01(time,s1) values(1,1.0);
set sql_dialect=table;
drop database db2;<<NULL;
create database db2;
use db2;
create view v_on(dev string tag) with(auto_sync_schema = true) as root.db2.**;
create view v_off(dev string tag) as root.db2.**;
desc v_on;
desc v_off;
set sql_dialect=tree;
insert into root.db2.dev01(time,s2) values(2,2.0);
set sql_dialect=table;
use db2;
desc v_on;
desc v_off;
set sql_dialect=tree;
create timeseries root.db2.dev01.s3 datatype=int32;
insert into root.db2.dev01(time,s3) values(3,3);
create timeseries root.db2.dev02.s1 datatype=double;
insert into root.db2.dev02(time,s1) values(4,4.5);
set sql_dialect=table;
use db2;
desc v_on;
desc v_off;
use db2;
use db2;
desc v_on;
select * from v_on order by time;
use db2;
desc v_off;
select * from v_off order by time;
drop view v_on;<<NULL;
drop view v_off;<<NULL;
drop database db2;<<NULL;
set sql_dialect=tree;
drop database root.db2;<<NULL;
