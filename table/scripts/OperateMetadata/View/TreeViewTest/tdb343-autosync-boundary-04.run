// 补列后按时间排序查询：数据齐全、时间升序
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.dbj;<<NULL;
create database root.dbj;
set sql_dialect=table;
drop database dbj;<<NULL;
create database dbj;
use dbj;
create view v1(dev string tag) with(auto_sync_schema = true) as root.dbj.**;
desc v1;
set sql_dialect=tree;
insert into root.dbj.dev1(time,s1,s2) values(100,1.0,2.0);
insert into root.dbj.dev1(time,s3) values(50,3.0);
set sql_dialect=table;
use dbj;
desc v1;
set sql_dialect=tree;
insert into root.dbj.dev2(time,s9,s9) values(1,1.0,2.0);<<SQLSTATE;
set sql_dialect=table;
use dbj;
desc v1;
set sql_dialect=tree;
insert into root.dbj.dev3(time,s4) values(1,1.0),(2,2.0);
set sql_dialect=table;
use dbj;
desc v1;
select * from v1 order by time;
use dbj;
use dbj;
desc v1;
select * from v1 order by time;
drop view v1;<<NULL;
drop database dbj;<<NULL;
set sql_dialect=tree;
drop database root.dbj;<<NULL;
