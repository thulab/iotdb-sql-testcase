// 删除后向已有序列写入数据：不触发补列，列不会自己回来
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.dct;<<NULL;
create database root.dct;
create timeseries root.dct.dev01.s1 datatype=double;
create timeseries root.dct.dev01.s2 datatype=double;
insert into root.dct.dev01(time,s1,s2) values(1,1.0,2.0);
set sql_dialect=table;
drop database dct;<<NULL;
create database dct;
use dct;
create view v1(dev string tag) with(auto_sync_schema = true) as root.dct.**;
desc v1;
alter view v1 drop column s1;
desc v1;
select * from v1 order by time;
set sql_dialect=tree;
insert into root.dct.dev01(time,s2) values(2,20.0);
set sql_dialect=table;
use dct;
desc v1;
use dct;
use dct;
desc v1;
select * from v1 order by time;
drop view v1;<<NULL;
drop database dct;<<NULL;
set sql_dialect=tree;
drop database root.dct;<<NULL;
