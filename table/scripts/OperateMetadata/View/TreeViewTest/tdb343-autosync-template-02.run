// 模板扩展新增测点：自动补列
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.db6;<<NULL;
drop schema template t_auto;<<NULL;
create database root.db6;
create device template t_auto(a float, b double);
set device template t_auto to root.db6.p1;
create timeseries using device template on root.db6.p1.dev01;
insert into root.db6.p1.dev01(time,a,b) values(1,1.5,2.5);
set sql_dialect=table;
drop database db6;<<NULL;
create database db6;
use db6;
create view v1(dev string tag) with(auto_sync_schema = true) as root.db6.p1.**;
desc v1;
set sql_dialect=tree;
create timeseries using device template on root.db6.p1.dev02;
insert into root.db6.p1.dev02(time,a) values(2,3.5);
set sql_dialect=table;
use db6;
desc v1;
select * from v1 order by time;
set sql_dialect=tree;
alter schema template t_auto add (c int64);
insert into root.db6.p1.dev02(time,c) values(3,123);
set sql_dialect=table;
use db6;
desc v1;
select * from v1 order by time;
use db6;
use db6;
desc v1;
select * from v1 order by time;
drop view v1;<<NULL;
drop database db6;<<NULL;
set sql_dialect=tree;
drop database root.db6;<<NULL;
drop schema template t_auto;<<NULL;
