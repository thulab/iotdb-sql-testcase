// 新增测点名带连字符：自动补列，列名为 `x-y`
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.dba;<<NULL;
create database root.dba;
create timeseries root.dba.dev01.`s-1` datatype=double;
create timeseries root.dba.dev01.`s.1` datatype=double;
create timeseries root.dba.dev01.`a b` datatype=double;
create timeseries root.dba.dev01.`温度` datatype=double;
create timeseries root.dba.dev01.`S_1` datatype=double;
insert into root.dba.dev01(time,`s-1`,`温度`) values(1,1.0,2.0);
set sql_dialect=table;
drop database dba;<<NULL;
create database dba;
use dba;
create view v1(dev string tag) with(auto_sync_schema = true) as root.dba.**;
<<NULL;
desc v1;
<<NULL;
select * from v1;
<<NULL;
set sql_dialect=tree;
create timeseries root.dba.dev01.`x-y` datatype=double;
insert into root.dba.dev01(time,`x-y`) values(2,3.0);
set sql_dialect=table;
use dba;
use dba;
desc v1;
select * from v1 order by time;
drop view v1;
<<NULL;
