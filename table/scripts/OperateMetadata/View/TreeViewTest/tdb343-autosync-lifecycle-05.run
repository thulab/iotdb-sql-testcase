// 多个视图同时命中同一新增测点
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.db7;<<NULL;
create database root.db7;
create timeseries root.db7.dev01.s1 datatype=double;
insert into root.db7.dev01(time,s1) values(1,1.0);
set sql_dialect=table;
drop database db7;<<NULL;
create database db7;
use db7;
create view v1(dev string tag) with(auto_sync_schema = true) as root.db7.**;
desc v1;
alter view v1 rename to v2;
set sql_dialect=tree;
create timeseries root.db7.dev01.d datatype=double;
insert into root.db7.dev01(time,d) values(2,4.0);
set sql_dialect=table;
use db7;
desc v2;
set sql_dialect=tree;
delete timeseries root.db7.dev01.d;
set sql_dialect=table;
use db7;
desc v2;
select * from v2 order by time;
set sql_dialect=tree;
create timeseries root.db7.dev01.d datatype=double;
insert into root.db7.dev01(time,d) values(3,6.0);
set sql_dialect=table;
use db7;
desc v2;
select * from v2 order by time;
create view r1(region string tag, dev string tag) restrict with(auto_sync_schema = true) as root.db7.**;
desc r1;
set sql_dialect=tree;
create timeseries root.db7.dev01.e datatype=double;
set sql_dialect=table;
use db7;
desc r1;
create view v3(dev string tag) with(auto_sync_schema = true) as root.db7.**;
set sql_dialect=tree;
create timeseries root.db7.dev01.f datatype=double;
set sql_dialect=table;
use db7;
desc v2;
desc v3;
use db7;
use db7;
desc v2;
select * from v2 order by time;
use db7;
desc r1;
select * from r1 order by time;
use db7;
desc v3;
select * from v3 order by time;
drop view v3;<<NULL;
drop view r1;<<NULL;
drop database db7;<<NULL;
set sql_dialect=tree;
drop database root.db7;<<NULL;
