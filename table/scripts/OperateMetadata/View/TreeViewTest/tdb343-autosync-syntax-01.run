// 不写 WITH：属性缺省为 false，show create view 不显示该属性
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.db1;<<NULL;
create database root.db1;
create timeseries root.db1.dev01.s1 datatype=double;
create timeseries root.db1.dev01.s2 datatype=double;
set sql_dialect=table;
drop database db1;<<NULL;
create database db1;
use db1;
create view v_default(dev string tag) as root.db1.**;
desc v_default;
show create view v_default;
use db1;
use db1;
desc v_default;
select * from v_default order by time;
drop view v_default;<<NULL;
drop view v_false;<<NULL;
drop view v_true;<<NULL;
drop view v_restrict;<<NULL;
drop table t_base2;<<NULL;
drop database db1;<<NULL;
set sql_dialect=tree;
drop database root.db1;<<NULL;
