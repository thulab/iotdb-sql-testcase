// 只支持树转表视图：base table 带该属性报 701
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.db1;<<NULL;
create database root.db1;
create timeseries root.db1.dev01.s1 datatype=double;
create timeseries root.db1.dev01.s2 datatype=double;
set sql_dialect=table;
drop database db1;<<NULL;
create database db1;
use db1;
create view v_default(dev string tag) as root.db1.**;
desc v_default;
show create view v_default;
create view v_false(dev string tag) with(auto_sync_schema = false) as root.db1.**;
desc v_false;
show create view v_false;
create view v_true(dev string tag) with(auto_sync_schema = true) as root.db1.**;
desc v_true;
show create view v_true;
create view v_bad_long(dev string tag) with(auto_sync_schema = 1) as root.db1.**;<<SQLSTATE;
create view v_bad_str(dev string tag) with(auto_sync_schema = 'abc') as root.db1.**;<<SQLSTATE;
create table t_base(id string tag, v double) with(auto_sync_schema = true);<<SQLSTATE;
create table t_base2(id string tag, v double);
use db1;
use db1;
desc v_default;
select * from v_default order by time;
use db1;
desc v_false;
select * from v_false order by time;
use db1;
desc v_true;
select * from v_true order by time;
drop view v_default;<<NULL;
drop view v_false;<<NULL;
drop view v_true;<<NULL;
drop view v_restrict;<<NULL;
drop table t_base2;<<NULL;
drop database db1;<<NULL;
set sql_dialect=tree;
drop database root.db1;<<NULL;
