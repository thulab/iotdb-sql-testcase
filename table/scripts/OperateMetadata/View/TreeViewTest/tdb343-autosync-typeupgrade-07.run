// 显式 DOUBLE 列 + 新增 INT64 同名测点：兼容提升，四条都能读
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.dbp;<<NULL;
create database root.dbp;
create timeseries root.dbp.dev01.s1 datatype=int32;
create timeseries root.dbp.dev02.s1 datatype=int64;
insert into root.dbp.dev01(time,s1) values(1,11);
insert into root.dbp.dev02(time,s1) values(2,22);
set sql_dialect=table;
drop database dbp;<<NULL;
create database dbp;
use dbp;
create view v_infer_i(dev string tag, s1 field) with(auto_sync_schema = true) as root.dbp.**;<<SQLSTATE;
create view v_i64(dev string tag, s1 int64 field) with(auto_sync_schema = true) as root.dbp.**;
desc v_i64;
select * from v_i64 order by time;
set sql_dialect=tree;
drop database root.dbq2;<<NULL;
create database root.dbq2;
create timeseries root.dbq2.dev01.s1 datatype=int32;
create timeseries root.dbq2.dev02.s1 datatype=double;
insert into root.dbq2.dev01(time,s1) values(1,11);
insert into root.dbq2.dev02(time,s1) values(2,2.5);
set sql_dialect=table;
drop database dbq2;<<NULL;
create database dbq2;
use dbq2;
create view v_infer_d(dev string tag, s1 field) with(auto_sync_schema = true) as root.dbq2.**;<<SQLSTATE;
create view v_dbl(dev string tag, s1 double field) with(auto_sync_schema = true) as root.dbq2.**;
desc v_dbl;
select * from v_dbl order by time;
set sql_dialect=tree;
drop database root.dbr2;<<NULL;
create database root.dbr2;
create timeseries root.dbr2.dev01.s1 datatype=int32;
insert into root.dbr2.dev01(time,s1) values(1,11);
set sql_dialect=table;
drop database dbr2;<<NULL;
create database dbr2;
use dbr2;
create view v_widen(dev string tag, s1 int32 field) with(auto_sync_schema = true) as root.dbr2.**;
desc v_widen;
set sql_dialect=tree;
create timeseries root.dbr2.dev02.s1 datatype=int64;
insert into root.dbr2.dev02(time,s1) values(2,22);
set sql_dialect=table;
use dbr2;
desc v_widen;
select * from v_widen order by time;
set sql_dialect=tree;
create timeseries root.dbr2.dev03.s1 datatype=int32;
insert into root.dbr2.dev03(time,s1) values(3,33);
set sql_dialect=table;
use dbr2;
desc v_widen;
select * from v_widen order by time;
set sql_dialect=tree;
create timeseries root.dbr2.dev04.s1 datatype=int64;
insert into root.dbr2.dev04(time,s1) values(4,44);
set sql_dialect=table;
use dbr2;
create view v_dbl2(dev string tag, s1 double field) with(auto_sync_schema = true) as root.dbr2.**;
desc v_dbl2;
select * from v_dbl2 order by time;
use dbr2;
use dbp;
desc v_i64;
select * from v_i64 order by time;
use dbq2;
desc v_dbl;
select * from v_dbl order by time;
use dbr2;
desc v_widen;
select * from v_widen order by time;
use dbr2;
desc v_dbl2;
select * from v_dbl2 order by time;
drop view v_infer_i;<<NULL;
drop view v_i64;<<NULL;
drop view v_infer_d;<<NULL;
drop view v_dbl;<<NULL;
drop view v_widen;<<NULL;
drop view v_dbl2;<<NULL;
drop database dbp;<<NULL;
drop database dbq2;<<NULL;
drop database dbr2;<<NULL;
set sql_dialect=tree;
drop database root.dbp;<<NULL;
drop database root.dbq2;<<NULL;
drop database root.dbr2;<<NULL;
