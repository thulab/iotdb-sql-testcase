// 时间戳倒序插入新测点：补列与时间顺序无关，仍然生效
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.dbj;<<NULL;
create database root.dbj;
set sql_dialect=table;
drop database dbj;<<NULL;
create database dbj;
use dbj;
create view v1(dev string tag) with(auto_sync_schema = true) as root.dbj.**;
desc v1;
set sql_dialect=tree;
insert into root.dbj.dev1(time,s1,s2) values(100,1.0,2.0);
insert into root.dbj.dev1(time,s3) values(50,3.0);
set sql_dialect=table;
use dbj;
desc v1;
use dbj;
use dbj;
desc v1;
select * from v1 order by time;
drop view v1;
<<NULL;
drop database dbj;
<<NULL;
set sql_dialect=tree;
<<NULL;
drop database root.dbj;
<<NULL;
