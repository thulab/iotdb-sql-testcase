// 显式声明 TEXT 列：同样能读出这七种类型
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.dbs1;<<NULL;
create database root.dbs1;
create timeseries root.dbs1.dev01.s1 datatype=int32;
create timeseries root.dbs1.dev02.s1 datatype=int64;
create timeseries root.dbs1.dev03.s1 datatype=float;
create timeseries root.dbs1.dev04.s1 datatype=double;
create timeseries root.dbs1.dev05.s1 datatype=boolean;
create timeseries root.dbs1.dev06.s1 datatype=text;
create timeseries root.dbs1.dev07.s1 datatype=timestamp;
insert into root.dbs1.dev01(time,s1) values(1,77);
insert into root.dbs1.dev02(time,s1) values(2,88);
insert into root.dbs1.dev03(time,s1) values(3,1.5);
insert into root.dbs1.dev04(time,s1) values(4,2.5);
insert into root.dbs1.dev05(time,s1) values(5,true);
insert into root.dbs1.dev06(time,s1) values(6,'abc');
insert into root.dbs1.dev07(time,s1) values(7,1000);
set sql_dialect=table;
drop database dbs1;<<NULL;
create database dbs1;
use dbs1;
create view v_str(dev string tag, s1 string field) with(auto_sync_schema = true) as root.dbs1.**;
desc v_str;
select * from v_str order by time;
create view v_txt(dev string tag, s1 text field) with(auto_sync_schema = true) as root.dbs1.**;
desc v_txt;
select * from v_txt order by time;
use dbs1;
use dbs1;
desc v_str;
select * from v_str order by time;
use dbs1;
desc v_txt;
select * from v_txt order by time;
drop view v_str;<<NULL;
drop view v_txt;<<NULL;
drop view v_dbl;<<NULL;
drop view v_auto;<<NULL;
drop database dbs1;<<NULL;
set sql_dialect=tree;
drop database root.dbs1;<<NULL;
