// 补列结果与数据：开启的视图有新列且能查到值，未开启的视图只有 time 与 tag
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.dbi;<<NULL;
drop database root.dbo;<<NULL;
create database root.dbi;
create database root.dbo;
set sql_dialect=table;
drop database dbi;<<NULL;
create database dbi;
use dbi;
create view v_on(dev string tag) with(auto_sync_schema = true) as root.dbi.**;
create view v_off(dev string tag) as root.dbi.**;
desc v_on;
desc v_off;
set sql_dialect=tree;
insert into root.dbi.devNew(time,a1,a2) values(1,1.0,2.0);
set sql_dialect=table;
use dbi;
desc v_on;
desc v_off;
set sql_dialect=tree;
insert into root.dbi.devNew(time,b1) values(2,3);
insert into root.dbi.devNew2(time,c1) values(3,'txt');
insert into root.dbo.devOut(time,z1) values(4,1.0);
set sql_dialect=table;
use dbi;
desc v_on;
desc v_off;
select * from v_on order by time;
use dbi;
use dbi;
desc v_on;
select * from v_on order by time;
use dbi;
desc v_off;
select * from v_off order by time;
drop view v_on;<<NULL;
drop view v_off;<<NULL;
drop database dbi;<<NULL;
drop database dbo;<<NULL;
set sql_dialect=tree;
drop database root.dbi;<<NULL;
drop database root.dbo;<<NULL;
