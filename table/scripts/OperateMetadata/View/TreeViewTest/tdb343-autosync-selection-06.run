// 分段对照：再新增小写 s1(DOUBLE)，int32 与 double 同时出现在 DOUBLE 列
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.dbs;<<NULL;
create database root.dbs;
create timeseries root.dbs.dev01.S1 datatype=double;
create timeseries root.dbs.dev02.s1 datatype=int32;
insert into root.dbs.dev01(time,S1) values(1,3.14);
insert into root.dbs.dev02(time,s1) values(2,77);
set sql_dialect=table;
drop database dbs;<<NULL;
create database dbs;
use dbs;
create view v_sel(dev string tag, s1 double field) with(auto_sync_schema = true) as root.dbs.**;
desc v_sel;
select * from v_sel order by time;
set sql_dialect=tree;
drop database root.dbt;<<NULL;
create database root.dbt;
create timeseries root.dbt.dev01.S1 datatype=double;
insert into root.dbt.dev01(time,S1) values(1,3.14);
set sql_dialect=table;
drop database dbt;<<NULL;
create database dbt;
use dbt;
create view v_upper(dev string tag, s1 double field) with(auto_sync_schema = true) as root.dbt.**;
desc v_upper;
select * from v_upper order by time;
set sql_dialect=tree;
drop database root.dbu;<<NULL;
create database root.dbu;
create timeseries root.dbu.dev02.s1 datatype=int32;
insert into root.dbu.dev02(time,s1) values(2,77);
set sql_dialect=table;
drop database dbu;<<NULL;
create database dbu;
use dbu;
create view v_lower(dev string tag, s1 double field) with(auto_sync_schema = true) as root.dbu.**;
desc v_lower;
select * from v_lower order by time;
set sql_dialect=tree;
drop database root.dbv;<<NULL;
create database root.dbv;
create timeseries root.dbv.dev01.S1 datatype=double;
insert into root.dbv.dev01(time,S1) values(20000,3.14);
set sql_dialect=table;
drop database dbv;<<NULL;
create database dbv;
use dbv;
create view v_stage(dev string tag, s1 double field) with(auto_sync_schema = true) as root.dbv.**;
desc v_stage;
select * from v_stage order by time;
set sql_dialect=tree;
create timeseries root.dbv.dev02.s1 datatype=int32;
insert into root.dbv.dev02(time,s1) values(2,77);
set sql_dialect=table;
use dbv;
desc v_stage;
select * from v_stage order by time;
set sql_dialect=tree;
create timeseries root.dbv.dev03.s1 datatype=double;
insert into root.dbv.dev03(time,s1) values(30000,4.44);
set sql_dialect=table;
use dbv;
desc v_stage;
select * from v_stage order by time;
use dbv;
use dbs;
desc v_sel;
select * from v_sel order by time;
use dbt;
desc v_upper;
select * from v_upper order by time;
use dbu;
desc v_lower;
select * from v_lower order by time;
use dbv;
desc v_stage;
select * from v_stage order by time;
drop view v_sel;<<NULL;
drop view v_upper;<<NULL;
drop view v_lower;<<NULL;
drop view v_stage;<<NULL;
drop database dbs;<<NULL;
drop database dbt;<<NULL;
drop database dbu;<<NULL;
drop database dbv;<<NULL;
set sql_dialect=tree;
drop database root.dbs;<<NULL;
drop database root.dbt;<<NULL;
drop database root.dbu;<<NULL;
drop database root.dbv;<<NULL;
