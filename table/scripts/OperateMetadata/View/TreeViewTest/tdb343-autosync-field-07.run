// 只写列名 + FIELD 类别、不写类型，且 prefixPath 下只有一种类型：可推断，不报错
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.db5;<<NULL;
create database root.db5;
create timeseries root.db5.dev01.s1 datatype=double;
create timeseries root.db5.dev02.s1 datatype=int32;
insert into root.db5.dev01(time,s1) values(1,1.5);
insert into root.db5.dev02(time,s1) values(2,77);
set sql_dialect=table;
drop database db5;<<NULL;
create database db5;
use db5;
create view f_double(dev string tag, s1 double field) with(auto_sync_schema = true) as root.db5.**;
<<NULL;
desc f_double;
<<NULL;
select * from f_double order by time;
<<NULL;
create view f_int(dev string tag, s1 int32 field) with(auto_sync_schema = true) as root.db5.**;
<<NULL;
desc f_int;
<<NULL;
select * from f_int order by time;
<<NULL;
create view f_float(dev string tag, s1 float field) with(auto_sync_schema = true) as root.db5.**;
<<NULL;
desc f_float;
<<NULL;
select * from f_float order by time;
<<NULL;
create view f_notype(dev string tag, s1 field) with(auto_sync_schema = true) as root.db5.**;
<<NULL;
create view f_from(dev string tag, s1 double field from s1) with(auto_sync_schema = true) as root.db5.**;
<<NULL;
desc f_from;
<<NULL;
create view f_bare(dev string tag, s1) with(auto_sync_schema = true) as root.db5.**;
<<NULL;
