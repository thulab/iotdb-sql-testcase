set sql_dialect=table;
drop database db5b;<<NULL;
create database db5b;
use db5b;
create view f_infer(dev string tag, s1 field) with(auto_sync_schema = true) as root.db5b.**;
desc f_infer;
select * from f_infer order by time;
use db5b;
use db5;
desc f_double;
select * from f_double order by time;
use db5;
