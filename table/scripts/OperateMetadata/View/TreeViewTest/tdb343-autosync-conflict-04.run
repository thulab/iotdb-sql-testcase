// 全新测点：新增列，类型为 FLOAT
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.db3;<<NULL;
create database root.db3;
create timeseries root.db3.dev01.S1 datatype=double;
create timeseries root.db3.dev01.s2 datatype=double;
insert into root.db3.dev01(time,S1,s2) values(1,1.0,2.0);
set sql_dialect=table;
drop database db3;<<NULL;
create database db3;
use db3;
create view v1(dev string tag) with(auto_sync_schema = true) as root.db3.**;
desc v1;
set sql_dialect=tree;
<<NULL;
create timeseries root.db3.dev02.S1 datatype=double;
<<NULL;
insert into root.db3.dev02(time,S1) values(2,11.0);
<<NULL;
create timeseries root.db3.dev03.s1 datatype=double;
<<NULL;
insert into root.db3.dev03(time,s1) values(3,33.0);
<<NULL;
create timeseries root.db3.dev04.s2 datatype=int32;
<<NULL;
insert into root.db3.dev04(time,s2) values(4,44);
<<NULL;
create timeseries root.db3.dev05.s3 datatype=float;
insert into root.db3.dev05(time,s3) values(5,5.5);
set sql_dialect=table;
use db3;
desc v1;
select * from v1 order by time;
select dev,s1,s2,s3 from v1 order by dev;
use db3;
use db3;
desc v1;
select * from v1 order by time;
drop view v1;
<<NULL;
drop database db3;
<<NULL;
set sql_dialect=tree;
<<NULL;
drop database root.db3;
<<NULL;
