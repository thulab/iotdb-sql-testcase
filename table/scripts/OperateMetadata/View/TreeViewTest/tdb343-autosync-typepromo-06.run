// 对照：前缀里根本没有任何 DOUBLE 序列，仅声明 s1 为 DOUBLE 列，int32 数据仍被读出
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.dbc;<<NULL;
create database root.dbc;
create timeseries root.dbc.dev01.s1 datatype=double;
create timeseries root.dbc.dev02.s1 datatype=int32;
create timeseries root.dbc.dev03.s1 datatype=int64;
create timeseries root.dbc.dev04.s1 datatype=float;
create timeseries root.dbc.dev05.s1 datatype=text;
create timeseries root.dbc.dev06.s1 datatype=boolean;
insert into root.dbc.dev01(time,s1) values(1,1.0);
insert into root.dbc.dev02(time,s1) values(2,44);
insert into root.dbc.dev03(time,s1) values(3,55);
insert into root.dbc.dev04(time,s1) values(4,6.5);
insert into root.dbc.dev05(time,s1) values(5,'abc');
insert into root.dbc.dev06(time,s1) values(6,true);
set sql_dialect=table;
drop database dbc;<<NULL;
create database dbc;
use dbc;
create view c_double(dev string tag, s1 double field) with(auto_sync_schema = true) as root.dbc.**;
desc c_double;
select * from c_double order by time;
create view c_int64(dev string tag, s1 int64 field) with(auto_sync_schema = true) as root.dbc.**;
desc c_int64;
select * from c_int64 order by time;
create view c_float(dev string tag, s1 float field) with(auto_sync_schema = true) as root.dbc.**;
desc c_float;
select * from c_float order by time;
create view c_int32(dev string tag, s1 int32 field) with(auto_sync_schema = true) as root.dbc.**;
desc c_int32;
select * from c_int32 order by time;
set sql_dialect=tree;
drop database root.dbd;<<NULL;
create database root.dbd;
create timeseries root.dbd.dev01.s1 datatype=double;
insert into root.dbd.dev01(time,s1) values(1,1.0);
set sql_dialect=table;
drop database dbd;<<NULL;
create database dbd;
use dbd;
create view v_auto(dev string tag) with(auto_sync_schema = true) as root.dbd.**;
desc v_auto;
set sql_dialect=tree;
create timeseries root.dbd.dev02.s1 datatype=int32;
insert into root.dbd.dev02(time,s1) values(2,44);
set sql_dialect=table;
use dbd;
desc v_auto;
select * from v_auto order by time;
set sql_dialect=tree;
drop database root.dbe;<<NULL;
create database root.dbe;
create timeseries root.dbe.dev02.s1 datatype=int32;
insert into root.dbe.dev02(time,s1) values(2,77);
set sql_dialect=table;
drop database dbe;<<NULL;
create database dbe;
use dbe;
create view f_only_int(dev string tag, s1 double field) with(auto_sync_schema = true) as root.dbe.**;
desc f_only_int;
select * from f_only_int order by time;
use dbe;
use dbc;
desc c_double;
select * from c_double order by time;
use dbc;
desc c_int64;
select * from c_int64 order by time;
use dbc;
desc c_float;
select * from c_float order by time;
use dbc;
desc c_int32;
select * from c_int32 order by time;
drop view c_double;<<NULL;
drop view c_int64;<<NULL;
drop view c_float;<<NULL;
drop view c_int32;<<NULL;
drop view v_auto;<<NULL;
drop view f_only_int;<<NULL;
drop database dbc;<<NULL;
drop database dbd;<<NULL;
drop database dbe;<<NULL;
set sql_dialect=tree;
drop database root.dbc;<<NULL;
drop database root.dbd;<<NULL;
drop database root.dbe;<<NULL;
drop database root.dbf;<<NULL;
