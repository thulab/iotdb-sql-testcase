// 开启后新增测点自动补列
connect root/TimechoDB@2021;
set sql_dialect=tree;
drop database root.db8;<<NULL;
create database root.db8;
create timeseries root.db8.dev01.s1 datatype=double;
insert into root.db8.dev01(time,s1) values(1,1.0);
set sql_dialect=table;
drop database db8;<<NULL;
create database db8;
use db8;
create view v1(dev string tag) with(auto_sync_schema = true) as root.db8.**;
desc v1;
set sql_dialect=tree;
create timeseries root.db8.dev01.s2 datatype=double;
insert into root.db8.dev01(time,s2) values(2,2.0);
set sql_dialect=table;
use db8;
desc v1;
use db8;
use db8;
desc v1;
select * from v1 order by time;
drop view v1;<<NULL;
drop database db8;<<NULL;
set sql_dialect=tree;
drop database root.db8;<<NULL;
