insert into sensor_data(time,device_id,color,value) values (2,'d1','red',2);
insert into sensor_data(time,device_id,color,value) values (3,'d1','red',3);
insert into sensor_data(time,device_id,color,value) values (4,'d1','red',4);
insert into sensor_data(time,device_id,color,value) values (1,'d2','blue',5);
select count(*) as before_count from sensor_data;
select * from sensor_data order by device_id, time;
delete from sensor_data where color = 'red' AND time = 2;
select count(*) as after_count from sensor_data;
flush;
select count(*) as after_flush_count from sensor_data;
select * from sensor_data order by device_id, time;

