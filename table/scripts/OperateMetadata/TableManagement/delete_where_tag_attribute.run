  (1,'d2','north','red','large','B',21.0,'ok'),
  (2,'d2','north','red','large','B',22.0,'ok'),
  (3,'d2','north','red','large','B',23.0,'warn'),
  (4,'d2','north','red','large','B',24.0,'ok'),
