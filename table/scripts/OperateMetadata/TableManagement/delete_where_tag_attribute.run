<<SQLSTATE;

select count(*) as after_ad_limit_006 from sensor_data;
select count(*) as time_999_rows_after_ad_limit_006
from sensor_data
where time = 999;
-- Expected under the device-count interpretation: SQLSTATE, total remains 1001,
-- and the single time=999 row remains. If implementation uses Time to narrow
-- the device query, this case is a requirement clarification point.


-- 8.7 Filter out and delete all results based on attribute values
drop table sensor_data;
create table sensor_data
(
    device_id STRING TAG,
    size STRING ATTRIBUTE,
    value INT32 FIELD
);
insert into sensor_data(time, device_id, size, value) values(1, 'd1', 'small', 1);
insert into sensor_data(time, device_id, size, value) values(2, 'd1', 'small', 2);
insert into sensor_data(time, device_id, size, value) values(3, 'd1', 'small', 3);
insert into sensor_data(time, device_id, size, value) values(4, 'd1', 'small', 4);
insert into sensor_data(time, device_id, size, value) values(1, 'd6', 'medium', 6);
insert into sensor_data(time, device_id, size, value) values(2, 'd6', 'medium', 7);
insert into sensor_data(time, device_id, size, value) values(3, 'd6', 'medium', 8);
insert into sensor_data(time, device_id, size, value) values(4, 'd6', 'medium', 9);
select count(*) as before_result from sensor_data;
delete from sensor_data where size = 'medium';
select count(*) as after_delete_result from sensor_data;
select * from sensor_data order by device_id, time;

--8.8 Filter out and delete data based on two tags and one attribute
drop table sensor_data;
create table sensor_data
(
    device_id STRING TAG,
    site STRING TAG,
    color STRING ATTRIBUTE,
    value INT32 FIELD
);
insert into sensor_data(time, device_id, site, color, value) values(4, 'd4', 'north', 'blue', 44);
insert into sensor_data(time, device_id, site, color, value) values(3, 'd4', 'north', 'blue', 43);
insert into sensor_data(time, device_id, site, color, value) values(4, 'd3', 'south', 'blue', 34);
select count(*) as before_result from sensor_data;
delete from sensor_data where device_id = 'd4' and site = 'north' and color = 'blue' and time = 4;
select count(*) as after_result from sensor_data;
select * from sensor_data order by device_id, time;

--8.9 VALID testcases
-- AD-VALID-01
create table valid_injection
(
    device_id STRING TAG,
    color STRING ATTRIBUTE,
    value INT32 FIELD
);
insert into valid_injection(time, device_id, color, value) values(1, 'inj_red', 'red', 1);
insert into valid_injection(time, device_id, color, value) values(1, 'inj_blue', 'blue', 2);
select count(*) as before_ad_valid from valid_injection;
delete from valid_injection where color = 'red'' OR ''1''=''1';
select count(*) as after_ad_valid from valid_injection;
select * from valid_injection order by device_id, time;

-- AD-VALID-02
create table valid_special_string
(
    device_id STRING TAG,
    attr1 STRING ATTRIBUTE,
    value INT32 FIELD
);
insert into valid_special_string(time, device_id, attr1, value) values(1, 'sp1', '华北 一区', 1);
insert into valid_special_string(time, device_id, attr1, value) values(1, 'sp2', 'O''Reilly', 2);
insert into valid_special_string(time, device_id, attr1, value) values(1, 'sp3', '普通', 3);
select count(*) as before_ad_valid from valid_special_string;
delete from valid_special_string where attr1 = '华北 一区';
delete from valid_special_string where attr1 = 'O''Reilly';
select count(*) as after_ad_valid from valid_special_string;
select * from valid_special_string order by device_id, time;

-- AD-VALID-03: quoted Attribute identifier
create table quoted_attr
(
    device_id STRING TAG,
    "group" STRING ATTRIBUTE,
    value INT32 FIELD
);
insert into quoted_attr(time, device_id, "group", value) values(1, 'q1', 'g1', 1);
insert into quoted_attr(time, device_id, "group", value) values(1, 'q2', 'g2', 2);
select count(*) as before_ad_valid from quoted_attr;
delete from quoted_attr where "group" = 'g1';
select count(*) as after_ad_valid from quoted_attr;
select * from quoted_attr order by device_id, time;

--9.Users with DELETE permission can perform attribute deletion
drop table sensor_data;
create table sensor_data (
  device_id STRING TAG,
  site STRING TAG,
  color STRING ATTRIBUTE,
  size STRING ATTRIBUTE,
  zone STRING ATTRIBUTE,
  temp DOUBLE FIELD,
  status STRING FIELD
);
