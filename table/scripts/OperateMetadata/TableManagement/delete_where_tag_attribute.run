  (2,'d3','south','blue','small',NULL,32.0,'ok'),
  (3,'d3','south','blue','small',NULL,33.0,'warn'),
  (4,'d3','south','blue','small',NULL,34.0,'ok'),
  (1,'d4','north','blue','small','A',41.0,'ok'),
  (2,'d4','north','blue','small','A',42.0,'ok'),
  (3,'d4','north','blue','small','A',43.0,'warn'),
  (4,'d4','north','blue','small','A',44.0,'ok'),
  (1,'d5','south',NULL,'large','C',51.0,'ok'),
  (2,'d5','south',NULL,'large','C',52.0,'ok'),
  (3,'d5','south',NULL,'large','C',53.0,'warn'),
  (4,'d5','south',NULL,'large','C',54.0,'ok'),
  (1,'d6','east','white','medium','D',61.0,'ok'),
  (2,'d6','east','white','medium','D',62.0,'ok'),
