-- DELETE FROM ... WHERE Time + Tag + Attribute SQL test suite
-- Uses the same six-device, 24-row sensor_data baseline as the Excel test cases.

connect root/TimechoDB@2021;

-- 0. Clean up data from a previous run
drop database delete_from_where_test_db;
<<NULL;
drop user user_1;
<<NULL;
drop user user_2;
<<NULL;

-- 1. Create database, schema, and baseline data
create database delete_from_where_test_db;
use delete_from_where_test_db;

create table sensor_data
(
    device_id STRING TAG,
    site STRING TAG,
    color STRING ATTRIBUTE,
    size STRING ATTRIBUTE,
    zone STRING ATTRIBUTE,
    temp DOUBLE FIELD,
    status STRING FIELD
);

show tables;
desc sensor_data;

insert into sensor_data(time, device_id, site, color, size, zone, temp, status) values(1, 'd1', 'north', 'red',   'small',  'A', 11.0, 'ok');
