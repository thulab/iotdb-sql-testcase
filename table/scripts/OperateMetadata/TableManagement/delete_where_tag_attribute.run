create user user_1 'Pass@123456789';
create user user_2 'Pass@123456789';
list user;
grant select, delete on table sensor_data to user user_1;
grant select on table sensor_data to user user_2;

list privileges of user user_1;
list privileges of user user_2;

-- Users with SELECT and DELETE permissions can perform query and delete operations
connect user_1/Pass@123456789;
show current_user;
list privileges of user user_1;
show databases;
use delete_from_where_test_db;
--before result: 24
select * from sensor_data order by device_id, time;

delete from sensor_data where color = 'red';
--after result: 16
select * from sensor_data order by device_id, time;

