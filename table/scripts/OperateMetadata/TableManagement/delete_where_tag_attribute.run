-- 7.1 Attribute must be the left operand
delete from sensor_data where 'red' = color;
<<SQLSTATE;

-- 7.2 Attribute expressions are unsupported
delete from sensor_data where lower(color) = 'red';
<<SQLSTATE;

delete from sensor_data where color || '_x' = 'red_x';
<<SQLSTATE;

-- 7.3 Right value must be a string constant
delete from sensor_data where color = 1;
<<SQLSTATE;

delete from sensor_data where color = true;
<<SQLSTATE;

delete from sensor_data where color = size;
<<SQLSTATE;

delete from sensor_data where color in ('red', 1);
<<SQLSTATE;

-- 7.4 Operators outside the requirement are rejected
delete from sensor_data where zone between 'A' and 'C';
<<SQLSTATE;

delete from sensor_data where color regexp 'r.*';
<<SQLSTATE;

-- 7.5 Invalid column and FIELD predicate are rejected
delete from sensor_data where no_such_attr = 'x';
<<SQLSTATE;

delete from sensor_data where temp > 20.0;
<<SQLSTATE;

-- All invalid statements must leave the baseline unchanged
select count(*) as invalid_cases_remaining_row_count from sensor_data;

-- 8. Device-count protection boundary
