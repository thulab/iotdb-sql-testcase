-- Exactly 1000 matching devices: accepted, expect zero rows
select count(*) as before_limit_1000 from sensor_data;
delete from sensor_data where attr1 = 'same';
select count(*) as after_limit_1000 from sensor_data;

--8.2 1001 matched devices; DELETE is rejected atomically
drop table sensor_data;
create table sensor_data
(
    device_id STRING TAG,
    site STRING TAG,
    attr1 STRING ATTRIBUTE,
    value INT32 FIELD
);

