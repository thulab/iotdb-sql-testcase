-- 8.5 Tag condition reduces the Attribute-matched devices to exactly 1000
drop table sensor_data;
create table sensor_data
(
    device_id STRING TAG,
    site STRING TAG,
    attr1 STRING ATTRIBUTE,
    value INT32 FIELD
);

