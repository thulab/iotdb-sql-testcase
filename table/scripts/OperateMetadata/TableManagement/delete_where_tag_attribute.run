insert into sensor_data(time, device_id, site, attr1, value) values(1, 'tag_d1001', 'south', 'same', 1001);
select site, count(*) as row_count
from sensor_data
group by site
order by site;
select count(*) as before_ad_limit_005 from sensor_data;

delete from sensor_data
where attr1 = 'same'
  and site = 'north';
select site, count(*) as row_count
from sensor_data
group by site
order by site;
select count(*) as after_ad_limit_005 from sensor_data;
-- Expected: north=0, south=1, total=1.

-- 8.6 Time narrows the final rows to one, but Attribute matching still sees 1001 devices
drop table sensor_data;
create table sensor_data
(
    device_id STRING TAG,
    attr1 STRING ATTRIBUTE,
    value INT32 FIELD
);

