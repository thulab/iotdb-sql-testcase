// TIME_COLUMN指向非TIMESTAMP列时拒绝
// 功能：FILL METHOD NEXT 后值填充验证
// 来源：fill_method_next.run
// 环境：仅在专用测试实例执行；每个文件独立清理并准备所需数据。

connect root/TimechoDB@2021;

--0. 清理同名测试数据库
drop database test_db;
<<NULL;

--1. 创建测试数据库
create database test_db;
use test_db;

--2. 创建本用例所需表和字段
create table t1(
  device_id STRING TAG,
  s3 INT32 FIELD,
  s5 TEXT FIELD
);

--3. 插入测试数据
insert into t1(time, device_id, s3, s5) values
(1000, 'd1', 1, 'text-1');
insert into t1(time, device_id, s3, s5) values
(1060, 'd1', null, null);
insert into t1(time, device_id, s3, s5) values
(1120, 'd1', 10, 'text-next');
insert into t1(time, device_id, s3, s5) values
(1180, 'd1', null, null);
insert into t1(time, device_id, s3) values
(1000, 'base', NULL),
(1060, 'base', NULL),
(1120, 'base', NULL),
(1180, 'base', NULL);
insert into t1(time, device_id, s3) values
(1000, 'chain', NULL),
(1060, 'chain', NULL),
(1120, 'chain', NULL);
insert into t1(time, device_id, s3) values
(1000, 'multi', 1),
(1060, 'multi', null),
(1120, 'multi', 3);
insert into t1(time, device_id, s3) values
(1000, 'full', NULL),
(1060, 'full', NULL);
insert into t1(time, device_id, s3) values
(1000, 'bound_ok', NULL),
(1020, 'bound_ok', NULL);

--4. 验证：TIME_COLUMN指向非TIMESTAMP列时拒绝
select time, s3, s5
from t1
FILL METHOD NEXT TIME_BOUND 30ms TIME_COLUMN 2
order by time;
<<SQLSTATE;

--5. 清理环境
connect root/TimechoDB@2021;
drop database test_db;
<<NULL;
