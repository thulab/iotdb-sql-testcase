// 表 TTL：检查建表时的 TTL 设置及表信息
connect root/TimechoDB@2021;

-- 0. 清理测试环境
drop database set_ttl_table_db;
<<NULL;

-- 1. 创建测试数据库并指定当前数据库
create database set_ttl_table_db;
use set_ttl_table_db;

-- 2. 创建未显式设置 TTL 的表
create table table_0(device_id STRING TAG, value DOUBLE FIELD);
create table table_1(device_id STRING TAG, value FLOAT FIELD);

-- 3. 创建指定正数、INF、default 及较大数值 TTL 的表
create table table_2(device_id STRING TAG, model_id STRING ATTRIBUTE, enabled BOOLEAN FIELD, value INT64 FIELD, amount DOUBLE FIELD) with (TTL=10000);
create table table_3(device_id STRING TAG, value INT32 FIELD) with (ttl='inf');
create table table_4(device_id STRING TAG, value INT32 FIELD) with (ttl='INF');
create table table_5(device_id STRING TAG, value INT32 FIELD) with (ttl=default);
create table table_6(device_id STRING TAG, value INT32 FIELD) with (ttl=9999999999);

-- 4. 查看表 TTL 和表结构
show tables;
desc table_2;

-- 5. 清理测试数据库
drop database set_ttl_table_db;
<<NULL;
