// LEAST 不支持 BLOB 数据类型
// 来源：least_query.run

connect root/TimechoDB@2021;

-- 1. 清理可能残留的测试数据库
drop database test_db;
<<NULL;

-- 2. 创建数据库和 BLOB 测试表
create database test_db;
use test_db;
create table table9(blob_1 BLOB, blob_2 BLOB);
insert into table9 values(1,X'11F8d7',X'FFD8FFE0');

-- 3. LEAST 不支持 BLOB
select blob_1, blob_2, least(blob_1,blob_2) from table9;
<<SQLSTATE;

-- 4. 清理测试数据库
drop database test_db;
<<NULL;
