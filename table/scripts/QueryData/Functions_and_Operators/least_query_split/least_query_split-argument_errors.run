// LEAST 参数数量与类型不一致时返回 SQLSTATE
// 来源：least_query.run

connect root/TimechoDB@2021;

-- 1. 清理可能残留的测试数据库
drop database test_db;
<<NULL;

-- 2. 创建数据库和异常测试表
create database test_db;
use test_db;
create table table1(float_1 FLOAT);
create table table9(int32 INT32, float FLOAT);

-- 3. LEAST 无参数
select least() as least_result from table1;
<<SQLSTATE;

-- 4. LEAST 只有一个参数
select least(float_1) as least_result from table1;
<<SQLSTATE;

-- 5. LEAST 参数数据类型不一致
select least(int32,float) from table9;
<<SQLSTATE;

-- 6. 清理测试数据库
drop database test_db;
<<NULL;
