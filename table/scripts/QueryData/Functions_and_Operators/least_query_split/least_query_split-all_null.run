// LEAST 所有参数均为 NULL 时返回 NULL
// 来源：least_query.run

connect root/TimechoDB@2021;

-- 1. 清理可能残留的测试数据库
drop database test_db;
<<NULL;

-- 2. 创建数据库和空值测试表
create database test_db;
use test_db;
create table null_table(num1 INT32, num2 INT32);

-- 3. 插入所有值均为 NULL 的数据
insert into null_table values(1,null,null),(2,null,null);

-- 4. 全 NULL 输入应返回 NULL
select num1, num2, least(num1,num2) as least_result from null_table order by time;

-- 5. 清理测试数据库
drop database test_db;
<<NULL;
