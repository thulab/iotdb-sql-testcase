select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			PREV(RPR_FIRST(totalprice, 2), 2) AS price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN (A+)
		DEFINE
