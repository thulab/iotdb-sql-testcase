-- 17. FINAL RPR_LAST：输出匹配完成后的行末值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			FINAL RPR_LAST(totalprice) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 18. FINAL RPR_LAST：指定偏移 2 后输出匹配行末值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			FINAL RPR_LAST(totalprice, 2) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 19嵌套导航：按 NEXT/PREV 外层函数，再按 RPR_FIRST/RPR_LAST 排列
-- 19.1 NEXT(RPR_FIRST)：读取后续行的匹配首值，默认偏移
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			NEXT(RPR_FIRST(totalprice)) AS price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN (A+)
		DEFINE
			A AS true	
	) AS m;

-- 19.2 NEXT(RPR_FIRST)：RPR_FIRST 显式偏移 1
select m.time, m.price from orders
	MATCH_RECOGNIZE(
	order by time
		measures
			NEXT(RPR_FIRST(totalprice, 1)) AS price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN (A+)
		DEFINE
			A AS true	
	) AS m;

-- 19.3 NEXT(RPR_FIRST)：外层 NEXT 显式偏移 2
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			NEXT(RPR_FIRST(totalprice), 2) AS price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN (A+)
		DEFINE
			A AS true	
	) AS m;

-- 19.4 NEXT(RPR_FIRST)：内层偏移 1、外层偏移 2
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			NEXT(RPR_FIRST(totalprice, 1), 2) AS price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN (A+)
		DEFINE
			A AS true	
	) AS m;	


-- 19.5 NEXT(RPR_LAST)：默认偏移读取下一行的匹配末值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			NEXT(RPR_LAST(totalprice)) AS price
		ALL ROWS PER MATCH
