-- 19.15 PREV(RPR_LAST)：外层 PREV 显式偏移 2
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			PREV(RPR_LAST(totalprice), 2) AS price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN (A+)
		DEFINE
			A AS true	
