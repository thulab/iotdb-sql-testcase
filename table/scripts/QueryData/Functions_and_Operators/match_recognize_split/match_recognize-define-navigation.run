-- 20. 量词 *：验证模式变量 B 可重复零次或多次
select m.match, m.num, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			MATCH_NUMBER() AS match,
			RUNNING RPR_LAST(number) AS num,
			CLASSIFIER() AS label
		ONE ROW PER MATCH
		PATTERN (B*)
		DEFINE
			B AS B.number < PREV(B.number)
	) AS m
order by match, num, label;

-- 21混合查询：组合分区、筛选条件与 MATCH_RECOGNIZE 度量
-- 21.1 混合导航：用分区及 number 排序验证基础 A+ 模式
select * from orders
	MATCH_RECOGNIZE(
		partition by customer_id
		order by number
		measures
			MATCH_NUMBER() AS match,
			CLASSIFIER() AS label
		ALL ROWS PER MATCH
		PATTERN (A+)
		DEFINE
			A AS true
	) AS m
order by customer_id,number;

-- 21.2 基础度量：查询匹配行的时间和 totalprice
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		measures
			totalprice as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m
order by time, price;

-- 21.3. 分区聚合：按 customer_id 分区并筛选 totalprice 大于 10000 的匹配
select * from orders
	MATCH_RECOGNIZE(
		partition by customer_id
		order by time
		measures 
			MATCH_NUMBER() AS match,
			RPR_FIRST(A.time) AS event_start,
			RPR_LAST(A.time) AS event_end,
			RPR_LAST(A.totalprice) AS last_totalprice
	ONE ROW PER MATCH
	PATTERN (A+)
	DEFINE A AS A.totalprice > 10000
	)
	as m
ORDER BY customer_id, match, last_totalprice;

-- 22. 子查询输入：先筛选 region 与时间范围，再按 region 进行行模式匹配
select * from
	(
	-- 先按 region 和时间窗口筛选输入行
	select time, customer_id, region, totalprice from orders
		where region = 'beijing' and time >= 1748736600000 and time < 1748923200000
	)
	MATCH_RECOGNIZE(
		partition by region
		order by time
		measures
			MATCH_NUMBER() AS match,
			RPR_FIRST(A.time) AS event_start,
			RPR_LAST(A.time) AS event_end,
			RPR_LAST(A.totalprice) AS last_totalprice
		ONE ROW PER MATCH
		PATTERN (A+)
		DEFINE
			A AS A.totalprice > 100000
	) AS m;

-- 23. 清理环境
drop database test_db;
<<NULL;
