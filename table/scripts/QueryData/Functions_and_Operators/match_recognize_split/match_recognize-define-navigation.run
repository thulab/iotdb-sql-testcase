		DEFINE
			A AS true	
	) AS m;


-- 19.9 PREV(RPR_FIRST)：默认偏移读取前一行的匹配首值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			PREV(RPR_FIRST(totalprice)) AS price
		ALL ROWS PER MATCH
