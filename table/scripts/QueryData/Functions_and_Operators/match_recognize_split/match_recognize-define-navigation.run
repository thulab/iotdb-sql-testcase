-- 7. 原始数据查询
select * from orders order by time;		



-- 8. DEFINE：定义行模式变量，并使用 A+ 验证一个或多个连续匹配行
select * from orders
	MATCH_RECOGNIZE(
		partition by customer_id
		order by number
		measures
			MATCH_NUMBER() AS match,
			CLASSIFIER() AS label
		ALL ROWS PER MATCH
		PATTERN (A+)
		DEFINE
			A AS true
	) AS m
order by customer_id,number;

-- 9. NEXT：读取后续行，依次测试默认偏移及显式偏移 1、2
-- 9.1 NEXT：使用默认偏移读取下一行
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			NEXT(totalprice) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 9.2 NEXT：显式偏移 1，读取下一行
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			NEXT(totalprice, 1) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 9.3 NEXT：显式偏移 2，读取后续第二行
select m.time, m.price from orders
	MATCH_RECOGNIZE(
	order by time
		measures
			NEXT(totalprice, 2) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 10. PREV：读取前序行，依次测试默认偏移及显式偏移 1、2
-- 10.1 PREV：使用默认偏移读取前一行
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			PREV(totalprice) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 10.2 PREV：显式偏移 1，读取前一行
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			PREV(totalprice, 1) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 10.3 PREV：显式偏移 2，读取前序第二行
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			PREV(totalprice, 2) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 11. RPR_FIRST：匹配行首值，依次测试默认/显式偏移及 RUNNING、FINAL
-- 11.1 RPR_FIRST：使用默认偏移读取匹配行首值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			RPR_FIRST(totalprice) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 11.2 RPR_FIRST：显式偏移 0，读取当前匹配行首值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			RPR_FIRST(totalprice, 0) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;	

-- 11.3 RPR_FIRST：显式偏移 2，读取匹配行中向前偏移的首值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			RPR_FIRST(totalprice, 2) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;	

-- 12. RUNNING RPR_FIRST：输出匹配过程中的行首值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			RUNNING RPR_FIRST(totalprice) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 13. FINAL RPR_FIRST：输出匹配完成后的行首值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			FINAL RPR_FIRST(totalprice) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;	

-- 14. FINAL RPR_FIRST：指定偏移 2 后输出匹配行首值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			FINAL RPR_FIRST(totalprice, 2) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 15RPR_LAST：匹配行末值，依次测试默认/显式偏移及 RUNNING、FINAL
-- 15.1 RPR_LAST：使用默认偏移读取匹配行末值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			RPR_LAST(totalprice) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 15.2 RPR_LAST：显式偏移 0，读取当前匹配行末值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			RPR_LAST(totalprice, 0) as price
		ALL ROWS PER MATCH
		AFTER MATCH SKIP PAST LAST ROW
		PATTERN(A+)
		DEFINE
			A AS true	
	) AS m;

-- 15.3 RPR_LAST：显式偏移 2，读取匹配行中向前偏移的末值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			RPR_LAST(totalprice, 2) as price
		ALL ROWS PER MATCH
