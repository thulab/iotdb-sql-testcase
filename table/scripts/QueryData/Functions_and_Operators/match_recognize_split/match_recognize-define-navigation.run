		DEFINE
			A AS true	
	) AS m;

-- 16. RUNNING RPR_LAST：输出匹配过程中的行末值
select m.time, m.price from orders
	MATCH_RECOGNIZE(
		order by time
		measures
			RUNNING RPR_LAST(totalprice) as price
		ALL ROWS PER MATCH
