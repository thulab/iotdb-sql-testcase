        PATTERN (B??)
        DEFINE
			B AS B.totalprice <= PREV(B.totalprice)
    ) AS m
order by time, match;

-- 22. 模式量词 B{,}：上下界均省略，贪婪匹配
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
        MEASURES
			MATCH_NUMBER() AS match,
			RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
        PATTERN (B{,})
        DEFINE
			B AS B.totalprice <= PREV(B.totalprice)
    ) AS m
order by time, match, price,label;

-- 23. 模式量词 B{,}?：上下界均省略，非贪婪匹配
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
        MEASURES
