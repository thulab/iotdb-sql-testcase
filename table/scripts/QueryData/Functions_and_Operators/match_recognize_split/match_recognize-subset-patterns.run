-- 7. 原始数据查询
select * from orders order by time;		



-- 8. 模式语法：按 SUBSET、连接与分组、选择、排列、边界和重复量词排列
-- 8.1 SUBSET：合并 C、D 模式变量，并验证连接与量词组合
select * from orders
	MATCH_RECOGNIZE(
	order by time,customer_id
	measures
		MATCH_NUMBER() AS match,
		RUNNING RPR_LAST(totalprice) AS price,
		CLASSIFIER() as label
	ALL ROWS PER MATCH
	PATTERN (A B+ C+ D?)
	SUBSET U = (C, D)
	DEFINE
		B AS B.totalprice < PREV (B.totalprice),
		C AS C.totalprice > PREV (C.totalprice),
		D as false
	)
	as m
order by time, customer_id, match, price;

-- 8.2 模式连接：依次匹配 A、B、C
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN (A B C)
		DEFINE
			B AS B.totalprice < PREV (B.totalprice),
			C AS C.totalprice = PREV (C.totalprice)
    ) AS m
order by time, match, price, label;

-- 8.3 嵌套分组：验证多层括号包裹的模式表达式
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN (((A) (B (C))))
		DEFINE
			B AS B.totalprice < PREV (B.totalprice),
			C AS C.totalprice = PREV (C.totalprice)
    ) AS m
order by time, match, price, label;	

-- 8.4 模式选择：比较 L、H 备选变量，并读取前后分类
select m.time, m.match, m.price, m.label, m.prev_label, m.next_label from orders
	MATCH_RECOGNIZE(
		order by time
        MEASURES 
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label,
            PREV(CLASSIFIER()) AS prev_label,
            NEXT(CLASSIFIER()) AS next_label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
        PATTERN ((L | H) A) 
		DEFINE
			A AS A.totalprice = 55000,
			L AS L.totalprice < 55000,
			H AS H.totalprice > 55000
    ) AS m;

-- 8.5 模式选择：依次尝试 B、C、A 三个备选变量
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN (B | C | A)
		DEFINE
			B AS B.totalprice < PREV (B.totalprice),
			C AS C.totalprice <= PREV (C.totalprice)
    ) AS m
order by time, match, price, label;

-- 9. PERMUTE：验证 B、C 模式变量的排列组合
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN (PERMUTE(B, C))
		DEFINE
			B AS B.totalprice < PREV (B.totalprice),
			C AS C.totalprice < PREV (C.totalprice)
    ) AS m
order by time, match, price, label;	

-- 10. 模式边界 $A：测试前置结束锚点
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN ($A)
		DEFINE A AS true
    ) AS m;	

-- 11. 模式边界 $A$：测试两端均为结束锚点
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN ($A$)
		DEFINE A AS true
    ) AS m;

-- 12. 模式边界 A$：匹配结束于分区末行的模式
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN (A$)
		DEFINE A AS true
    ) AS m;

-- 13. 模式边界 A^：测试模式末尾的结束锚点
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN (A^)
		DEFINE A AS true
    ) AS m;

-- 14. 模式边界 ^A：匹配从分区首行开始的模式
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time 
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN (^A)
		DEFINE A AS true
    ) AS m;

-- 15. 模式边界 ^A^：同时限定分区起点和终点
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
		MEASURES
			MATCH_NUMBER() AS match,
            RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
		PATTERN (^A^)
		DEFINE A AS true
    ) AS m;

-- 16. 模式量词 B*：零次或多次，贪婪匹配
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
        MEASURES
			MATCH_NUMBER() AS match,
			RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
        PATTERN (B*)
        DEFINE
			B AS B.totalprice <= PREV(B.totalprice)
    ) AS m
order by time, match, price, label;	

-- 17. 模式量词 B*?：零次或多次，非贪婪匹配
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
        MEASURES
			MATCH_NUMBER() AS match,
			RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
        PATTERN (B*?)
        DEFINE
			B AS B.totalprice <= PREV(B.totalprice)
    ) AS m
order by time, match;	

-- 18. 模式量词 B+：一次或多次，贪婪匹配
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
        MEASURES
			MATCH_NUMBER() AS match,
			RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
        PATTERN (B+)
        DEFINE
			B AS B.totalprice <= PREV(B.totalprice)
    ) AS m
order by time, match, price;	

-- 19. 模式量词 B+?：一次或多次，非贪婪匹配
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
        MEASURES
			MATCH_NUMBER() AS match,
			RUNNING RPR_LAST(totalprice) AS price,
            CLASSIFIER() AS label
        ALL ROWS PER MATCH
        AFTER MATCH SKIP PAST LAST ROW
        PATTERN (B+?)
        DEFINE
			B AS B.totalprice <= PREV(B.totalprice)
    ) AS m
order by time, match, price;	

-- 20. 模式量词 B?：零次或一次，贪婪匹配
select m.time, m.match, m.price, m.label from orders
	MATCH_RECOGNIZE(
		order by time
        MEASURES
			MATCH_NUMBER() AS match,
