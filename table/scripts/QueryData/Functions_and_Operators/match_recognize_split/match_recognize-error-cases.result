-- [1]129:select m.time, m.region, m.product, m.lower_or_higher, m.label from orders 	MATCH_RECOGNIZE ( 		order by time 		measures 			MATCH_NUMBER() AS match, 			RUNNING FIRST(totalprice) AS price, 			CLASSIFIER(U) AS lower_or_higher, 			CLASSIFIER(W) AS label 		ALL ROWS PER MATCH 		PATTERN ((L | H) A) 		SUBSET  			U = (L, H), 			W = (A, L, H) 		DEFINE  			A AS A.number = 666, 			L AS L.number < 666, 			H AS H.number > 666 	) AS m
