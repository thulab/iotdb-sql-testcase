//CASE WHEN：表达式结果与过滤条件
//来源：case_when_query.run
//本文件重建 test_db 并写入共用测试数据，覆盖 CASE 表达式、无 ELSE 返回值及 WHERE 条件中的 CASE，末尾清理数据库。
-- 连接测试数据库实例。
connect root/TimechoDB@2021;

-- 清理可能残留的测试数据库。
-- 删除测试数据库。
-- 清理可能残留的测试数据库。
drop database test_db;

-- 标记清库语句预期返回空结果。
<<NULL;

-- 创建测试数据库。
create database test_db;

-- 切换到测试数据库。
use test_db;

-- 创建 CASE WHEN 查询所需的表结构。
create table table1 (time TIMESTAMP TIME, region STRING TAG, device_id STRING TAG, model_id STRING ATTRIBUTE, maintenance STRING ATTRIBUTE, temperature FLOAT FIELD, humidity FLOAT FIELD, status Boolean FIELD, arrival_time TIMESTAMP FIELD);

-- 写入覆盖温度、湿度、空值和状态场景的测试数据。
INSERT INTO table1(time, region, device_id, model_id, maintenance, temperature, humidity, status, arrival_time) VALUES (1000, '北京', 'd1', 'A', '190', 90.0, 35.1, true, 2024-11-26 13:37:34),(2000, '北京', 'd1', 'A', '190', 90.0, 35.1, true, 2024-11-01 13:38:25),(3000, '北京', 'd2', 'B', '181', NULL, 35.1, true, 2024-10-27 16:37:01),(4000, '北京', 'd2', 'B', '181', 85.0, NULL, NULL, 2024-11-27 16:37:03),(6000, '北京', 'd2', 'B', '181', 85.0, NULL, NULL, 2024-11-29 16:00:04),(7000, '北京', 'd3', 'C', '155', NULL, 35.2, false, Null),(8000, '北京', 'd3', 'C', '155', NULL, Null, false, Null),(9000, '北京', 'd3', 'C', '155', NULL, Null, false, 2024-10-31 16:37:08),(10000, '上海', 'd4', 'D', '94', 85.0, Null, NULL, 2024-11-28 08:00:09),(11000, '上海', 'd4', 'D', '94', NULL, 40.9, true, NULL),(12000, '上海', 'd4', 'D', '94', 85.0, 35.2, NULL, 2024-12-01 10:00:11),(13000, '上海', 'd5', 'E', '90', 88.0, 45.1, true, 2024-11-30 11:00:12),(14000, '上海', 'd5', 'E', '362', 85.0, NULL, NULL, 2024-11-29 10:00:13),(15000, '上海', 'd5', 'E', '362', NULL, 45.1, true, NULL),(16000, '上海', 'd5', 'E', '362', 90.0, 35.4, true, 2024-11-20 18:30:15),(17000, '上海', 'd5', 'F', '362', 90.0, 35.2, true, NULL),(18000, '上海', 'd5', 'F', '362', 90.0, 34.8, true, 2024-11-30 23:30:17);

-- 测试 CASE WHEN 分支结果中包含时间算术表达式。
select case when true then 202 + (time + 202) end as result from table1 order by time;

-- 测试未写 ELSE 子句时 CASE 表达式的返回结果。
select model_id,
		CASE
           WHEN humidity >= 40.0 THEN 'High'
           WHEN humidity < 40.0 THEN 'Low'
           -- 缺少 ELSE 子句
       END AS humidity_category
from
	table1
order by 1,2;

-- 测试在 WHERE 条件中使用 CASE 表达式筛选高温设备。
select device_id from table1 WHERE CASE WHEN temperature > 75 THEN '高温' ELSE '正常' END = '高温' order by device_id;

-- 删除测试数据库。
drop database test_db;

-- 标记清理语句预期返回空结果。
<<NULL;
