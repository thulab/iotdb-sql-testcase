// FFT 数据校验：重复时间戳、空数值列、NULL 与 TIMECOL 异常均应报错
// 来源：fft_query.run

// 表模型内置表值函数 FFT：对每个分区的实值数值序列执行一维快速傅里叶变换。

connect root/TimechoDB@2021;

-- 1. 清理可能残留的测试对象
drop database test_fft;
<<NULL;

-- 2. 准备测试数据库
create database test_fft;
use test_fft;

-- 3. 准备 FFT 测试表结构
create table signal
(
    device_id STRING TAG,
    temperature DOUBLE FIELD,
    speed INT32 FIELD,
    note STRING FIELD
);

create table single_row
(
    device_id STRING TAG,
    value DOUBLE FIELD
);

create table no_numeric
(
    device_id STRING TAG,
    note STRING FIELD
);

create table with_null
(
    device_id STRING TAG,
    value DOUBLE FIELD
);

create table duplicate_time
(
    device_id STRING TAG,
    value DOUBLE FIELD
);

-- 4. 检查测试表结构
show tables;
desc signal;
desc single_row;
desc no_numeric;
desc with_null;
desc duplicate_time;

-- 5. 准备测试数据
insert into signal(time, device_id, temperature, speed, note) values(0,    'd1', 1.0, 1, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(1000, 'd1', 0.0, 2, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(2000, 'd1', 0.0, 3, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(3000, 'd1', 0.0, 4, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(4000, 'd2', 2.0, 4, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(5000, 'd2', 0.0, 3, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(6000, 'd2', 0.0, 2, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(7000, 'd2', 0.0, 1, 'ok');

insert into single_row(time, device_id, value) values(0, 'd1', 2.0);

insert into no_numeric(time, device_id, note) values(0, 'd1', 'ok');

insert into with_null(time, device_id, value) values(0,    'd1', 1.0);
insert into with_null(time, device_id, value) values(1000, 'd1', 2.0);
insert into with_null(time, device_id, value) values(2000, 'd1', null);

-- 5.1 准备重复时间戳数据：无分区时两个 TAG 实体进入同一 FFT 分区
insert into duplicate_time(time, device_id, value) values(0, 'd1', 1.0);
insert into duplicate_time(time, device_id, value) values(0, 'd2', 2.0);

-- 6. 同一 FFT 分区中时间戳重复
select *
from FFT(
    DATA => (select time, value from duplicate_time) ORDER BY time,
    SAMPLE_INTERVAL => 1s
);
<<SQLSTATE;
-- 7. 不存在可转换的数值列
select *
from FFT(
    DATA => no_numeric PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s
);
<<SQLSTATE;

-- 8. 数值列含 NULL；即使 N=2 截断前两行，也必须校验第三行
select *
from FFT(
    DATA => with_null PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 2
);
<<SQLSTATE;

-- 9. 单行分区未指定采样间隔
select *
from FFT(DATA => single_row PARTITION BY device_id ORDER BY time);
<<SQLSTATE;

-- 10. TIMECOL 指定列不存在
select *
from FFT(
    DATA => signal ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    TIMECOL => 'event_time'
);
<<SQLSTATE;

-- 11. TIMECOL 指定列类型错误
select *
from FFT(
    DATA => signal ORDER BY device_id,
    SAMPLE_INTERVAL => 1s,
    TIMECOL => 'device_id'
);
<<SQLSTATE;

-- 12. 清理测试数据库
drop database test_fft;
<<NULL;
