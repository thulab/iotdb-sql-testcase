}

-- [1]62:select * from FFT(     DATA => signal PARTITION BY device_id ORDER BY speed,     SAMPLE_INTERVAL => 1s )
STRICT{
SQLSTATE : 701: The ORDER BY clause of the DATA argument must contain exactly the time column specified by the TIMECOL argument.
}

-- [1]70:select * from FFT(     DATA => signal ORDER BY time DESC,     SAMPLE_INTERVAL => 1s )
STRICT{
SQLSTATE : 701: The ORDER BY clause of the DATA argument must sort the time column in ascending order.
}

-- [1]74:select * from FFT(DATA => impulse ORDER BY time, SAMPLE_INTERVAL => 1)
STRICT{
