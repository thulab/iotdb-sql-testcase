// FFT 边界场景：验证 N 长度、采样间隔推断、空输入和结果二次查询
// 来源：fft_query.run

// 表模型内置表值函数 FFT：对每个分区的实值数值序列执行一维快速傅里叶变换。

connect root/TimechoDB@2021;

-- 1. 清理可能残留的测试对象
drop database test_fft;
<<NULL;

-- 2. 准备测试数据库
create database test_fft;
use test_fft;

-- 3. 准备 FFT 测试表结构
create table signal
(
    device_id STRING TAG,
    temperature DOUBLE FIELD,
    speed INT32 FIELD,
    note STRING FIELD
);

create table impulse
(
    value DOUBLE FIELD
);

create table seq
(
    value DOUBLE FIELD
);

create table irregular
(
    device_id STRING TAG,
    value DOUBLE FIELD
);

create table single_row
(
    device_id STRING TAG,
    value DOUBLE FIELD
);

create table empty_signal
(
    value DOUBLE FIELD
);

-- 4. 检查测试表结构
show tables;
desc signal;
desc impulse;
desc seq;
desc irregular;
desc single_row;
desc empty_signal;

-- 5. 准备测试数据
insert into signal(time, device_id, temperature, speed, note) values(0,    'd1', 1.0, 1, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(1000, 'd1', 0.0, 2, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(2000, 'd1', 0.0, 3, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(3000, 'd1', 0.0, 4, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(4000, 'd2', 2.0, 4, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(5000, 'd2', 0.0, 3, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(6000, 'd2', 0.0, 2, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(7000, 'd2', 0.0, 1, 'ok');

insert into impulse(time, value) values(0, 1.0);
insert into impulse(time, value) values(1000, 0.0);
insert into impulse(time, value) values(2000, 0.0);
insert into impulse(time, value) values(3000, 0.0);

insert into seq(time, value) values(0, 1.0);
insert into seq(time, value) values(1000, 2.0);
insert into seq(time, value) values(2000, 3.0);
insert into seq(time, value) values(3000, 4.0);

insert into irregular(time, device_id, value) values(0,    'd1', 1.0);
insert into irregular(time, device_id, value) values(1000, 'd1', 2.0);
insert into irregular(time, device_id, value) values(2500, 'd1', 3.0);

insert into single_row(time, device_id, value) values(0, 'd1', 2.0);

-- 6. N 小于输入长度：只转换排序后的前 N 行
select frequency_index, frequency, value_real, value_imag
from FFT(
    DATA => seq ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 2
)
order by frequency_index;

-- 7. N 大于输入长度：在尾部补 0
select frequency_index, frequency, value_real, value_imag
from FFT(
    DATA => (select time, value from impulse where time < 2000) ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
order by frequency_index;

-- 8. 非 2 的幂变换长度
select frequency_index, frequency, value_real, value_imag
from FFT(
    DATA => (select time, value from seq where time <= 2000) ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 3
)
order by frequency_index;

-- 9. 不规则采样：未指定间隔时按首尾跨度的平均值推断
select *
from FFT(
    DATA => irregular PARTITION BY device_id ORDER BY time
)
order by device_id, frequency_index;

-- 10. 不规则采样：省略 SAMPLE_INTERVAL 时使用简写调用形式
select * from FFT
    (DATA => irregular PARTITION BY device_id ORDER BY time)
order by frequency_index;

-- 11. 不规则采样：显式间隔决定频率轴，不与实际相邻间隔比对
select *
from FFT(
    DATA => irregular PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s
)
order by device_id, frequency_index;

-- 12. 单行分区显式指定采样间隔，默认 N=1
select *
from FFT(
    DATA => single_row PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s
)
order by device_id, frequency_index;

-- 13. 空输入返回既定 Schema 和 0 行
select *
from FFT(DATA => empty_signal ORDER BY time)
order by frequency_index;

-- 14. FFT-021：最大允许变换长度
select count(*) as count_result
from FFT(
    DATA => single_row ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 65536
);

-- 15. FFT 结果继续参与投影、过滤、排序和聚合
select device_id, count(*) as non_negative_bin_count
from FFT(
    DATA => signal PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
where frequency >= 0
group by device_id
order by device_id;

-- 16. 清理测试数据库
drop database test_fft;
<<NULL;
