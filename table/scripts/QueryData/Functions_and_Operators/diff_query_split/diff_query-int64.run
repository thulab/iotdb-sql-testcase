// 9. 查询原始数据。
select * from Table_A order by time;

// 10. DIFF 功能验证：INT64 类型差值查询。
select time,s3, diff(s3) as diff_result from (select time,s3 from table_a where device_id='d1' order by time,s3) order by time,s3,diff_result;

