// XCORR 表值函数 SQL 用例

connect root/TimechoDB@2021;

-- 0. 清理数据
drop database xcorr_test_db;
<<NULL;

-- 1. 创建并指定数据库
create database xcorr_test_db;
use xcorr_test_db;

-- 2. 创建基础数据表
create table xcorr_data
(
    device_id STRING TAG,
    site STRING TAG,
    s1 DOUBLE FIELD,
    s2 DOUBLE FIELD
);

create table xcorr_types
(
    device_id STRING TAG,
    s_int32 INT32 FIELD,
    s_int64 INT64 FIELD,
    s_float FLOAT FIELD,
    s_double DOUBLE FIELD
);

create table xcorr_bad_type
(
    device_id STRING TAG,
    s_double DOUBLE FIELD,
    s_boolean BOOLEAN FIELD,
    s_text TEXT FIELD,
    s_string STRING FIELD,
    s_date DATE FIELD,
    s_timestamp TIMESTAMP FIELD,
    s_blob BLOB FIELD
);

create table xc_reference(device_id STRING TAG, s1 DOUBLE FIELD, s2 DOUBLE FIELD);

create table xc_dup_time(
    device_id STRING TAG, source_id STRING TAG, s1 DOUBLE FIELD, s2 DOUBLE FIELD
);

create table xcorr_bid
(
    stock_id STRING TAG,
    price DOUBLE FIELD,
    s1 DOUBLE FIELD
);

create table xcorr_valid_pairs
(
    device_id STRING TAG,
    s1 DOUBLE FIELD,
    s2 DOUBLE FIELD
);

create table xcorr_all_null
(
    device_id STRING TAG,
    s1 DOUBLE FIELD,
    s2 DOUBLE FIELD,
    row_marker INT32 FIELD
);

create table xc_signed_constant
(
    device_id STRING TAG,
    signed_value DOUBLE FIELD,
    constant_value DOUBLE FIELD
);

create table xcorr_single
(
    factory_id STRING TAG,
    device_id STRING TAG,
    s1 DOUBLE FIELD,
    s2 DOUBLE FIELD
);

create table xc_cm_change
(
    device_id STRING TAG,
    s1 DOUBLE FIELD,
    s2 DOUBLE FIELD
);

-- 3. 查看表及表结构
show tables;
desc xcorr_data;
desc xcorr_types;
desc xcorr_bad_type;
desc xc_reference;
desc xc_dup_time;
desc xcorr_bid;
desc xcorr_valid_pairs;
desc xcorr_all_null;
desc xc_signed_constant;
desc xcorr_single;
desc xc_cm_change;

-- 4. 写入基础数据
insert into xcorr_data(time, device_id, site, s1, s2) values(1, 'd1', 's1', 1.0, 1.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(2, 'd1', 's1', 2.0, 2.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(3, 'd1', 's1', 3.0, 3.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(4, 'd1', 's1', 4.0, 4.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(5, 'd1', 's1', 5.0, 5.0);

insert into xcorr_data(time, device_id, site, s1, s2) values(11, 'd1', 's2', 1.0, 5.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(12, 'd1', 's2', 2.0, 4.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(13, 'd1', 's2', 3.0, 3.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(14, 'd1', 's2', 4.0, 2.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(15, 'd1', 's2', 5.0, 1.0);

-- d2/s1 包含 NULL；NULL 不按 0，XCorr 跳过包含无效值的配对
insert into xcorr_data(time, device_id, site, s1, s2) values(21, 'd2', 's1', 1.0, null);
insert into xcorr_data(time, device_id, site, s1, s2) values(22, 'd2', 's1', null, 2.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(23, 'd2', 's1', 3.0, 3.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(24, 'd2', 's1', 4.0, 4.0);
insert into xcorr_data(time, device_id, site, s1, s2) values(25, 'd2', 's1', 5.0, 5.0);

-- 支持的数据类型
insert into xcorr_types(time, device_id, s_int32, s_int64, s_float, s_double) values(1, 'd1', 1, 10, 1.0, 10.0);
insert into xcorr_types(time, device_id, s_int32, s_int64, s_float, s_double) values(2, 'd1', 2, 20, 2.0, 20.0);
insert into xcorr_types(time, device_id, s_int32, s_int64, s_float, s_double) values(3, 'd1', 3, 30, 3.0, 30.0);
insert into xcorr_types(time, device_id, s_int32, s_int64, s_float, s_double) values(4, 'd1', 4, 40, 4.0, 40.0);

-- 不支持的数据类型
insert into xcorr_bad_type(time, device_id, s_double, s_boolean, s_text, s_string, s_date, s_timestamp, s_blob)
values(1, 'd1', 1.0, true, 'text1', 'string1', '2026-01-01', 1, X'01');
insert into xcorr_bad_type(time, device_id, s_double, s_boolean, s_text, s_string, s_date, s_timestamp, s_blob)
values(2, 'd1', 2.0, false, 'text2', 'string2', '2026-01-02', 2, X'02');

-- 交换输入列后互相关lag方向反转验证
insert into xc_reference(time, device_id, s1, s2) values
(1,'d_ref',1.0,4.0),(2,'d_ref',2.0,5.0),(3,'d_ref',3.0,6.0);

-- 同一分区重复时间戳输入校验：并列行使用相同数值，避免 ORDER BY time 未定义的并列顺序影响结果；source_id 不同保证两行均保留
insert into xc_dup_time(time,device_id,source_id,s1,s2) values
(1,'d1','a',1.0,4.0),(1,'d1','b',1.0,4.0),(2,'d1','a',3.0,6.0);

-- 多分区计算结果及分区隔离验证
insert into xcorr_bid(time, stock_id, price, s1) values('2021-01-01T09:05:00', 'AAPL', 100.0, 101.0);
insert into xcorr_bid(time, stock_id, price, s1) values('2021-01-01T09:07:00', 'AAPL', 103.0, 101.0);
insert into xcorr_bid(time, stock_id, price, s1) values('2021-01-01T09:09:00', 'AAPL', 102.0, 101.0);
insert into xcorr_bid(time, stock_id, price, s1) values('2021-01-01T09:06:00', 'TESL', 200.0, 102.0);
insert into xcorr_bid(time, stock_id, price, s1) values('2021-01-01T09:07:00', 'TESL', 202.0, 202.0);
insert into xcorr_bid(time, stock_id, price, s1) values('2021-01-01T09:15:00', 'TESL', 195.0, 332.0);

-- 各lag按有效配对数计算乘积均值
insert into xcorr_valid_pairs(time, device_id, s1, s2) values(1, 'd1', 1.0, 1.0);
insert into xcorr_valid_pairs(time, device_id, s1, s2) values(2, 'd1', null, 2.0);
insert into xcorr_valid_pairs(time, device_id, s1, s2) values(3, 'd1', 3.0, null);

-- 所有lag均无有效配对时输出null，插入数据
insert into xcorr_all_null(time, device_id, s1, s2, row_marker) values(1, 'd1', null, null, 1);
insert into xcorr_all_null(time, device_id, s1, s2, row_marker) values(2, 'd1', null, null, 1);
insert into xcorr_all_null(time, device_id, s1, s2, row_marker) values(3, 'd1', null, null, 1);

-- 负数、零值及常量列互相关计算
insert into xc_signed_constant(time,device_id,signed_value,constant_value) values
(1,'d1',-4.0,5.0),(2,'d1',0.0,5.0),(3,'d1',4.0,5.0),(4,'d1',8.0,5.0);

-- 单点分区输出单个互相关结果，插入数据
insert into xcorr_single(time, factory_id, device_id, s1, s2) values(3, 'F2', 'device_1', 30.0, 30.0);

-- 数据覆盖写入及删除后重新计算，插入数据
insert into xc_cm_change(time, device_id, s1, s2) values
(1, 'd1', 1.0, 4.0), (2, 'd1', 2.0, 5.0), (3, 'd1', 3.0, 6.0),
(1, 'd2', 2.0, 1.0), (2, 'd2', 4.0, 2.0), (3, 'd2', 6.0, 3.0);

-- 5. 原始数据查询
select * from xcorr_data order by device_id, site, time;
select * from xcorr_types order by device_id, time;
select * from xcorr_bad_type order by device_id, time;
select * from xc_reference order by device_id, time;
select * from xc_dup_time order by device_id,time,source_id;
select * from xcorr_bid order by stock_id, time;
select * from xcorr_valid_pairs order by device_id, time;
select * from xc_signed_constant order by device_id,time;
select * from xc_cm_change order by device_id, time;

-- 6. XCORR 正常查询
-- 6.1 Xcorr_按名传参按单列分区执行互相关计算
select * from xcorr(
    DATA => (select time, device_id, s1, s2 from xcorr_data)
            partition by device_id order by time,
    TIMECOL => 'time'
) order by device_id;

-- 6.2 Xcorr_按位传参按单列分区执行互相关计算
select * from xcorr(
    (select time, device_id, s1, s2 from xcorr_data)
    partition by device_id order by time,
    'time'
) order by device_id;

-- 6.3 Xcorr_指定多列PARTITION BY时按组合分区执行互相关计算
select * from xcorr(
    DATA => xcorr_data partition by (device_id, site) order by time,
    TIMECOL => 'time'
) order by device_id, site;

-- 6.4 Xcorr_不指定PARTITION BY时按整体数据执行互相关计算
select * from xcorr(
    DATA => (select time, s1, s2 from xcorr_data) order by time,
    TIMECOL => 'time'
);

-- 6.5 Xcorr_交换输入列后互相关lag方向反转验证

-- 各分区输出行数及隐式lag顺序校验，查询结果依次为 6、8.5、32/3、11.5、12。
select * from xcorr(
    DATA => xc_reference partition by device_id order by time,
    TIMECOL => 'time'
);
-- 交换输入列后，依次为12、11.5、32/3、8.5、6；即 R21(k)=R12(-k)。
select * from xcorr(
    DATA => (select time, device_id, s2, s1 from xc_reference)
            partition by device_id order by time,
    TIMECOL => 'time'
);

-- 6.6 Xcorr_NULL保留序列位置且无效配对不参与计算
select * from xcorr(
    DATA => (select time, device_id, s1, s2 from xcorr_data where device_id = 'd2')
            partition by device_id order by time,
    TIMECOL => 'time'
) order by device_id;

-- 6.7 Xcorr_支持INT32与INT64类型互相关计算
select * from xcorr(
    DATA => (select time, device_id, s_int32, s_int64 from xcorr_types)
            partition by device_id order by time,
    TIMECOL => 'time'
) order by device_id;

-- 6.8 Xcorr_支持FLOAT与DOUBLE类型互相关计算
select * from xcorr(
    DATA => (select time, device_id, s_float, s_double from xcorr_types)
            partition by device_id order by time,
    TIMECOL => 'time'
) order by device_id;

-- 6.9 Xcorr_支持INT32与FLOAT混合类型互相关计算
select * from xcorr(
    DATA => (select time, device_id, s_int32, s_float from xcorr_types)
            partition by device_id order by time,
    TIMECOL => 'time'
) order by device_id;

-- 6.10 Xcorr_零值序列及常量序列互相关计算
-- 9行结果均为：0.0
select * from xcorr(
    DATA => (
        select time, device_id, s1 - s1 as zero_value, s2
        from xcorr_data where device_id = 'd1' and site = 's1'
    ) partition by device_id order by time,
    TIMECOL => 'time'
) order by device_id;

-- 9行结果均为：10.0
select * from xcorr(
    DATA => (
        select time, device_id, s1-s1+2.0 as const_a, s2-s2+5.0 as const_b
        from xcorr_data where device_id='d1' and site='s1'
    ) partition by device_id order by time,
    TIMECOL => 'time'
);

-- 6.11 Xcorr_多分区计算结果及分区隔离验证
-- AAPL 依次对应 lag=-2..2：10100.0、10251.5、10268.333333333334、10352.5、10302.0。
-- TESL：66400.0、53732.0、41981.333333333336、29997.0、19890.0。
select * from xcorr(
    DATA => xcorr_bid partition by stock_id order by time,
    TIMECOL => 'time'
) order by 1,2;

-- 6.12 Xcorr_各lag按有效配对数计算乘积均值
-- lag=-2..2 的期望值：NULL、2.0、1.0、6.0、3.0。
select * from xcorr(
    DATA => xcorr_valid_pairs partition by device_id order by time,
    TIMECOL => 'time'
);


-- 6.13 Xcorr_所有lag均无有效配对时输出NULL，DATA只投影s1/s2，避免第三列混入计算
-- 期望输出 5 行，xcorr(s1, s2) 全部为 NULL
select * from xcorr(
    DATA => (select time, device_id, s1, s2 from xcorr_all_null) partition by device_id order by time,
    TIMECOL => 'time'
);

-- 6.14 Xcorr_负数、零值及常量列互相关计算
-- n=4，lag=-3..3共7行：-20、-10、0、10、20、30、40；
select * from xcorr(
    DATA => xc_signed_constant partition by device_id order by time,
    TIMECOL => 'time'
);

-- 6.15 Xcorr_单点分区互相关结果及输出结构校验
-- 期望仅 1 行：F2, device_1, 900.0；输出不包含 time 和 lag 列。
select * from xcorr(
    DATA => xcorr_single partition by (factory_id, device_id) order by time,
    TIMECOL => 'time'
);


-- 6.16 Xcorr_兼容性_数据覆盖写入及删除后重新计算结果校验
-- 6.16.1 查询原始数据及 XCorr，建立两个分区的基线。
-- 原始数据 6 行；
select device_id, time, s1, s2 from xc_cm_change order by device_id, time;

-- XCorr 共 10 行，d1 为 6.0、8.5、32/3、11.5、12.0；d2 为 6.0、8.0、28/3、8.0、6.0。
select * from xcorr(
    DATA => (select time, device_id, s1, s2 from xc_cm_change)
            partition by device_id order by time,
    TIMECOL => 'time'
) order by 1,2;

-- 6.16.2 相同 TAG+time 覆盖 d1,time=2，仅将 s1 从 2.0 改为 8.0。
insert into xc_cm_change(time, device_id, s1, s2) values(2, 'd1', 8.0, 5.0);
-- 原始数据仍为 6 行，d1,time=2 只有一行且为 (8.0,5.0)；d2,time=2 仍为 (4.0,2.0)。
select device_id, time, s1, s2 from xc_cm_change order by device_id, time;

-- XCorr 仍为 10 行；d1 对应 lag=-2..2 变为 6.0、26.5、62/3、23.5、12.0；d2 的 5 个相关值与初始完全一致；
select * from xcorr(
    DATA => (select time, device_id, s1, s2 from xc_cm_change)
            partition by device_id order by time,
    TIMECOL => 'time'
) order by 1,2;

-- 6.16.3 删除 d1 的中间时间点 time=2，再执行完全相同的查询。
delete from xc_cm_change where device_id='d1' and time=2;
-- 原始数据 5 行；d1 仅 time=1/3，输入序列为 s1=[1,3]、s2=[4,6]，按剩余行重新编号。
select device_id, time, s1, s2 from xc_cm_change order by device_id, time;

-- XCorr 共 8 行：d1为 6.0、11.0、12.0；d2 仍输出原来的 5 个相关值。
select * from xcorr(
    DATA => (select time, device_id, s1, s2 from xc_cm_change)
            partition by device_id order by time,
    TIMECOL => 'time'
) order by 1,2;

-- 6.16.4：删除 d2 整个分区的数据，再查询验证分区隔离。
delete from xc_cm_change where device_id='d2';

-- 原始数据仅 d1 的 2 行；
select device_id, time, s1, s2 from xc_cm_change order by device_id, time;

-- XCorr 仅 d1 的 3 行，相关值仍为 6.0、11.0、12.0，d2 不返回结果行。
select * from xcorr(
    DATA => (select time, device_id, s1, s2 from xc_cm_change)
            partition by device_id order by time,
    TIMECOL => 'time'
);

-- 6.17 Xcorr_同一分区重复时间戳输入校验：3 行输入均参与计算，输出 5 行，按值排序为 5.0、6.0、8.0、26/3、12.0
select * from xcorr(
    DATA => (select time,device_id,s1,s2 from xc_dup_time) partition by device_id order by time,
    TIMECOL => 'time'
) order by 1,2;

-- 7. XCORR 参数和输入异常
-- 7.1 缺少 DATA
select * from xcorr(TIMECOL => 'time');
<<SQLSTATE;

-- 7.2 缺少 TIMECOL
select * from xcorr(DATA => xcorr_data partition by (device_id, site) order by time);
<<SQLSTATE;

-- 7.3 Xcorr_DATA缺少ORDER BY时报错
select * from xcorr(DATA => xcorr_data partition by (device_id, site), TIMECOL => 'time');
<<SQLSTATE;

-- 7.4 Xcorr_DATA排序列与TIMECOL不一致时报错
select * from xcorr(DATA => xcorr_data partition by (device_id, site) order by s1, TIMECOL => 'time');
<<SQLSTATE;

select * from xcorr(DATA => xcorr_data partition by (device_id, site) order by time, s1, TIMECOL => 'time');
<<SQLSTATE;

-- 7.5 TIMECOL 不存在或不是 TIMESTAMP
select * from xcorr(DATA => xcorr_data partition by (device_id, site) order by time, TIMECOL => 'not_exists');
<<SQLSTATE;

select * from xcorr(DATA => xcorr_data partition by (device_id, site) order by time, TIMECOL => 's1');
<<SQLSTATE;

-- 7.6 Xcorr_计算列少于两列时报错
select * from xcorr(
    DATA => (select time, device_id, s1 from xcorr_data)
            partition by device_id order by time,
    TIMECOL => 'time'
);
<<SQLSTATE;

-- 7.7 Xcorr_计算列多于两列时报错
select * from xcorr(
    DATA => (select time, device_id, s_int32, s_int64, s_float from xcorr_types)
            partition by device_id order by time,
    TIMECOL => 'time'
);
<<SQLSTATE;

-- 7.8 Xcorr_计算列包含不支持的数据类型时报错
select * from xcorr(DATA => (select time, device_id, s_double, s_boolean from xcorr_bad_type) partition by device_id order by time, TIMECOL => 'time');
<<SQLSTATE;

select * from xcorr(DATA => (select time, device_id, s_double, s_text from xcorr_bad_type) partition by device_id order by time, TIMECOL => 'time');
<<SQLSTATE;

select * from xcorr(DATA => (select time, device_id, s_double, s_string from xcorr_bad_type) partition by device_id order by time, TIMECOL => 'time');
<<SQLSTATE;

select * from xcorr(DATA => (select time, device_id, s_double, s_date from xcorr_bad_type) partition by device_id order by time, TIMECOL => 'time');
<<SQLSTATE;

select * from xcorr(DATA => (select time, device_id, s_double, s_timestamp from xcorr_bad_type) partition by device_id order by time, TIMECOL => 'time');
<<SQLSTATE;

select * from xcorr(DATA => (select time, device_id, s_double, s_blob from xcorr_bad_type) partition by device_id order by time, TIMECOL => 'time');
<<SQLSTATE;

-- 7.9 不存在的表
select * from xcorr(DATA => not_exists order by time, TIMECOL => 'time');
<<SQLSTATE;

-- 7.10 错误参数名
select * from xcorr(DAT => xcorr_data order by time, TIMECOL => 'time');
<<SQLSTATE;

-- 8. 清理数据
drop database xcorr_test_db;
<<NULL;
