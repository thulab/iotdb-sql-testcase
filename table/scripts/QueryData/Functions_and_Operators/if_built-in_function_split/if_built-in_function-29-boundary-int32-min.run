-- if_built-in_function：INT32 最小值边界
-- 目的：验证 IF 对 INT32 最小值的边界处理。

-- 1. 连接管理员账号
connect root/TimechoDB@2021;

-- 2. 清理上次运行遗留的 test 数据库
drop database test;
<<NULL;

-- 3. 创建 test 测试数据库
create database test;
-- 4. 切换到 test 数据库
use test;

-- 5. 创建本用例所需的测试表
CREATE TABLE test.if_test(ts TIMESTAMP, col_int32 INT32);
-- 6. 插入 INT32 最小值 -2147483648
INSERT INTO test.if_test(ts, col_int32) VALUES (now(), -2147483648);
-- 7. 插入一条测试数据
INSERT INTO test.if_test(ts, col_int32) VALUES (now()+1s, 0);
-- 8. 插入一条测试数据
INSERT INTO test.if_test(ts, col_int32) VALUES (now()+2s, 100);

-- 9. 执行本用例的 IF 验证查询
SELECT if(col_int32 = -2147483648, 'min', 'not-min') FROM test.if_test;

-- 10. 删除本用例创建的 test 数据库
drop database test;
<<NULL;
