-- if_built-in_function：拥有 any 范围的 SELECT 权限的用户+IF
-- 目的：验证拥有 any 范围 SELECT 权限的用户可执行 IF 查询。

-- 1. 连接管理员账号
connect root/TimechoDB@2021;

-- 2. 清理上次运行遗留的 test 数据库
drop database test;
<<NULL;
-- 3. 清理上次运行遗留的测试用户
drop user user1;
<<NULL;

-- 4. 创建 test 测试数据库
create database test;
-- 5. 切换到 test 数据库
use test;

-- 6. 创建本用例所需的测试表
CREATE TABLE test.if_test(
    ts TIMESTAMP,
    col_boolean BOOLEAN,
    col_int32 INT32
);
-- 7. 插入一条测试数据
INSERT INTO test.if_test(ts, col_boolean, col_int32) VALUES (now(), true, 1);
-- 8. 插入一条测试数据
INSERT INTO test.if_test(ts, col_boolean, col_int32) VALUES (now()+1s, false, 0);

-- 9. 创建权限测试用户
create user user1 '@Pass1234567';
-- 10. 授予权限测试用户本用例所需权限
grant select on any to user user1;

-- 11. 连接权限测试用户
connect user1/@Pass1234567;
-- 12. 切换到 test 数据库
use test;

-- 13. 执行本用例的 IF 验证查询
SELECT if(col_boolean = true, 'YES') FROM test.if_test WHERE col_boolean = true;

-- 14. 连接管理员账号
connect root/TimechoDB@2021;
-- 15. 删除本用例创建的测试用户
drop user user1;
<<NULL;

-- 16. 删除本用例创建的 test 数据库
drop database test;
<<NULL;
