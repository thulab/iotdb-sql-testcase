-- if_built-in_function：IF + 字符串函数
-- 目的：验证 IF 与字符串函数组合表达式的返回结果。

-- 1. 连接管理员账号
connect root/TimechoDB@2021;

-- 2. 清理上次运行遗留的 test 数据库
drop database test;
<<NULL;

-- 3. 创建 test 测试数据库
create database test;
-- 4. 切换到 test 数据库
use test;

-- 5. 创建本用例所需的测试表
CREATE TABLE test.if_test(ts TIMESTAMP, col_text TEXT);
-- 6. 插入一条测试数据
INSERT INTO test.if_test(ts, col_text) VALUES (now(), 'hello');
-- 7. 插入一条测试数据
INSERT INTO test.if_test(ts, col_text) VALUES (now()+1s, '');

-- 8. 执行本用例的 IF 验证查询
SELECT LENGTH(if(col_text!='', CAST(col_text AS STRING), 'default')) FROM test.if_test;

-- 9. 删除本用例创建的 test 数据库
drop database test;
<<NULL;
