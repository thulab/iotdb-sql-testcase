-- if_built-in_function：同类型不同精度 INT64
-- 目的：验证 IF 的 INT64 返回分支在不同精度整数值间保持类型一致。

-- 1. 连接管理员账号
connect root/TimechoDB@2021;

-- 2. 清理上次运行遗留的 test 数据库
drop database test;
<<NULL;

-- 3. 创建 test 测试数据库
create database test;
-- 4. 切换到 test 数据库
use test;

-- 5. 创建本用例所需的测试表
CREATE TABLE test.if_test(
    ts TIMESTAMP,
    col_boolean BOOLEAN,
    col_int32 INT32,
    col_int64 INT64,
    col_float FLOAT,
    col_double DOUBLE,
    col_text TEXT,
    col_string STRING,
    col_blob BLOB,
    col_timestamp TIMESTAMP,
    col_date DATE
);

-- 6. 插入一条测试数据
INSERT INTO test.if_test(ts, col_boolean, col_int32, col_int64, col_float, col_double, col_text, col_string)
VALUES (now(), true, 1, 100, 1.5, 2.5, 'text1', 'string1');

-- 7. 插入一条测试数据
INSERT INTO test.if_test(ts, col_boolean, col_int32, col_int64, col_float, col_double, col_text, col_string)
VALUES (now()+1s, false, 0, 0, 0.0, 0.0, '', '');

-- 8. 插入一条测试数据
INSERT INTO test.if_test(ts, col_boolean, col_int32, col_int64, col_float, col_double, col_text, col_string)
VALUES (now()+2s, true, -1, -100, -1.5, -2.5, 'text3', 'string3');

-- INSERT INTO test.if_test(ts, col_boolean, col_int32, col_int64, col_float, col_double, col_text, col_string)
-- VALUES (now()+3s, NULL, NULL, NULL, NULL, NULL, NULL, NULL);

-- 9. 执行本用例的 IF 验证查询
SELECT if(col_int64>0, col_int64, 0) FROM test.if_test;
<<SQLSTATE;

-- 10. 删除本用例创建的 test 数据库
drop database test;
<<NULL;
