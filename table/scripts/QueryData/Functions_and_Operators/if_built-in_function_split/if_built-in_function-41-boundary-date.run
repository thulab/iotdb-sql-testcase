-- if_built-in_function：DATE 边界值
-- 目的：验证 IF 对 DATE 边界值的处理。

-- 1. 连接管理员账号
connect root/TimechoDB@2021;

-- 2. 清理上次运行遗留的 test 数据库
drop database test;
<<NULL;

-- 3. 创建 test 测试数据库
create database test;
-- 4. 切换到 test 数据库
use test;

-- 5. 创建本用例所需的测试表
CREATE TABLE test.if_test(ts TIMESTAMP, col_date DATE);
-- 6. 插入一条测试数据
INSERT INTO test.if_test(ts, col_date) VALUES (now(), '1970-01-01');
-- 7. 插入一条测试数据
INSERT INTO test.if_test(ts, col_date) VALUES (now()+1s, '2024-01-01');

-- 8. 执行本用例的 IF 验证查询
SELECT if(col_date = CAST('1970-01-01' AS DATE), 'epoch', 'other') FROM test.if_test;

-- 9. 删除本用例创建的 test 数据库
drop database test;
<<NULL;
