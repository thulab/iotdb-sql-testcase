-- if_built-in_function：溢出场景 + IF
-- 目的：验证 IF 分支计算发生溢出时的预期行为。

-- 1. 连接管理员账号
connect root/TimechoDB@2021;

-- 2. 清理上次运行遗留的 test 数据库
drop database test;
<<NULL;

-- 3. 创建 test 测试数据库
create database test;
-- 4. 切换到 test 数据库
use test;

-- 5. 创建本用例所需的测试表
CREATE TABLE test.if_test(ts TIMESTAMP, col_int32 INT32);
-- 6. 插入一条测试数据
INSERT INTO test.if_test(ts, col_int32) VALUES (now(), 1073741824);
-- 7. 插入一条测试数据
INSERT INTO test.if_test(ts, col_int32) VALUES (now()+1s, 1);

-- 8. 执行 IF 查询，验证预期错误
SELECT if(col_int32 > 0, col_int32 * 2, 0) FROM test.if_test WHERE col_int32 > 1073741823;
<<SQLSTATE;

-- 9. 删除本用例创建的 test 数据库
drop database test;
<<NULL;
