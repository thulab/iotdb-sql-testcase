-- 缩放场景：base、height_scale、width_scale 趋势相同
insert into pm_unsupported(time,device_id,text_value,blob_value,object_value,timestamp_value,date_value) values
    (1,'u1','text',X'00',to_object(false,0,X'00'),100,'2026-03-20');

insert into pm_scale(time,shape,value) values
    (1,'base',1.0),(2,'base',2.0),(3,'base',3.0),(4,'base',2.0),(5,'base',1.0),
    (1,'height_scale',10.0),(2,'height_scale',20.0),(3,'height_scale',30.0),(4,'height_scale',20.0),(5,'height_scale',10.0),
    (10,'width_scale',1.0),(20,'width_scale',2.0),(30,'width_scale',3.0),(40,'width_scale',2.0),(50,'width_scale',1.0);

insert into pm_horizontal(time,value) values
