    (2,'d1','s1',2.0,12,'d1-b'),
    (3,'d1','s1',3.0,13,'d1-c'),
    (4,'d1','s1',2.0,14,'d1-d'),
    (5,'d1','s1',1.0,15,'d1-e'),
    (1,'d2','s2',10.0,21,'d2-a'),
    (2,'d2','s2',20.0,22,'d2-b'),
    (3,'d2','s2',30.0,23,'d2-c'),
    (4,'d2','s2',20.0,24,'d2-d'),
    (5,'d2','s2',10.0,25,'d2-e');

insert into pm_numeric(time,device_id,i32,i64,f32,f64) values
    (1,'n1',1,10,1.0,10.0),
    (2,'n1',2,20,2.0,20.0),
