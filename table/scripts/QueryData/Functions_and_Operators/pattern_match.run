// TDB-98 pattern_match 表值函数功能与边界用例

connect root/TimechoDB@2021;

-- 0. 清理环境
drop user pattern_match_reader;
<<NULL;
drop database test_pattern_match;
<<NULL;

--1. 创建数据库并指定数据库
create database test_pattern_match;
use test_pattern_match;

-- 2. 创建表
create table pm_base
(
    device_id STRING TAG,
    site STRING TAG,
    value DOUBLE FIELD,
    aux INT32 FIELD,
    note STRING FIELD
);

create table pm_numeric
(
    device_id STRING TAG,
    i32 INT32 FIELD,
    i64 INT64 FIELD,
    f32 FLOAT FIELD,
    f64 DOUBLE FIELD
);

create table pm_custom_time
(
    device_id STRING TAG,
    event_time TIMESTAMP TIME,
    fake_time INT64 FIELD,
    value DOUBLE FIELD,
    text_value STRING FIELD,
    bool_value BOOLEAN FIELD
);

create table pm_unsupported
(
    device_id STRING TAG,
    text_value STRING FIELD,
    blob_value BLOB FIELD,
    object_value OBJECT FIELD,
    timestamp_value TIMESTAMP FIELD,
    date_value DATE FIELD
);

create table pm_scale
(
    shape STRING TAG,
    value DOUBLE FIELD
);

create table pm_horizontal
(
    value DOUBLE FIELD
);

create table pm_overlap
(
    value DOUBLE FIELD
);

create table pm_regex
(
    shape STRING TAG,
    value DOUBLE FIELD
);

create table pm_smooth
(
    shape STRING TAG,
    value DOUBLE FIELD
);

create table pm_limits
(
    value DOUBLE FIELD
);

create table pm_gap
(
    shape STRING TAG,
    value DOUBLE FIELD
);

create table pm_edge
(
    shape STRING TAG,
    value DOUBLE FIELD
);

create table pm_empty
(
    value DOUBLE FIELD
);

create table pm_stream
(
    value DOUBLE FIELD
);

-- 3. 查看表以及查看表结构信息
show tables;
desc pm_base;
desc pm_custom_time;
desc pm_unsupported;
desc pm_edge;
desc pm_empty;
desc pm_gap;
desc pm_horizontal;
desc pm_limits;
desc pm_numeric;
desc pm_overlap;
desc pm_regex;
desc pm_scale;
desc pm_smooth;
desc pm_stream;


-- 4. 插入基础数据：每个 device 各有一个 1,2,3,2,1 趋势
