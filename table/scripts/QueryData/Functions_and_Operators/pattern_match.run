    (1,'plus_two',1.0),(2,'plus_two',2.0),(3,'plus_two',3.0),(4,'plus_two',2.0),
    (5,'plus_two',2.0),(6,'plus_two',3.0),(7,'plus_two',2.0),(8,'plus_two',1.0),
    (1,'star_zero',1.0),(2,'star_zero',1.0),(3,'star_zero',1.0),(4,'star_zero',1.0),
    (1,'star_one',1.0),(2,'star_one',1.0),(3,'star_one',1.0),(4,'star_one',2.0),
    (5,'star_one',3.0),(6,'star_one',2.0),(7,'star_one',1.0),(8,'star_one',1.0),
    (1,'star_two',1.0),(2,'star_two',1.0),(3,'star_two',1.0),(4,'star_two',2.0),
