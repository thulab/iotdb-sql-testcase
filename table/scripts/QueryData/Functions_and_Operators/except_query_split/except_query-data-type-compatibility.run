-- 3.1. INT32 与 INT64（兼容）
select int32_1 from t1
except
select int64_1 from t2
order by int32_1;

-- 3.2. INT32  与 FLOAT（兼容）
select int32_1 from t1
except
select float_1 from t2
order by int32_1;

-- 3.3. INT32 与 DOUBLE（兼容）
select int32_1 from t1
except
select double_1 from t2
order by int32_1;

-- 3.4. INT64 与 FLOAT （兼容）
