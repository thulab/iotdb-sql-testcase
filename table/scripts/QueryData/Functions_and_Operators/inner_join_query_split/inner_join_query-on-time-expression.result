-- [1]37:select    s.time as s_time,    s.region as s_region,    g.student_id as g_stud_id,    g.score as g_score,    c.course_name as c_course from    students s  INNER JOIN 	grades g ON s.time = date_bin(1ms, g.time) INNER JOIN 	courses c on s.time= date_bin(1ms, c.time)
