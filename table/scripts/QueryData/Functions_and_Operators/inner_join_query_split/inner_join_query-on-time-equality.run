-- 9 检查各表数据，按 time 升序展示
select * from students order by time;
select * from teachers order by time;
select * from courses order by time;
select * from grades order by time;

-- 10 ON time 等值连接及其投影、多表、聚合、CASE 和过滤查询

-- 查询场景：学生与课程按 time 等值连接，检查列别名和投影
select
  s.time, 
  s.name as s_name, 
  s.genders as s_gender,
  c.course_region as c_region, 
  c.course_id as c_id, 
  c.course_name as c_name
from 
   students s 
INNER JOIN courses c ON s.time = c.time;

-- 查询场景：学生与教师按 time 等值连接，检查两侧 region 和编号列
select 
  s.time, 
  s.region as region1, 
  s.student_id as id1, 
  t.region as region2, 
  t.teacher_id as id2 
from
  students s 
JOIN teachers t ON s.time = t.time;

-- 查询场景：教师与课程按 time 等值连接，投影教师编号和课程名称
select 
   t.teacher_id,
   course_name
from 
    teachers t
JOIN 
    courses c ON t.time = c.time;
	

-- 查询场景：学生、教师、课程和成绩按 time 连续等值连接
select
	s.time,
	s.region as stu_region,
	s.name as stu_name,
	t.region as tea_region,
	c.course_name,
	g.score
from students s 
JOIN teachers t ON s.time=t.time 
JOIN courses c ON c.time=t.time 
JOIN grades g ON g.time=c.time;

-- 查询场景：四表 time 等值连接后计算计数、均值、最大值和最小值
select 
	count(s.region) as region_count,
	count(s.student_id) as student_id_count,
	count(t.teacher_id) as teacher_id_count,
	count(c.course_id) as course_id_count,
	avg(g.score) as avg_score,
	max(g.score) as max_score,
	min(g.score) as min_score
from students s 
JOIN teachers t ON s.time=t.time 
JOIN courses c ON c.time=t.time 
JOIN grades g ON g.time=c.time;

-- 查询场景：学生与成绩按 time 连接，使用 CASE 计算等级、通过状态和表现
select 
    s.name,
    g.score,
    CASE 
        WHEN g.score >= 90 THEN 'A'
        WHEN g.score >= 80 THEN 'B'
        WHEN g.score >= 70 THEN 'C'
        WHEN g.score >= 60 THEN 'D'
        ELSE 'F'
    END AS grade,
    CASE 
        WHEN g.score >= 60 THEN 'Pass'
        ELSE 'Fail'
    END AS status,
    CASE 
        WHEN g.score >= 85 THEN 'Excellent'
        WHEN g.score >= 70 THEN 'Good'
        WHEN g.score >= 50 THEN 'Average'
        ELSE 'Needs Improvement'
    END AS performance
from 
    students s
JOIN 
    grades g ON s.time = g.time;
	

-- 查询场景：四表 time 等值连接并按学生时间范围过滤
select 
	s.region,
	s.name,
	t.teacher_id,
	c.course_id,
	c.course_name,
	g.score
from students s 
JOIN teachers t ON s.time=t.time 
JOIN courses c ON c.time=t.time 
JOIN grades g ON g.time=c.time
where s.time > 2 and s.time < 6;

-- 11 清理测试数据库
drop database test_db;
<<NULL;
