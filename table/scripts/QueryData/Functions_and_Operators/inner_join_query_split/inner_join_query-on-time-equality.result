-- [1]84:select  	count(s.region) as region_count, 	count(s.student_id) as student_id_count, 	count(t.teacher_id) as teacher_id_count, 	count(c.course_id) as course_id_count, 	avg(g.score) as avg_score, 	max(g.score) as max_score, 	min(g.score) as min_score from students s  JOIN teachers t ON s.time=t.time  JOIN courses c ON c.time=t.time  JOIN grades g ON g.time=c.time
