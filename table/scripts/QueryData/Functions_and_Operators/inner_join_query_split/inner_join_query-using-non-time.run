(1,'Math',10000001,'数学',1001),(2,'CHIN',10000002,'语文',1002),(3,'ENG',10000003,'英语',1003),(4,'PE',10000004,'体育',1004),(5,'HIST',10000005,'历史',1005);
-- 8 写入成绩数据
insert into grades(time,grade_id,course_id,student_id,score) values
(1,1111,10000001,1,99),(2,1112,10000002,2,90),(3,1113,10000003,3,85),(4,1114,10000004,4,89),(5,1115,10000005,5,98),(6,1113,10000003,6,55),(7,1114,10000004,7,60),(8,1115,10000005,8,100),(9,1114,10000001,2,99),(10,1115,10000002,1,95);
-- 9 检查各表数据，按 time 升序展示
select * from students order by time;
select * from teachers order by time;
select * from courses order by time;
select * from grades order by time;

-- 10 USING 非 time 列及多列连接键

-- 查询场景：USING(student_id) 和 USING(region) 连接，并筛选成绩及地区
select * 
	from students s
INNER JOIN 
	grades g USING(student_id)
INNER JOIN 
	teachers t USING(region)
where g.score > 80 and g.score < 95 and region = 'haidian';

-- 查询场景：依次使用 time、region、course_id、student_id 作为复合连接键
select *
	from students s
INNER JOIN 
	teachers t USING(time,region)
INNER JOIN
	courses c USING(time,course_id)
INNER JOIN
	grades g USING(time,course_id,student_id);

-- 11 清理测试数据库
drop database test_db;
<<NULL;
