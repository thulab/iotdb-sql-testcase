-- FFT-038：前 N 行合法，但 N 之后存在重复时间戳
create table invalid_after_n
(
    source_id STRING TAG,
    value DOUBLE FIELD
);

-- FFT-040：分区列使用不同数据类型，并保留两个待转换数值列
create table typed_partition
(
    region_id STRING TAG,
    rack_no INT32 FIELD,
    temperature FLOAT FIELD,
    amplitude DOUBLE FIELD
);


-- 3. 查看表和表结构
show tables;

desc signal;
desc impulse;
desc seq;
desc irregular;
desc single_row;
desc empty_signal;
desc custom_signal;
desc numeric_types;
desc no_numeric;
desc with_null;
desc duplicate_time;
desc wide_128;
desc wide_129;
desc invalid_after_n;
desc typed_partition; 


-- 4. 写入基础测试数据
insert into signal(time, device_id, temperature, speed, note) values(0,    'd1', 1.0, 1, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(1000, 'd1', 0.0, 2, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(2000, 'd1', 0.0, 3, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(3000, 'd1', 0.0, 4, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(4000, 'd2', 2.0, 4, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(5000, 'd2', 0.0, 3, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(6000, 'd2', 0.0, 2, 'ok');
insert into signal(time, device_id, temperature, speed, note) values(7000, 'd2', 0.0, 1, 'ok');

insert into impulse(time, value) values(0, 1.0);
insert into impulse(time, value) values(1000, 0.0);
insert into impulse(time, value) values(2000, 0.0);
insert into impulse(time, value) values(3000, 0.0);

insert into seq(time, value) values(0, 1.0);
insert into seq(time, value) values(1000, 2.0);
insert into seq(time, value) values(2000, 3.0);
insert into seq(time, value) values(3000, 4.0);

insert into irregular(time, device_id, value) values(0,    'd1', 1.0);
insert into irregular(time, device_id, value) values(1000, 'd1', 2.0);
insert into irregular(time, device_id, value) values(2500, 'd1', 3.0);

insert into single_row(time, device_id, value) values(0, 'd1', 2.0);

insert into custom_signal(event_time, value) values(0, 1.0);
insert into custom_signal(event_time, value) values(1000, 0.0);
insert into custom_signal(event_time, value) values(2000, 0.0);
insert into custom_signal(event_time, value) values(3000, 0.0);

insert into numeric_types(time, i32, i64, f32, f64) values(0,    1, 10, 1.0, 10.0);
insert into numeric_types(time, i32, i64, f32, f64) values(1000, 2, 20, 2.0, 20.0);
insert into numeric_types(time, i32, i64, f32, f64) values(2000, 3, 30, 3.0, 30.0);
insert into numeric_types(time, i32, i64, f32, f64) values(3000, 4, 40, 4.0, 40.0);

insert into no_numeric(time, device_id, note) values(0, 'd1', 'ok');

insert into with_null(time, device_id, value) values(0,    'd1', 1.0);
insert into with_null(time, device_id, value) values(1000, 'd1', 2.0);
insert into with_null(time, device_id, value) values(2000, 'd1', null);

-- 不分区时，两个 TAG 实体的相同时间戳进入同一个 FFT 分区
insert into duplicate_time(time, device_id, value) values(0, 'd1', 1.0);
insert into duplicate_time(time, device_id, value) values(0, 'd2', 2.0);

