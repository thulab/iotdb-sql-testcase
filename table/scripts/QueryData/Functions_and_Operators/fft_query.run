-- FFT-038：排序后的前两行合法，第 3/4 行时间戳重复
insert into invalid_after_n(time, source_id, value) values(0,    's1', 1.0);
insert into invalid_after_n(time, source_id, value) values(1000, 's1', 2.0);
insert into invalid_after_n(time, source_id, value) values(2000, 's1', 3.0);
insert into invalid_after_n(time, source_id, value) values(2000, 's2', 4.0);

-- FFT-040：两个分区，每个分区 4 行
insert into typed_partition(time, region_id, rack_no, temperature, amplitude) values(0,    'east', 1, 1.0, 10.0);
insert into typed_partition(time, region_id, rack_no, temperature, amplitude) values(1000, 'east', 1, 2.0, 20.0);
insert into typed_partition(time, region_id, rack_no, temperature, amplitude) values(2000, 'east', 1, 3.0, 30.0);
insert into typed_partition(time, region_id, rack_no, temperature, amplitude) values(3000, 'east', 1, 4.0, 40.0);
insert into typed_partition(time, region_id, rack_no, temperature, amplitude) values(0,    'west', 2, 4.0, 40.0);
insert into typed_partition(time, region_id, rack_no, temperature, amplitude) values(1000, 'west', 2, 3.0, 30.0);
insert into typed_partition(time, region_id, rack_no, temperature, amplitude) values(2000, 'west', 2, 2.0, 20.0);
insert into typed_partition(time, region_id, rack_no, temperature, amplitude) values(3000, 'west', 2, 1.0, 10.0);


-- 5. 查询原始数据
select * from signal order by device_id, time;
select * from impulse order by time;
select * from seq order by time;
select * from irregular order by time;
select * from single_row order by time;
select * from empty_signal order by time;
select * from custom_signal order by 1, 2;
select * from numeric_types order by time;
select * from no_numeric order by time;
select * from with_null order by time;

-- 6. FFT 正常场景

-- 6.1 按设备分区，同时转换 DOUBLE 和 INT32；STRING 列 note 应被忽略
select *
from FFT(
    DATA => signal PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
order by device_id, frequency_index;

-- 6.2 无分区、单列 FFT，输出完整双边频谱
select frequency_index, frequency, value_real, value_imag
from FFT(
    DATA => impulse ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
order by frequency_index;

-- 6.3 函数名大小写不敏感
select frequency_index, frequency, value_real, value_imag
from fft(
    DATA => impulse ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
order by frequency_index;

-- 6.4 DATA 子查询投影：只转换 speed
select *
from FFT(
    DATA => (
        select time, device_id, speed
        from signal
    ) PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
order by device_id, frequency_index;

-- 6.5 默认 N，并根据首尾时间推断 SAMPLE_INTERVAL
select frequency_index, frequency, value_real, value_imag
from FFT(DATA => impulse ORDER BY time)
order by frequency_index;

-- 6.6 自定义 TIME 列
select frequency_index, frequency, value_real, value_imag
from FFT(
    DATA => custom_signal ORDER BY event_time,
    SAMPLE_INTERVAL => 1s,
    N => 4,
    TIMECOL => 'event_time'
)
order by frequency_index;

-- 6.7 支持 INT32、INT64、FLOAT、DOUBLE，输出实部和虚部均为 DOUBLE
select *
from FFT(
    DATA => numeric_types ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
order by frequency_index;

-- 6.8 backward、forward、ortho 三种归一化方式
select frequency_index, value_real, value_imag
from FFT(
    DATA => impulse ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4,
    NORM => 'backward'
)
order by frequency_index;

select frequency_index, value_real, value_imag
from FFT(
    DATA => impulse ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4,
    NORM => 'FORWARD'
)
order by frequency_index;

select frequency_index, value_real, value_imag
from FFT(
    DATA => impulse ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4,
    NORM => 'OrThO'
)
order by frequency_index;

-- 6.9 位置参数调用，参数顺序为 DATA、SAMPLE_INTERVAL、N、NORM
select frequency_index, frequency, value_real, value_imag
from TABLE(
    FFT(TABLE(impulse) ORDER BY time, 1s, 4, 'ortho')
)
order by frequency_index;

--6.10 显式 duration 采样间隔
select frequency_index, frequency 
from FFT(DATA => signal ORDER BY time, SAMPLE_INTERVAL => 100ms, N => 4); 

select frequency_index, frequency from FFT(DATA => signal ORDER BY time, SAMPLE_INTERVAL => 1s, N => 4);

-- 7. FFT 边界场景

-- 7.1 N 小于输入长度：只转换排序后的前 N 行
select frequency_index, frequency, value_real, value_imag
from FFT(
    DATA => seq ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 2
)
order by frequency_index;

-- 7.2 N 大于输入长度：在尾部补 0
select frequency_index, frequency, value_real, value_imag
from FFT(
    DATA => (select time, value from impulse where time < 2000) ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
order by frequency_index;

-- 7.3 非 2 的幂变换长度
select frequency_index, frequency, value_real, value_imag
from FFT(
    DATA => (select time, value from seq where time <= 2000) ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 3
)
order by frequency_index;

-- 7.4 不规则采样：未指定间隔时按首尾跨度的平均值推断
select *
from FFT(
    DATA => irregular PARTITION BY device_id ORDER BY time
)
order by device_id, frequency_index;

-- 7.5 不规则采样：显式间隔决定频率轴，不与实际相邻间隔比对
select * from FFT
    (DATA => irregular PARTITION BY device_id ORDER BY time)
order by frequency_index;

select *
from FFT(
    DATA => irregular PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s
)
order by device_id, frequency_index;

-- 7.6 单行分区显式指定采样间隔，默认 N=1
select *
from FFT(
    DATA => single_row PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s
)
order by device_id, frequency_index;

-- 7.7 空输入返回既定 Schema 和 0 行
select *
from FFT(DATA => empty_signal ORDER BY time)
order by frequency_index;

-- 7.8 FFT-021：最大允许变换长度
select count(*) as count_result
from FFT(
    DATA => single_row ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 65536
);

-- 7.9 FFT 结果继续参与投影、过滤、排序和聚合
select device_id, count(*) as non_negative_bin_count
from FFT(
    DATA => signal PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
where frequency >= 0
group by device_id
order by device_id;

-- 8. FFT 异常场景

-- 8.1 DATA 缺少 ORDER BY
select *
from FFT(
    DATA => signal PARTITION BY device_id,
    SAMPLE_INTERVAL => 1s
);
<<SQLSTATE;

-- 8.2 ORDER BY 列与 TIMECOL 不一致
select *
from FFT(
    DATA => signal PARTITION BY device_id ORDER BY speed,
    SAMPLE_INTERVAL => 1s
);
<<SQLSTATE;

-- 8.3 TIME 列降序
select *
from FFT(
    DATA => signal ORDER BY time DESC,
    SAMPLE_INTERVAL => 1s
);
<<SQLSTATE;

-- 8.4 同一 FFT 分区中时间戳重复
select *
from FFT(
    DATA => (select time, value from duplicate_time) ORDER BY time,
    SAMPLE_INTERVAL => 1s
);
<<SQLSTATE;

-- 8.5 SAMPLE_INTERVAL 不是 duration literal
select *
from FFT(DATA => impulse ORDER BY time, SAMPLE_INTERVAL => 1);
<<SQLSTATE;

-- 8.6 SAMPLE_INTERVAL 为 0
select *
from FFT(DATA => impulse ORDER BY time, SAMPLE_INTERVAL => 0ms);
<<SQLSTATE;

-- 8.7 N 为 0
select *
from FFT(DATA => impulse ORDER BY time, N => 0);
<<SQLSTATE;

-- 8.8 N 超过上限 65536
select *
from FFT(DATA => impulse ORDER BY time, N => 65537);
<<SQLSTATE;

-- 8.9 NORM 取值非法
select *
from FFT(DATA => impulse ORDER BY time, NORM => 'bad');
<<SQLSTATE;

-- 8.10 不存在可转换的数值列
select *
from FFT(
    DATA => no_numeric PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s
);
<<SQLSTATE;

-- 8.11 数值列含 NULL；即使 N=2 截断前两行，也必须校验第三行
select *
from FFT(
    DATA => with_null PARTITION BY device_id ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 2
);
<<SQLSTATE;

-- 8.12 单行分区未指定采样间隔
select *
from FFT(DATA => single_row PARTITION BY device_id ORDER BY time);
<<SQLSTATE;

-- 8.13 TIMECOL 指定列不存在
select *
from FFT(
    DATA => signal ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    TIMECOL => 'event_time'
);
<<SQLSTATE;

-- 8.14 TIMECOL 指定列类型错误
select *
from FFT(
    DATA => signal ORDER BY device_id,
    SAMPLE_INTERVAL => 1s,
    TIMECOL => 'device_id'
);
<<SQLSTATE;

-- 9. 其他场景

-- 9.1 FFT-036：N * 2 * 数值列数 = 65536 * 2 * 128 = 16777216，恰好达到缓存上限
select count(*) as count_result
from FFT(
    DATA => wide_128 ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 65536
);

-- 9.2 FFT-037：65536 * 2 * 129 超过缓存上限
select *
from FFT(
    DATA => wide_129 ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 65536
);
<<SQLSTATE;

-- 9.3 FFT-038：N=2 不能绕过 N 之后的全量时间升序/唯一性校验
select *
from FFT(
    DATA => invalid_after_n ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 2
);
<<SQLSTATE;

-- 9.4 FFT-039：权限验证，FFT 沿用源表 SELECT 权限
create user fft_reader 'Pass@123456789';
grant select on test_fft.signal to user fft_reader;
list privileges of user fft_reader;

-- 有权限用户可以读取 signal 并执行 FFT
connect fft_reader/Pass@123456789;
use test_fft;
select count(*) as bin_count
from FFT(
    DATA => signal ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
);

-- 撤销权限后，相同 FFT 查询应被 ACL 拒绝
connect root/TimechoDB@2021;
use test_fft;
revoke select on test_fft.signal from user fft_reader;
list privileges of user fft_reader;

connect fft_reader/FftReader123;
use test_fft;
select *
from FFT(
    DATA => signal ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
);
<<SQLSTATE;

-- 切回管理员并清理测试用户
connect root/TimechoDB@2021;
use test_fft;
drop user fft_reader;
<<NULL;

-- 9.5 FFT-040：验证分区列、固定频率列及 real/imag 列的输出顺序
select *
from FFT(
    DATA => typed_partition PARTITION BY (region_id, rack_no) ORDER BY time,
    SAMPLE_INTERVAL => 1s,
    N => 4
)
order by region_id, rack_no, frequency_index;

-- 10. 验证 FFT 查询不修改源表
select count(*) as signal_row_count from signal;
desc signal;

-- 11. 清理测试数据库
drop database test_fft;
<<NULL;
drop user fft_reader;
<<NULL;