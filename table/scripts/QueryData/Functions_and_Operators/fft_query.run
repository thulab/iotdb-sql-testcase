// 表模型内置表值函数FFT ，对输入表中每个分区的一个或多个实值数值序列执行一维快速傅里叶变换。

connect root/TimechoDB@2021;

-- 0. 清理测试数据库
drop user fft_reader;
<<NULL;

drop database test_fft;
<<NULL;

-- 1. 创建并使用测试数据库
create database test_fft;
use test_fft;

-- 2. 创建基础测试表
create table signal
(
    device_id STRING TAG,
    temperature DOUBLE FIELD,
    speed INT32 FIELD,
    note STRING FIELD
);

create table impulse
(
    value DOUBLE FIELD
);

create table seq
(
    value DOUBLE FIELD
);

create table irregular
(
    device_id STRING TAG,
    value DOUBLE FIELD
);

create table single_row
(
    device_id STRING TAG,
    value DOUBLE FIELD
);

create table empty_signal
(
    value DOUBLE FIELD
);

create table custom_signal
(
    event_time TIMESTAMP TIME,
    value DOUBLE FIELD
);

create table numeric_types
(
    i32 INT32 FIELD,
    i64 INT64 FIELD,
    f32 FLOAT FIELD,
    f64 DOUBLE FIELD
);

create table no_numeric
(
    device_id STRING TAG,
    note STRING FIELD
);

create table with_null
(
    device_id STRING TAG,
    value DOUBLE FIELD
);

create table duplicate_time
(
    device_id STRING TAG,
    value DOUBLE FIELD
);

