--7. OFFSET 查询
--7.1 从指定偏移位置查询剩余数据
select * from device_type_0 order by time,"地区" asc offset 5;
--7.2 偏移量为 0 时查询全部数据
select * from device_type_0 order by time,"地区" asc offset 0;
--7.3 OFFSET 为负数时预期返回 SQLSTATE
select * from device_type_0 offset -1;
<<SQLSTATE;

--8. 清理测试数据库
drop database test_db;
<<NULL;
