//数据查询：OFFSET 分页查询

connect root/TimechoDB@2021;
--0.清理残留测试数据
drop database test_db;
<<NULL;

--1. 创建测试数据库
create database test_db;

--2. 切换到测试数据库
use test_db;

--3. 创建包含标签、属性和数值字段的测试表
create table device_type_0
(
    "地区" STRING TAG,
    "厂号" STRING TAG,
    "设备号" STRING TAG,
    "型号" STRING ATTRIBUTE,
    "维修周期" STRING ATTRIBUTE,
	"温度" FLOAT FIELD,
    "排量" DOUBLE FIELD 
);

--4. 校验测试表已创建
show tables;

--5. 查看测试表结构
desc device_type_0;

--6. 写入多地区、多时间点的测试数据
