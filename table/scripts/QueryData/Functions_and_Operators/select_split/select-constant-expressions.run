// 无表查询：常量与算术表达式

connect root/TimechoDB@2021;

-- 初始化：清理可能残留的 test 数据库
drop database test;
<<NULL;

-- 基础查询：查询单个常量并指定列别名
select 1 as c1;

-- 算术运算：查询单个加法表达式且不指定别名
select 1 + 1;

-- 多列表达式：在同一结果集中计算乘法和减法
select 10 * 5 AS product, 10 - 3 AS diff;

-- 运算优先级：验证括号内加法先于外层乘法计算
select (2 + 3) * 4 AS calc;

-- 清理：删除本用例使用的 test 数据库
drop database test;
<<NULL;
