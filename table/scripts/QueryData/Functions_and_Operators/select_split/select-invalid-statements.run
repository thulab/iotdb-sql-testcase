// 无表查询：非法语句与预期错误

connect root/TimechoDB@2021;

-- 初始化：清理可能残留的 test 数据库
drop database test;
<<NULL;

-- 预期报错：无 FROM 子句时直接查询通配符
select *;
<<SQLSTATE;

-- 预期报错：无 FROM 子句时混用 COUNT(*) 与通配符
select COUNT(*), *;
<<SQLSTATE;

-- 预期报错：SELECT 语句缺少查询表达式
select;
<<SQLSTATE;

-- 预期报错：无 FROM 子句时聚合引用不存在的列 s1
select SUM(s1);
<<SQLSTATE;

-- 预期报错：调用不存在的函数 NOT_EXIST_FUNC
select NOT_EXIST_FUNC(1);
<<SQLSTATE;

-- 清理：删除本用例使用的 test 数据库
drop database test;
<<NULL;
