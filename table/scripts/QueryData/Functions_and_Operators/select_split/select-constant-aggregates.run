// 无表查询：常量聚合函数

connect root/TimechoDB@2021;

-- 初始化：清理可能残留的 test 数据库
drop database test;
<<NULL;

-- 聚合函数：对常量 10 求和
select SUM(10) AS total_sum;

-- 聚合函数：对常量 10 求平均值
select AVG(10) AS average;

-- 聚合函数：统计非空常量表达式 COUNT(10)
select COUNT(10) AS total_count;

-- 聚合函数：在无 FROM 子句时执行 COUNT(*)
select COUNT(*) AS total_count;

-- 聚合组合：在同一查询中组合 AVG、SUM、COUNT(expr) 与 COUNT(*)
select AVG(10) AS avg_result, SUM(10) AS sum_result, COUNT(10) AS count_const, COUNT(*) AS count_all;

-- 清理：删除本用例使用的 test 数据库
drop database test;
<<NULL;
