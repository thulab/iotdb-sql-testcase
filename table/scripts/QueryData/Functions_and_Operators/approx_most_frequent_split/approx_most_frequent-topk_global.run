// APPROX_MOST_FREQUENT：多值全局 Top-K 筛选及 k 边界
// 新增功能覆盖。所有 *_ok 列预期为 true，需录制并审核 .result 后运行回归。

connect root/TimechoDB@2021;
drop database amf_topk_global;
<<NULL;
create database amf_topk_global;
use amf_topk_global;
create table t1(device STRING TAG, value STRING FIELD, marker INT32 FIELD);

insert into t1(time, device, value, marker) values
(1, 'g1', 'a', 1),
(2, 'g1', 'a', 1),
(3, 'g1', 'a', 1),
(4, 'g1', 'a', 1),
(5, 'g1', 'a', 1),
(6, 'g1', 'a', 1),
(7, 'g1', 'a', 1),
(8, 'g1', 'a', 1),
(9, 'g1', 'b', 1),
(10, 'g1', 'b', 1),
(11, 'g1', 'b', 1),
(12, 'g1', 'b', 1),
(13, 'g1', 'c', 1),
(14, 'g1', 'c', 1),
(15, 'g1', 'd', 1);

-- 对照：a=8、b=4、c=2、d=1，无频次并列，避免 Top-K 并列选择不稳定。
select value, count(*) as actual_count from t1 group by value order by actual_count desc, value;

-- k=1/2/3/4/10，覆盖 Top-1、截断、k=NDV、k>NDV。capacity=10 >= NDV=4。
-- 通过冒号计数和各键的频次检查 JSON，避免对象键顺序影响结果基线。
select regexp_like(f1, '^[{][ ]*"a"[ ]*:[ ]*8[ ]*[}]$') as top1_ok,
       length(f2)-length(replace(f2, ':', ''))=2 and regexp_like(f2, '"a"[ ]*:[ ]*8[ ]*[,}]') and regexp_like(f2, '"b"[ ]*:[ ]*4[ ]*[,}]') as top2_ok,
       length(f3)-length(replace(f3, ':', ''))=3 and regexp_like(f3, '"a"[ ]*:[ ]*8[ ]*[,}]') and regexp_like(f3, '"b"[ ]*:[ ]*4[ ]*[,}]') and regexp_like(f3, '"c"[ ]*:[ ]*2[ ]*[,}]') as top3_ok,
       length(f4)-length(replace(f4, ':', ''))=4 and regexp_like(f4, '"a"[ ]*:[ ]*8[ ]*[,}]') and regexp_like(f4, '"b"[ ]*:[ ]*4[ ]*[,}]') and regexp_like(f4, '"c"[ ]*:[ ]*2[ ]*[,}]') and regexp_like(f4, '"d"[ ]*:[ ]*1[ ]*[,}]') as k_equals_ndv_ok,
       length(f10)-length(replace(f10, ':', ''))=4 and regexp_like(f10, '"a"[ ]*:[ ]*8[ ]*[,}]') and regexp_like(f10, '"b"[ ]*:[ ]*4[ ]*[,}]') and regexp_like(f10, '"c"[ ]*:[ ]*2[ ]*[,}]') and regexp_like(f10, '"d"[ ]*:[ ]*1[ ]*[,}]') as k_exceeds_ndv_ok
from (select approx_most_frequent(value,1,10) as f1,
             approx_most_frequent(value,2,10) as f2,
             approx_most_frequent(value,3,10) as f3,
             approx_most_frequent(value,4,10) as f4,
             approx_most_frequent(value,10,10) as f10 from t1);

connect root/TimechoDB@2021;
drop database amf_topk_global;
<<NULL;
