-- [1]41:select device,        case when device='g1' then regexp_like(f1, '^[{][ ]*"a"[ ]*:[ ]*8[ ]*[}]$')             when device='g2' then regexp_like(f1, '^[{][ ]*"b"[ ]*:[ ]*6[ ]*[}]$') else false end as top1_ok,        length(f2)-length(replace(f2, ':', ''))=2 and        case when device='g1' then regexp_like(f2, '"a"[ ]*:[ ]*8[ ]*[,}]') and regexp_like(f2, '"b"[ ]*:[ ]*4[ ]*[,}]')             when device='g2' then regexp_like(f2, '"b"[ ]*:[ ]*6[ ]*[,}]') and regexp_like(f2, '"c"[ ]*:[ ]*3[ ]*[,}]') else false end as top2_ok from (select device, approx_most_frequent(value,1,10) as f1, approx_most_frequent(value,2,10) as f2 from t1 group by device) order by device
