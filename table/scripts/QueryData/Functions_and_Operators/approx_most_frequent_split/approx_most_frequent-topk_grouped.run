// APPROX_MOST_FREQUENT：多值分组 Top-K 筛选及分组隔离
// 新增功能覆盖。所有 *_ok 列预期为 true，需录制并审核 .result 后运行回归。

connect root/TimechoDB@2021;
drop database amf_topk_grouped;
<<NULL;
create database amf_topk_grouped;
use amf_topk_grouped;
create table t1(device STRING TAG, value STRING FIELD, marker INT32 FIELD);

insert into t1(time, device, value, marker) values
(1, 'g1', 'a', 1),
(2, 'g1', 'a', 1),
(3, 'g1', 'a', 1),
(4, 'g1', 'a', 1),
(5, 'g1', 'a', 1),
(6, 'g1', 'a', 1),
(7, 'g1', 'a', 1),
(8, 'g1', 'a', 1),
(9, 'g1', 'b', 1),
(10, 'g1', 'b', 1),
(11, 'g1', 'b', 1),
(12, 'g1', 'b', 1),
(13, 'g1', 'c', 1),
(14, 'g1', 'c', 1),
(15, 'g1', 'd', 1),
(16, 'g2', 'b', 1),
(17, 'g2', 'b', 1),
(18, 'g2', 'b', 1),
(19, 'g2', 'b', 1),
(20, 'g2', 'b', 1),
(21, 'g2', 'b', 1),
(22, 'g2', 'c', 1),
(23, 'g2', 'c', 1),
(24, 'g2', 'c', 1),
(25, 'g2', 'a', 1);

-- 按 device 分组，value 在每组内有多个不同值。g1: a8/b4/c2/d1，g2: b6/c3/a1。
select device, value, count(*) as actual_count from t1 group by device, value order by device, actual_count desc, value;
-- 预期两行，各行 top1_ok、top2_ok 均为 true，验证分组间状态隔离。
select device,
       case when device='g1' then regexp_like(f1, '^[{][ ]*"a"[ ]*:[ ]*8[ ]*[}]$')
            when device='g2' then regexp_like(f1, '^[{][ ]*"b"[ ]*:[ ]*6[ ]*[}]$') else false end as top1_ok,
       length(f2)-length(replace(f2, ':', ''))=2 and
       case when device='g1' then regexp_like(f2, '"a"[ ]*:[ ]*8[ ]*[,}]') and regexp_like(f2, '"b"[ ]*:[ ]*4[ ]*[,}]')
            when device='g2' then regexp_like(f2, '"b"[ ]*:[ ]*6[ ]*[,}]') and regexp_like(f2, '"c"[ ]*:[ ]*3[ ]*[,}]') else false end as top2_ok
from (select device, approx_most_frequent(value,1,10) as f1, approx_most_frequent(value,2,10) as f2 from t1 group by device)
order by device;

connect root/TimechoDB@2021;
drop database amf_topk_grouped;
<<NULL;
