-- 7. 检查原始数据：四张表均按 time 升序；各表当前时间戳唯一。
select * from employees order by time;
select * from departments order by time;
select * from orders order by time;
select * from customers order by time;

-- 8.1 非关联 EXISTS：内层独立检查 C111000111 是否有订单，外层也过滤该客户。
-- 预期：内层 EXISTS 为 TRUE；外层按 customer_id ASC 返回 1 行 C111000111。
select customer_id from orders
	where customer_id = 'C111000111' and EXISTS (
		select 1 from orders
		where customer_id = 'C111000111'
)
ORDER BY customer_id ASC;

-- 9. 删除测试数据库 test_db，清理本用例创建的全部表和数据。
drop database test_db;
<<NULL;
