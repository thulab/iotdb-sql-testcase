// EXISTS 子查询：相关订单条件
// 来源：exists_subquery.run；独立准备数据并清理 test_db。
// 各脚本删除并重建 test_db，须串行执行。

// 测试目的：验证按 order_id 关联的 EXISTS，内层订单金额须大于 5000。
// 预期：4 行，金额升序为 5000.89、8888.88、9999.9、350102.9（FLOAT 显示以实际输出为准）。
// 边界：金额为 NULL 不满足 > 5000；order_id 为 NULL 也不能通过等值关联。
// 排序：外层 ORDER BY order_amount；当前匹配金额唯一。

connect root/TimechoDB@2021;

-- 0. 清理残留测试数据库 test_db。
drop database test_db;
<<NULL;

-- 1. 创建测试数据库 test_db。
create database test_db;

-- 2. 切换到 test_db。
use test_db;

-- 3. 创建共享数据集的 employees、departments、customers、orders 四张表。
create table employees
(
    department_id STRING TAG,
    remark STRING ATTRIBUTE,
    name TEXT FIELD,
    Gender TEXT FIELD,
        Status BOOLEAN FIELD,
        employee_id INT32 FIELD,
        salary DOUBLE FIELD,
        date_of_birth DATE FIELD,
        Contac_info string FIELD
);

create table departments
(
    department_id STRING TAG,
    dep_description STRING ATTRIBUTE,
    dep_name TEXT FIELD,
    dep_phone TEXT FIELD,
        dep_status BOOLEAN FIELD,
        dep_member INT32 FIELD,
        employee_id INT32 FIELD
);

create table customers
(
        customer_id STRING TAG,
        remark STRING ATTRIBUTE,
        customer_name TEXT,
        region TEXT,
        order_id INT64
);

create table orders
(
        customer_id STRING TAG,
        employee_id INT32,
        project_id STRING TAG,
        project_name STRING ATTRIBUTE,
        order_id INT64,
        order_amount FLOAT
);

-- 4. 检查四张测试表是否创建成功。
show tables;

-- 5. 检查四张表的列、数据类型及 TAG / ATTRIBUTE / FIELD 定义。
desc employees;
desc departments;
desc orders;
desc customers;

