-- 7. 检查原始数据：四张表均按 time 升序；各表当前时间戳唯一。
select * from employees order by time;
select * from departments order by time;
select * from orders order by time;
select * from customers order by time;

-- 8.1 相关 EXISTS：按 order_id 等值关联，要求内层匹配订单的 order_amount > 5000。
-- 预期：按 order_amount ASC 返回 4 行：5000.89、8888.88、9999.9、350102.9。
-- 金额为 NULL 时比较不为 TRUE；order_id 为 NULL 时也不能通过等值关联。
select order_amount from orders o1
	where EXISTS (
		select 1 from  orders o2
    WHERE o2.order_amount > 5000
    AND o1.order_id = o2.order_id
)
ORDER BY order_amount ASC;

-- 9. 删除测试数据库 test_db，清理本用例创建的全部表和数据。
drop database test_db;
<<NULL;
