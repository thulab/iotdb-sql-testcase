// INTERSECT：不同数据类型的兼容性与不兼容校验
--1. 连接测试实例
connect root/TimechoDB@2021;
--2. 删除可能残留的同名测试数据库
drop database test_db;
<<NULL;
--3. 创建测试数据库
create database test_db;
--4. 切换到测试数据库
use test_db;
--5. 创建包含全部待测数据类型的表t1
create table t1(device_id tag,int32_1 INT32,int64_1 INT64,double_1 DOUBLE,float_1 FLOAT,boolean_1 BOOLEAN,text_1 TEXT,string_1 STRING,blob_1 BLOB,object_1 OBJECT,timestamp_1 TIMESTAMP,date_1 DATE);
--6. 创建包含全部待测数据类型的表t2
create table t2(device_id tag,int32_1 INT32,int64_1 INT64,double_1 DOUBLE,float_1 FLOAT,boolean_1 BOOLEAN,text_1 TEXT,string_1 STRING,blob_1 BLOB,object_1 OBJECT,timestamp_1 TIMESTAMP,date_1 DATE);
--7. 向表t1插入各类型测试值
insert into t1(time,device_id,int32_1,int64_1,double_1,float_1,boolean_1,text_1,string_1,blob_1,object_1,timestamp_1,date_1) values (1,'d1',100,100,100.0,200.0,false,'test1','test1',X'48454C4C4F',to_object(false,0,X'7464'),1704067200000,'2026-04-08'),(2,'d1',100,200,200.0,200.0,false,'test1','test1',X'48454C4C4F',to_object(false,0,X'7464'),1704067200000,'2026-04-08'),(3,'d2',200,200,300.0,300.0,false,NULL,'test1',X'48454C4C4F',to_object(false,0,X'7464'),1704067200000,'2026-04-09'),(4,'d2',200,200,300.0,300.0,true,'test2','test1',X'426C6F62',to_object(false,0,X'7464'),1704067200000,'2026-04-10'),(5,'d3',300,300,400.0,300.0,true,NULL,NULL,X'426C6F62',to_object(false,0,X'62'),1704067200000,'2026-04-10'),(6,'d4',NULL,400,400.0,300.0,true,'test3','stest3',X'576F726C64',to_object(false,0,X'62'),1718409600000,'2026-04-11');
--8. 向表t2插入各类型测试值
insert into t2(time,device_id,int32_1,int64_1,double_1,float_1,boolean_1,text_1,string_1,blob_1,object_1,timestamp_1,date_1) values (1,'d1',100,100,100.0,100.0,true,'test1','test1',X'426C6F62',to_object(false,0,X'696F'),200,'2026-04-09'),(2,'d2',200,100,100.0,200.0,false,'test1','test1',X'426C6F62',to_object(false,0,X'696F'),200,'2026-04-09'),(3,'d2',200,200,300.0,300.0,false,NULL,'test1',X'48454C4C4F',to_object(false,0,X'7464'),1704067200000,'2026-04-09'),(4,'d2',200,200,200.0,300.0,false,'test2','test2',X'426C6F62',to_object(false,0,X'7464'),1718409600000,'2026-04-10'),(5,'d5',500,300,300.0,400.0,true,NULL,NULL,X'426C6F62',to_object(false,0,X'62'),1718409600000,'2026-04-11'),(6,'d4',NULL,300,400.0,500.0,true,'test3','test4',X'576F726C64',to_object(false,0,X'62'),1718409600000,'2026-04-11');
--9. INT32 与 INT64 兼容
select int32_1 from t1 intersect select int64_1 from t2 order by int32_1;
--10. INT32 与 FLOAT 兼容
select int32_1 from t1 intersect select float_1 from t2 order by int32_1;
--11. INT32 与 DOUBLE 兼容
select int32_1 from t1 intersect select double_1 from t2 order by int32_1;
--12. INT64 与 FLOAT 兼容
select int64_1 from t1 intersect select float_1 from t2 order by int64_1;
--13. INT64 与 DOUBLE 兼容
select int64_1 from t1 intersect select double_1 from t2 order by int64_1;
--14. INT64 与 TIMESTAMP 兼容
select int64_1 from t1 intersect select timestamp_1 from t2 order by int64_1;
--15. FLOAT 与 DOUBLE 兼容
select float_1 from t1 intersect select double_1 from t2 order by float_1;
--16. TEXT 与 STRING 兼容
select text_1 from t1 intersect select string_1 from t2 order by text_1;
--17. INT32 与 BOOLEAN 不兼容，预期返回SQLSTATE
select int32_1 from t1 intersect select boolean_1 from t2; <<SQLSTATE;
--18. INT32 与 DATE 不兼容，预期返回SQLSTATE
select int32_1 from t1 intersect select date_1 from t2; <<SQLSTATE;
--19. INT32 与 TIMESTAMP 不兼容，预期返回SQLSTATE
select int32_1 from t1 intersect select timestamp_1 from t2; <<SQLSTATE;
--20. INT32 与 TEXT 不兼容，预期返回SQLSTATE
select int32_1 from t1 intersect select text_1 from t2; <<SQLSTATE;
--21. INT32 与 STRING 不兼容，预期返回SQLSTATE
select int32_1 from t1 intersect select string_1 from t2; <<SQLSTATE;
--22. INT32 与 BLOB 不兼容，预期返回SQLSTATE
select int32_1 from t1 intersect select blob_1 from t2; <<SQLSTATE;
--23. INT64 与 DATE 不兼容，预期返回SQLSTATE
select int64_1 from t1 intersect select date_1 from t2; <<SQLSTATE;
--24. INT64 与 BOOLEAN 不兼容，预期返回SQLSTATE
select int64_1 from t1 intersect select boolean_1 from t2; <<SQLSTATE;
--25. INT64 与 TEXT 不兼容，预期返回SQLSTATE
select int64_1 from t1 intersect select text_1 from t2; <<SQLSTATE;
--26. INT64 与 STRING 不兼容，预期返回SQLSTATE
select int64_1 from t1 intersect select string_1 from t2; <<SQLSTATE;
--27. INT64 与 BLOB 不兼容，预期返回SQLSTATE
select int64_1 from t1 intersect select blob_1 from t2; <<SQLSTATE;
--28. FLOAT 与 DATE 不兼容，预期返回SQLSTATE
select float_1 from t1 intersect select date_1 from t2; <<SQLSTATE;
--29. FLOAT 与 TIMESTAMP 不兼容，预期返回SQLSTATE
select float_1 from t1 intersect select timestamp_1 from t2; <<SQLSTATE;
--30. FLOAT 与 BOOLEAN 不兼容，预期返回SQLSTATE
select float_1 from t1 intersect select boolean_1 from t2; <<SQLSTATE;
--31. FLOAT 与 TEXT 不兼容，预期返回SQLSTATE
select float_1 from t1 intersect select text_1 from t2; <<SQLSTATE;
--32. FLOAT 与 STRING 不兼容，预期返回SQLSTATE
select float_1 from t1 intersect select string_1 from t2; <<SQLSTATE;
--33. FLOAT 与 BLOB 不兼容，预期返回SQLSTATE
select float_1 from t1 intersect select blob_1 from t2; <<SQLSTATE;
--34. DOUBLE 与 DATE 不兼容，预期返回SQLSTATE
select double_1 from t1 intersect select date_1 from t2; <<SQLSTATE;
--35. DOUBLE 与 TIMESTAMP 不兼容，预期返回SQLSTATE
select double_1 from t1 intersect select timestamp_1 from t2; <<SQLSTATE;
--36. DOUBLE 与 BOOLEAN 不兼容，预期返回SQLSTATE
select double_1 from t1 intersect select boolean_1 from t2; <<SQLSTATE;
--37. DOUBLE 与 TEXT 不兼容，预期返回SQLSTATE
select double_1 from t1 intersect select text_1 from t2; <<SQLSTATE;
--38. DOUBLE 与 STRING 不兼容，预期返回SQLSTATE
select double_1 from t1 intersect select string_1 from t2; <<SQLSTATE;
--39. DOUBLE 与 BLOB 不兼容，预期返回SQLSTATE
select double_1 from t1 intersect select blob_1 from t2; <<SQLSTATE;
--40. BOOLEAN 与 DATE 不兼容，预期返回SQLSTATE
select boolean_1 from t1 intersect select date_1 from t2; <<SQLSTATE;
--41. BOOLEAN 与 TIMESTAMP 不兼容，预期返回SQLSTATE
select boolean_1 from t1 intersect select timestamp_1 from t2; <<SQLSTATE;
--42. BOOLEAN 与 INT32 不兼容，预期返回SQLSTATE
select boolean_1 from t1 intersect select int32_1 from t2; <<SQLSTATE;
--43. BOOLEAN 与 INT64 不兼容，预期返回SQLSTATE
select boolean_1 from t1 intersect select int64_1 from t2; <<SQLSTATE;
--44. BOOLEAN 与 FLOAT 不兼容，预期返回SQLSTATE
select boolean_1 from t1 intersect select float_1 from t2; <<SQLSTATE;
--45. BOOLEAN 与 DOUBLE 不兼容，预期返回SQLSTATE
select boolean_1 from t1 intersect select double_1 from t2; <<SQLSTATE;
--46. OBJECT类型不支持INTERSECT，预期返回SQLSTATE
select object_1 from t1 intersect select object_1 from t2; <<SQLSTATE;
--47. 重新连接测试实例以清理数据
connect root/TimechoDB@2021;
--48. 删除测试数据库
drop database test_db;
<<NULL;
