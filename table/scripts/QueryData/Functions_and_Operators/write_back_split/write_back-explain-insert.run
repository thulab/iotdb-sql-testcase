-- 查询写回 INSERT INTO QUERY：EXPLAIN 语法
-- 来源章节：9
-- 编号按 SQL 执行顺序排列；每条 SQL 前一行说明操作目的。

-- 1. 连接数据库会话
connect root/TimechoDB@2021;

-- 执行顺序编号；每条 SQL 前一行说明该语句的操作。


-- 2. 清理旧数据库并检查预期状态
drop database if exists db1;
-- 3. 创建本场景数据库
create database db1;
-- 4. 切换当前数据库
use db1;
-- 5. 创建源表或目标表
create table t1(id string tag, voltage float field);
-- 6. 创建源表或目标表
create table t2(id string tag, voltage float field);
-- 7. 检查写回语句的 EXPLAIN 语法
explain insert into t1 select * from t1;
<<SQLSTATE;
-- 8. 检查写回语句的 EXPLAIN 语法
explain analyze insert into t1 select * from t1;
<<SQLSTATE;
-- 9. 检查写回语句的 EXPLAIN 语法
explain analyze verbose insert into t1 select * from t1;
<<SQLSTATE;
-- 10. 将 SELECT 查询结果写入目标表
insert into t1 explain  select * from t1;
<<SQLSTATE;

-- 11. 清理测试数据库
drop database db1;
<<NULL;
