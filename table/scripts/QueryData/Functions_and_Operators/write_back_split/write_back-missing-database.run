-- 查询写回 INSERT INTO QUERY：数据库不存在错误处理
-- 来源章节：11
-- 编号按 SQL 执行顺序排列；每条 SQL 前一行说明操作目的。

-- 1. 连接数据库会话
connect root/TimechoDB@2021;

-- 执行顺序编号；每条 SQL 前一行说明该语句的操作。


-- 2. 清理旧数据库并检查预期状态
drop database if exists db1;
-- 3. 将 SELECT 查询结果写入目标表
insert into db1.t1 select * from db1.t1;
<<SQLSTATE;

-- 4. 清理旧数据库并检查预期状态
drop database if exists db1;
-- 5. 清理旧数据库并检查预期状态
drop database if exists db2;
-- 6. 创建本场景数据库
create database db1;
-- 7. 创建源表或目标表
create table db1.t1(id string tag, voltage float field);
-- 8. 写入测试数据
insert into db1.t1(time,id,voltage) values(1000, '1', 1.1), (2000, '2', 2.1);
-- 9. 将 SELECT 查询结果写入目标表
insert into db2.t1 select * from db1.t1;
<<SQLSTATE;

-- 10. 清理测试数据库
drop database db1;
<<NULL;
-- 清理项：数据库 db2
-- 11. 清理测试数据库
drop database db2;
<<NULL;
