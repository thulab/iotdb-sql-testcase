-- 查询写回 INSERT INTO QUERY：标准写回与自写回语法
-- 来源章节：1、2
-- 编号按 SQL 执行顺序排列；每条 SQL 前一行说明操作目的。

-- 1. 连接数据库会话
connect root/TimechoDB@2021;

-- 执行顺序编号；每条 SQL 前一行说明该语句的操作。

-- 场景：标准写回语法

-- 2. 清理旧数据库并检查预期状态
drop database if exists db1;
-- 3. 创建本场景数据库
create database db1;
-- 4. 切换当前数据库
use db1;
-- 5. 创建源表或目标表
create table t1(id string tag, voltage float field);
-- 6. 创建源表或目标表
create table t2(id string tag, voltage float field);

-- 7. 写入测试数据
insert into t1(time,id,voltage) values(1000, '1', 1.1), (2000, '2', 2.1);
-- 8. 将 SELECT 查询结果写入目标表
insert into t2 select * from t1;
-- 9. 查询数据并核对写入结果
select * from t2 order by time;
-- 10. 查询数据并核对写入结果
select * from t1 order by time;

-- 11. 写入测试数据
insert into t1(time,id,voltage) values(3000, '1', 3.1), (4000, '2', 4.1);
-- 12. 使用 TABLE 语法从源表写入目标表
insert into t2 table t1;
-- 13. 查询数据并核对写入结果
select * from t2 order by time;
-- 14. 查询数据并核对写入结果
select * from t1 order by time;

-- 15. 写入测试数据
insert into t1(time,id,voltage) values(5000, '1', 5.1), (6000, '2', 6.1);
-- 16. 将 SELECT 查询结果写入目标表
insert into t2 (select * from t1);
-- 17. 查询数据并核对写入结果
select * from t2 order by time;
-- 18. 查询数据并核对写入结果
select * from t1 order by time;

-- 场景：写回自身

-- 19. 写入测试数据
insert into t1(time,id,voltage) values(7000, '1', 7.1), (8000, '2', 8.1);
-- 20. 查询数据并核对写入结果
select * from t1 order by time;
-- 21. 将 SELECT 查询结果写入目标表
insert into t1 select * from t1;
-- 22. 查询数据并核对写入结果
select * from t1 order by time;

-- 23. 写入测试数据
insert into t1(time,id,voltage) values(9000, '1', 9.1), (10000, '2', 10.1);
-- 24. 查询数据并核对写入结果
select * from t1 order by time;
-- 25. 使用 TABLE 语法从源表写入目标表
insert into t1 table t1;
-- 26. 查询数据并核对写入结果
select * from t1 order by time;

-- 27. 写入测试数据
insert into t1(time,id,voltage) values(11000, '1', 11.1), (12000, '2', 12.1);
-- 28. 查询数据并核对写入结果
select * from t1 order by time;
-- 29. 将 SELECT 查询结果写入目标表
insert into t1 (select * from t1);
-- 30. 查询数据并核对写入结果
select * from t1 order by time;

-- 31. 清理测试数据库
drop database db1;
<<NULL;
