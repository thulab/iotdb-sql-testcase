--7. 原始数据查询
-- 初始化数据核对：按时间顺序检查测试所需的四张表。
-- 查看员工表
select * from employees order by time;
-- 查看部门表
select * from departments order by time;
-- 查看订单表
select * from orders order by time;
-- 查看客户表
select * from customers order by time;

--8. WHERE ALL 比较部门平均薪资
-- 左侧表达式：当前 employees.salary。
-- 子查询：按 department_id 分组计算各部门平均 salary。
-- 预期：返回薪资高于所有部门平均薪资的员工，并按 employee_id 排序。
select 
    employee_id,
    name,
    salary,
    department_id
from
    employees
where 
    salary > ALL (select AVG(salary) from employees GROUP BY department_id)
order by employee_id;

-- 清理测试数据库
