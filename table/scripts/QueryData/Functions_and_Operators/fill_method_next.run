// FILL子句NEXT后值填充方式，对于结果集中的null值，用结果集的后一个值进行填充


connect root/TimechoDB@2021;

--0. 清理环境
drop database test_db;
<<NULL;

--1. 创建数据库并查看数据库
create database test_db;
show databases;

--2. 创建表并查看表
use test_db;

create table t1(
  device_id STRING TAG,
  s1 OBJECT FIELD,
  s2 BOOLEAN FIELD,
  s3 INT32 FIELD,
  s4 INT64 FIELD,
  s5 TEXT FIELD,
  s6 DOUBLE FIELD,
  s7 FLOAT FIELD,
  s8 TIMESTAMP FIELD,
  s9 DATE FIELD,
  s10 STRING FIELD,
  s11 BLOB FIELD
);

create table t_ts(
  device_id STRING TAG,
  event_time TIMESTAMP FIELD,
  ingest_time TIMESTAMP FIELD,
  temperature FLOAT FIELD
);

create table t_group(
  plant_id STRING TAG,
  device_id STRING TAG,
  temperature FLOAT FIELD,
  status BOOLEAN FIELD
);

show tables from test_db;
desc t1;
desc t_ts;
desc t_group;

--3. 插入数据
--3.1 t1：覆盖 NEXT 支持的全部数据类型
insert into t1(time, device_id, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11) values
(1000, 'd1', to_object(true, 0, X'696F746462'), true, 1, 100, 'text-1', 1.11, 1.10, 1000, '2026-07-01', 'string-1', X'01');
insert into t1(time, device_id, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11) values
(1060, 'd1', null, null, null, null, null, null, null, null, null, null, null);
insert into t1(time, device_id, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11) values
(1120, 'd1', to_object(true, 0, X'6E657874'), false, 10, 10000000000, 'text-next', 1.23456789, 1.25, 2220, '2026-07-06', 'next-value', X'0A0B0C');
insert into t1(time, device_id, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11) values
(1180, 'd1', null, null, null, null, null, null, null, null, null, null, null);

-- 基础、连续空值、多列独立、无空值、TIME_BOUND 正向场景均复用 t1，以 device_id 隔离
insert into t1(time, device_id, s2, s7) values
(1000, 'base', true, 21.93),
(1060, 'base', false, null),
(1120, 'base', null, 22.23),
(1180, 'base', null, 23.43);

insert into t1(time, device_id, s7) values
(1000, 'chain', null),
(1060, 'chain', null),
(1120, 'chain', 23.43);

insert into t1(time, device_id, s2, s3, s7) values
(1000, 'multi', null, 1, null),
(1060, 'multi', false, null, 22.23),
(1120, 'multi', true, 3, null);

insert into t1(time, device_id, s2, s7) values
(1000, 'full', true, 21.93),
(1060, 'full', false, 22.23);

insert into t1(time, device_id, s7) values
(1000, 'bound_ok', null),
(1020, 'bound_ok', 22.88);

--3.2 t_ts：覆盖 TIME_BOUND、TIME_COLUMN 默认推断和显式指定
insert into t_ts(time, device_id, event_time, ingest_time, temperature) values
(1, 'd1', 1000, 1050, null);
insert into t_ts(time, device_id, event_time, ingest_time, temperature) values
(2, 'd1', 1060, 1070, 25.5);
insert into t_ts(time, device_id, event_time, ingest_time, temperature) values
(3, 'd1', 1120, 1125, 26.1);

--3.3 t_group：覆盖 FILL_GROUP 和 TIME_BOUND + FILL_GROUP
insert into t_group(time, plant_id, device_id, temperature, status) values
(1000, 'plant_a', 'dev_x', null, null);
insert into t_group(time, plant_id, device_id, temperature, status) values
(1010, 'plant_b', 'dev_x', 31.0, false);
insert into t_group(time, plant_id, device_id, temperature, status) values
(1020, 'plant_a', 'dev_y', 16.0, false);
insert into t_group(time, plant_id, device_id, temperature, status) values
(1030, 'plant_a', 'dev_x', 21.0, true);
insert into t_group(time, plant_id, device_id, temperature, status) values
(1090, 'plant_a', 'dev_x', null, null);
insert into t_group(time, plant_id, device_id, temperature, status) values
(1150, 'plant_a', 'dev_x', 40.0, true);

--4. 执行 FILL Method NEXT 后值填充
--4.1 原始数据
select time, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11
from t1
where device_id = 'd1'
order by time;

--4.2 NEXT 基础填充：中间 null 用后一个有效值填充，尾部 null 保持不变
select time, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11
from t1
where device_id = 'd1'
FILL METHOD NEXT
order by time;

--4.3 超过阈值不填充，TIME_BOUND：差值 60ms，大于 30ms，不应填充
select event_time, ingest_time, temperature
from t_ts
where device_id = 'd1'
FILL METHOD NEXT TIME_BOUND 30ms
order by time;

select time, s7 AS temperature
from t1 
where device_id='base' 
FILL METHOD NEXT TIME_BOUND 30ms
order by time;

--4.4 阈值内允许填充,TIME_BOUND：差值 20ms，小于 30ms，应填充
select time, s7 AS temperature 
from t1 
where device_id='bound_ok' 
FILL METHOD NEXT TIME_BOUND 30ms 
order by time;

--4.5 TIME_COLUMN：默认使用首个TIMESTAMP列
select event_time, ingest_time, temperature 
from t_ts 
where device_id='d1' 
FILL METHOD NEXT TIME_BOUND 100ms
ORDER BY time;

--4.6 TIME_COLUMN：显式指定第二列 ingest_time，差值 20ms，应填充
select event_time, ingest_time, temperature
from t_ts
where device_id = 'd1'
FILL METHOD NEXT TIME_BOUND 30ms TIME_COLUMN 2
order by time;

--4.7 FILL_GROUP：按 plant_id 分组，禁止跨组借值
select time, plant_id, temperature
from t_group
FILL METHOD NEXT FILL_GROUP 2
order by time;

--4.8 FILL_GROUP：按 plant_id + device_id 分组
select time, plant_id, device_id, status
from t_group
FILL METHOD NEXT FILL_GROUP 2,3
order by time;

--4.9 TIME_BOUND + FILL_GROUP：同组且时间差 <= 30ms 才允许填充
select time, plant_id, device_id, temperature
from t_group
FILL METHOD NEXT TIME_BOUND 30ms FILL_GROUP 2,3
order by time;

--4.10 尾部空置不填充
select time, s2 AS status from t1 WHERE device_id='base' FILL METHOD NEXT order by time;

--4.11 多结果列独立填充
select time, s7 AS temperature, s2 AS status, s3 AS quality from t1 WHERE device_id='multi' FILL METHOD NEXT order by time;

--4.12 无空值结果保持不变
select time, s7 AS temperature, s2 AS status from t1 WHERE device_id='full' FILL METHOD NEXT order by time;

--4.13 支持的数据类型：BOOLEAN | INT32 | INT64 | FLOAT | DOUBLE | TEXT | STRING | BLOB | TIMESTAMP | DATE | OBJECT
select time, s2 AS flag from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s3 AS v_int32 from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s4 AS v_int64 from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s7 AS v_float from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s6 AS v_double from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s5 AS v_text from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s10 AS v_string from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s11 AS v_blob from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s8 AS v_ts from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s9 AS v_date from t1 where device_id='d1' FILL METHOD NEXT order by time;
select time, s1 AS v_object from t1 where device_id='d1' FILL METHOD NEXT order by time;

--5. 异常场景
--5.1 未指定 TIME_BOUND/FILL_GROUP 时，不允许单独指定 TIME_COLUMN
select time, s3
from t1
FILL METHOD NEXT TIME_COLUMN 1
order by time;
<<SQLSTATE;

select time, s7 
from t1 
where device_id='base' 
FILL METHOD NEXT TIME_COLUMN 1 
ORDER BY time;
<<SQLSTATE;

--5.2 select list 中无 TIMESTAMP 列，无法推断 TIME_COLUMN
select s3, s5
from t1
FILL METHOD NEXT TIME_BOUND 30ms
order by time;
<<SQLSTATE;

select plant_id, temperature 
from t_group 
FILL METHOD NEXT FILL_GROUP 1 
order by time;
<<SQLSTATE;

--5.3 TIME_COLUMN 指向的列不是 TIMESTAMP 类型
select time, s3, s5
from t1
FILL METHOD NEXT TIME_BOUND 30ms TIME_COLUMN 2
order by time;
<<SQLSTATE;

--5.4 TIME_COLUMN 位置越界
select event_time, ingest_time, temperature
from t_ts
FILL METHOD NEXT TIME_BOUND 30ms TIME_COLUMN 0
order by time;
<<SQLSTATE;

select event_time, ingest_time, temperature
from t_ts
FILL METHOD NEXT TIME_BOUND 30ms TIME_COLUMN 4
order by time;
<<SQLSTATE;

--5.5 FILL_GROUP 位置越界
select time, plant_id, temperature
from t_group
FILL METHOD NEXT FILL_GROUP 0
order by time;
<<SQLSTATE;

select time, plant_id, temperature
from t_group
FILL METHOD NEXT FILL_GROUP 4
order by time;
<<SQLSTATE;

-- 清理环境
connect root/TimechoDB@2021;
drop database test_db;
<<NULL;
