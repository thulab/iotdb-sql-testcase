-- LENGTH：字符串及 BLOB 长度计算、异常输入及权限校验
-- 覆盖：正常/边界/空值 4 项；异常输入 9 项；权限 8 项；共 21 项。
-- 原场景编号：76、77、78、86、79、80、81、82、83、84、85、87、88、235、236、237、238、239、240、241、242
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- LENGTH：STRING 列计算字节长度 (P0)
-- 来源：binary_functions.run，用例 76

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING, col_text TEXT, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello', '您好', X'68656C6C6F');
SELECT length(col_string) FROM test.binary_test;
drop database test;
<<NULL;

-- LENGTH：TEXT 中文 (P0)
