-- FROM_BIG_ENDIAN_32：大端 BLOB 解码为 INT32、异常输入及权限校验
-- 覆盖：正常/边界/空值 2 项；异常输入 3 项；权限 4 项；共 9 项。
-- 原场景编号：123、126、124、125、127、267、268、269、270
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- FROM_BIG_ENDIAN_32：4 字节大端 BLOB 解码为 INT32 (P0)
-- 来源：binary_functions.run，用例 123

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'00000001');
SELECT from_big_endian_32(col_blob) FROM test.binary_test;
drop database test;
<<NULL;

-- FROM_BIG_ENDIAN_32：输入为 NULL 时的处理 (P1)
-- 来源：binary_functions.run，用例 126

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), NULL);
SELECT from_big_endian_32(col_blob) FROM test.binary_test;
drop database test;
<<NULL;

-- ============================================================
-- 类型、参数数量及非法输入场景
-- ============================================================

-- FROM_BIG_ENDIAN_32：输入 BLOB 仅 2 字节时报错 (P1)
-- 来源：binary_functions.run，用例 124

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
SELECT from_big_endian_32(col_blob) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- FROM_BIG_ENDIAN_32：输入 BLOB 为 8 字节时报错 (P1)
-- 来源：binary_functions.run，用例 125

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102030405060708');
SELECT from_big_endian_32(col_blob) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- FROM_BIG_ENDIAN_32：传入 0 个参数时报错 (P1)
-- 来源：binary_functions.run，用例 127

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT from_big_endian_32() FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- ============================================================
-- 权限范围及无权限场景
-- ============================================================

-- FROM_BIG_ENDIAN_32：授予 ANY 范围 SELECT 权限后查询 BLOB 列 (P0)
-- 来源：binary_functions.run，用例 267

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'00000001');
create user user1 '@Pass1234567';
GRANT SELECT ON ANY TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT from_big_endian_32(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- FROM_BIG_ENDIAN_32：授予数据库级 SELECT 权限后查询 BLOB 列 (P0)
-- 来源：binary_functions.run，用例 268

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'00000001');
create user user1 '@Pass1234567';
GRANT SELECT ON DATABASE test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT from_big_endian_32(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- FROM_BIG_ENDIAN_32：授予表级 SELECT 权限后查询 BLOB 列 (P0)
-- 来源：binary_functions.run，用例 269

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'00000001');
create user user1 '@Pass1234567';
GRANT SELECT ON TABLE test.binary_test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT from_big_endian_32(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- FROM_BIG_ENDIAN_32：未授予 SELECT 权限时访问数据库及查询 BLOB 列均报错 (P0)
-- 来源：binary_functions.run，用例 270

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'00000001');
create user user1 '@Pass1234567';
connect user1/@Pass1234567;
use test;
<<SQLSTATE;
SELECT from_big_endian_32(col) FROM test.binary_test;
<<SQLSTATE;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;
