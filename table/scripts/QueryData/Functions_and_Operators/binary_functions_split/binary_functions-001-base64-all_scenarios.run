-- BASE64：Base64 编码与解码、异常输入及权限校验
-- 覆盖：正常/边界/空值 8 项；异常输入 26 项；权限 12 项；共 46 项。
-- 原场景编号：1、2、3、12、15、19、20、29、4、5、6、7、8、9、10、11、13、14、16、17、18、21、22、23、24、25、26、27、28、30、31、32、33、34、195、196、197、198、199、200、201、202、203、204、205、206
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- TO_BASE64：STRING 列编码 (P0)
-- 来源：binary_functions.run，用例 1

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT to_base64(col_string) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_BASE64：TEXT 列编码 (P0)
-- 来源：binary_functions.run，用例 2

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_text TEXT);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), '数据');
SELECT to_base64(col_text) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_BASE64：BLOB 列编码 (P0)
