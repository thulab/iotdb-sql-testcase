-- ============================================================
-- 权限范围及无权限场景
-- ============================================================

-- TO_BASE64：授予 ANY 范围 SELECT 权限后查询 STRING 列 (P0)
-- 来源：binary_functions.run，用例 195

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
GRANT SELECT ON ANY TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT to_base64(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- TO_BASE64：授予数据库级 SELECT 权限后查询 STRING 列 (P0)
