connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'68656C6C6F');
SELECT to_base64(col_blob) FROM test.binary_test;
drop database test;
<<NULL;

