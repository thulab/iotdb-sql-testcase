-- HMAC_SHA512：HMAC-SHA512 消息认证码计算及权限校验
-- 覆盖：正常/边界/空值 1 项；异常输入 0 项；权限 4 项；共 5 项。
-- 原场景编号：194、355、356、357、358
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- HMAC_SHA512：STRING 数据与 TEXT 密钥计算消息认证码 (P1)
-- 来源：binary_functions.run，用例 194

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING, col_text TEXT);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello', 'secret');
SELECT hmac_sha512(col_string, col_text) FROM test.binary_test;
drop database test;
<<NULL;

-- ============================================================
-- 权限范围及无权限场景
-- ============================================================

-- HMAC_SHA512：授予 ANY 范围 SELECT 权限后查询 STRING 列 (P1)
-- 来源：binary_functions.run，用例 355

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
GRANT SELECT ON ANY TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT hmac_sha512(col, 'secret') FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- HMAC_SHA512：授予数据库级 SELECT 权限后查询 STRING 列 (P1)
-- 来源：binary_functions.run，用例 356

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
GRANT SELECT ON DATABASE test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT hmac_sha512(col, 'secret') FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- HMAC_SHA512：授予表级 SELECT 权限后查询 STRING 列 (P1)
-- 来源：binary_functions.run，用例 357

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
GRANT SELECT ON TABLE test.binary_test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT hmac_sha512(col, 'secret') FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- HMAC_SHA512：未授予 SELECT 权限时访问数据库及查询 STRING 列均报错 (P1)
-- 来源：binary_functions.run，用例 358

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
connect user1/@Pass1234567;
use test;
<<SQLSTATE;
SELECT hmac_sha512(col, 'secret') FROM test.binary_test;
<<SQLSTATE;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;
