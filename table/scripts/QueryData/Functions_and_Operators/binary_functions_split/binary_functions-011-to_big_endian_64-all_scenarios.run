-- TO_BIG_ENDIAN_64：INT64 大端编码、异常输入及权限校验
-- 覆盖：正常/边界/空值 3 项；异常输入 2 项；权限 4 项；共 9 项。
-- 原场景编号：118、119、120、121、122、263、264、265、266
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- TO_BIG_ENDIAN_64：INT64 正整数编码为大端 BLOB (P0)
-- 来源：binary_functions.run，用例 118

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_int64 INT64);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1);
SELECT to_big_endian_64(col_int64) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_BIG_ENDIAN_64：INT64 最大值编码为大端 BLOB (P1)
-- 来源：binary_functions.run，用例 119

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_int64 INT64);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 9223372036854775807);
SELECT to_big_endian_64(col_int64) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_BIG_ENDIAN_64：输入为 NULL 时的处理 (P1)
-- 来源：binary_functions.run，用例 120

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_int64 INT64);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), NULL);
SELECT to_big_endian_64(col_int64) FROM test.binary_test;
drop database test;
<<NULL;

-- ============================================================
-- 类型、参数数量及非法输入场景
-- ============================================================

-- TO_BIG_ENDIAN_64：传入不支持的 INT32 列时报错
-- 来源：binary_functions.run，用例 121

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_int32 INT32);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1);
SELECT to_big_endian_64(col_int32) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- TO_BIG_ENDIAN_64：传入 0 个参数时报错
-- 来源：binary_functions.run，用例 122

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT to_big_endian_64() FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- ============================================================
-- 权限范围及无权限场景
-- ============================================================

-- TO_BIG_ENDIAN_64：授予 ANY 范围 SELECT 权限后查询 INT64 列 (P0)
-- 来源：binary_functions.run，用例 263

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col INT64);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1);
create user user1 '@Pass1234567';
GRANT SELECT ON ANY TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT to_big_endian_64(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- TO_BIG_ENDIAN_64：授予数据库级 SELECT 权限后查询 INT64 列 (P0)
-- 来源：binary_functions.run，用例 264

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col INT64);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1);
create user user1 '@Pass1234567';
GRANT SELECT ON DATABASE test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT to_big_endian_64(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- TO_BIG_ENDIAN_64：授予表级 SELECT 权限后查询 INT64 列 (P0)
-- 来源：binary_functions.run，用例 265

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col INT64);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1);
create user user1 '@Pass1234567';
GRANT SELECT ON TABLE test.binary_test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT to_big_endian_64(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- TO_BIG_ENDIAN_64：未授予 SELECT 权限时访问数据库及查询 INT64 列均报错 (P0)
-- 来源：binary_functions.run，用例 266

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col INT64);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1);
create user user1 '@Pass1234567';
connect user1/@Pass1234567;
use test;
<<SQLSTATE;
SELECT to_big_endian_64(col) FROM test.binary_test;
<<SQLSTATE;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;
