-- LPAD：BLOB 左侧填充及截断、异常输入及权限校验
-- 覆盖：正常/边界/空值 4 项；异常输入 5 项；权限 4 项；共 13 项。
-- 原场景编号：95、96、97、98、99、100、101、102、103、251、252、253、254
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- LPAD：BLOB 左侧填充至指定长度 (P1)
-- 来源：binary_functions.run，用例 95

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
SELECT lpad(col_blob, 5, X'FF') FROM test.binary_test;
drop database test;
<<NULL;

-- LPAD：目标长度较小时截断 BLOB (P1)
-- 来源：binary_functions.run，用例 96

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102030405');
SELECT lpad(col_blob, 3, X'FF') FROM test.binary_test;
drop database test;
<<NULL;

-- LPAD：目标长度等于 BLOB 长度时保持原值 (P1)
-- 来源：binary_functions.run，用例 97

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'010203');
SELECT lpad(col_blob, 3, X'FF') FROM test.binary_test;
drop database test;
<<NULL;

-- LPAD：BLOB 输入为 NULL 时的处理 (P1)
-- 来源：binary_functions.run，用例 98

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), NULL);
SELECT lpad(col_blob, 5, X'FF') FROM test.binary_test;
drop database test;
<<NULL;

-- ============================================================
-- 类型、参数数量及非法输入场景
-- ============================================================

-- LPAD：目标长度为负数时报错 (P1)
-- 来源：binary_functions.run，用例 99

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
SELECT lpad(col_blob, -1, X'FF') FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- LPAD：填充 BLOB 为空时报错 (P1)
-- 来源：binary_functions.run，用例 100

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
SELECT lpad(col_blob, 5, X'') FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- LPAD：传入 0 个参数时报错
-- 来源：binary_functions.run，用例 101

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT lpad() FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- LPAD：传入 2 个参数时报错
-- 来源：binary_functions.run，用例 102

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
SELECT lpad(col_blob, 5) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- LPAD：传入 4 个参数时报错
-- 来源：binary_functions.run，用例 103

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
SELECT lpad(col_blob, 5, X'FF', X'AA') FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- ============================================================
-- 权限范围及无权限场景
-- ============================================================

-- LPAD：授予 ANY 范围 SELECT 权限后查询 BLOB 列 (P1)
-- 来源：binary_functions.run，用例 251

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
create user user1 '@Pass1234567';
GRANT SELECT ON ANY TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT lpad(col, 5, X'FF') FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- LPAD：授予数据库级 SELECT 权限后查询 BLOB 列 (P1)
-- 来源：binary_functions.run，用例 252

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
create user user1 '@Pass1234567';
GRANT SELECT ON DATABASE test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT lpad(col, 5, X'FF') FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- LPAD：授予表级 SELECT 权限后查询 BLOB 列 (P1)
-- 来源：binary_functions.run，用例 253

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
create user user1 '@Pass1234567';
GRANT SELECT ON TABLE test.binary_test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT lpad(col, 5, X'FF') FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- LPAD：未授予 SELECT 权限时访问数据库及查询 BLOB 列均报错 (P1)
-- 来源：binary_functions.run，用例 254

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'0102');
create user user1 '@Pass1234567';
connect user1/@Pass1234567;
use test;
<<SQLSTATE;
SELECT lpad(col, 5, X'FF') FROM test.binary_test;
<<SQLSTATE;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;
