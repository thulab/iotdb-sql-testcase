-- TO_IEEE754_64：DOUBLE 的 IEEE754 编码、异常输入及权限校验
-- 覆盖：正常/边界/空值 2 项；异常输入 2 项；权限 4 项；共 8 项。
-- 原场景编号：152、153、154、155、295、296、297、298
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- TO_IEEE754_64：DOUBLE 正数编码为 IEEE754 BLOB (P0)
-- 来源：binary_functions.run，用例 152

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_double DOUBLE);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1.0);
SELECT to_ieee754_64(col_double) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_IEEE754_64：输入为 NULL 时的处理 (P1)
-- 来源：binary_functions.run，用例 153

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_double DOUBLE);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), NULL);
SELECT to_ieee754_64(col_double) FROM test.binary_test;
drop database test;
<<NULL;

-- ============================================================
-- 类型、参数数量及非法输入场景
-- ============================================================

-- TO_IEEE754_64：传入不支持的 FLOAT 列时报错
-- 来源：binary_functions.run，用例 154

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_float FLOAT);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1.0);
SELECT to_ieee754_64(col_float) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- TO_IEEE754_64：传入 0 个参数时报错
-- 来源：binary_functions.run，用例 155

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT to_ieee754_64() FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- ============================================================
-- 权限范围及无权限场景
-- ============================================================

-- TO_IEEE754_64：授予 ANY 范围 SELECT 权限后查询 DOUBLE 列 (P0)
-- 来源：binary_functions.run，用例 295

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col DOUBLE);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1.0);
create user user1 '@Pass1234567';
GRANT SELECT ON ANY TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT to_ieee754_64(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- TO_IEEE754_64：授予数据库级 SELECT 权限后查询 DOUBLE 列 (P0)
-- 来源：binary_functions.run，用例 296

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col DOUBLE);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1.0);
create user user1 '@Pass1234567';
GRANT SELECT ON DATABASE test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT to_ieee754_64(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- TO_IEEE754_64：授予表级 SELECT 权限后查询 DOUBLE 列 (P0)
-- 来源：binary_functions.run，用例 297

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col DOUBLE);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1.0);
create user user1 '@Pass1234567';
GRANT SELECT ON TABLE test.binary_test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT to_ieee754_64(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- TO_IEEE754_64：未授予 SELECT 权限时访问数据库及查询 DOUBLE 列均报错 (P0)
-- 来源：binary_functions.run，用例 298

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col DOUBLE);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 1.0);
create user user1 '@Pass1234567';
connect user1/@Pass1234567;
use test;
<<SQLSTATE;
SELECT to_ieee754_64(col) FROM test.binary_test;
<<SQLSTATE;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;
