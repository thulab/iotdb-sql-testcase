-- ============================================================
-- 类型、参数数量及非法输入场景
-- ============================================================

-- TO_BASE32：传入 0 个参数时报错
-- 来源：binary_functions.run，用例 48

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT to_base32() FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- TO_BASE32：传入 2 个参数时报错
-- 来源：binary_functions.run，用例 49

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT to_base32(col_string, col_string) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- FROM_BASE32：无效字符时报错 (P1)
-- 来源：binary_functions.run，用例 53

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello123');
SELECT from_base32(col_string) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- FROM_BASE32：传入 0 个参数时报错 (P1)
-- 来源：binary_functions.run，用例 55

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT from_base32() FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- ============================================================
-- 权限范围及无权限场景
-- ============================================================

-- TO_BASE32：授予 ANY 范围 SELECT 权限后查询 STRING 列 (P1)
-- 来源：binary_functions.run，用例 215

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
GRANT SELECT ON ANY TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT to_base32(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- TO_BASE32：授予数据库级 SELECT 权限后查询 STRING 列 (P1)
-- 来源：binary_functions.run，用例 216

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
GRANT SELECT ON DATABASE test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT to_base32(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

