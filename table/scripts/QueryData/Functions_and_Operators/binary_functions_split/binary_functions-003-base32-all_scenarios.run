-- BASE32：Base32 编码与解码、异常输入及权限校验
-- 覆盖：正常/边界/空值 7 项；异常输入 4 项；权限 8 项；共 19 项。
-- 原场景编号：45、46、47、50、51、52、54、48、49、53、55、215、216、217、218、219、220、221、222
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- TO_BASE32：STRING 列编码 (P1)
-- 来源：binary_functions.run，用例 45

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT to_base32(col_string) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_BASE32：BLOB 列编码 (P1)
-- 来源：binary_functions.run，用例 46

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'68656C6C6F');
SELECT to_base32(col_blob) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_BASE32：输入为 NULL 时的处理 (P1)
-- 来源：binary_functions.run，用例 47

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), NULL);
SELECT to_base32(col_string) FROM test.binary_test;
drop database test;
<<NULL;

