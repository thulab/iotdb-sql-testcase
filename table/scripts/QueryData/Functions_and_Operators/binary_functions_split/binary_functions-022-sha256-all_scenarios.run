drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_int64 INT64);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 456);
SELECT sha256(col_int64) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

