-- SHA256：SHA256 摘要计算、异常输入及权限校验
-- 覆盖：正常/边界/空值 4 项；异常输入 9 项；权限 4 项；共 17 项。
-- 原场景编号：164、165、166、174、167、168、169、170、171、172、173、175、176、307、308、309、310
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- SHA256：STRING 列计算哈希值 (P0)
-- 来源：binary_functions.run，用例 164

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING, col_text TEXT, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello', '数据', X'68656C6C6F');
SELECT sha256(col_string) FROM test.binary_test;
drop database test;
<<NULL;

-- SHA256：TEXT 列计算哈希值 (P1)
-- 来源：binary_functions.run，用例 165

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_text TEXT);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), '数据');
SELECT sha256(col_text) FROM test.binary_test;
drop database test;
<<NULL;

-- SHA256：BLOB 列计算哈希值 (P1)
-- 来源：binary_functions.run，用例 166

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'68656C6C6F');
SELECT sha256(col_blob) FROM test.binary_test;
drop database test;
<<NULL;

-- SHA256：输入为 NULL 时的处理 (P1)
-- 来源：binary_functions.run，用例 174

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), NULL);
SELECT sha256(col_string) FROM test.binary_test;
drop database test;
<<NULL;

-- ============================================================
-- 类型、参数数量及非法输入场景
-- ============================================================

-- SHA256：传入不支持的 INT32 列时报错
-- 来源：binary_functions.run，用例 167

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_int32 INT32);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 123);
SELECT sha256(col_int32) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- SHA256：传入不支持的 INT64 列时报错
