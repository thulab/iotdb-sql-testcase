drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello-world');
create user user1 '@Pass1234567';
connect user1/@Pass1234567;
use test;
<<SQLSTATE;
SELECT to_base64url(col) FROM test.binary_test;
<<SQLSTATE;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

