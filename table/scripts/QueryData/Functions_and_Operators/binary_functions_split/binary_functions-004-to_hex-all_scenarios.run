use test;
SELECT to_hex(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- TO_HEX：未授予 SELECT 权限时访问数据库及查询 STRING 列均报错 (P0)
