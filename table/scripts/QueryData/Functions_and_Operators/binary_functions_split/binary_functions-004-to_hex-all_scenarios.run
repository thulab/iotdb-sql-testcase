-- TO_HEX：字符串及 BLOB 的十六进制编码、异常输入及权限校验
-- 覆盖：正常/边界/空值 4 项；异常输入 9 项；权限 8 项；共 21 项。
-- 原场景编号：56、57、58、66、59、60、61、62、63、64、65、67、68、223、224、225、226、227、228、229、230
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- TO_HEX：STRING 列编码 (P0)
-- 来源：binary_functions.run，用例 56

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING, col_text TEXT, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello', '您好', X'68656C6C6F');
SELECT to_hex(col_string) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_HEX：编码 TEXT 中文 (P1)
-- 来源：binary_functions.run，用例 57

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_text TEXT);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), '您好');
SELECT to_hex(col_text) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_HEX：BLOB 列编码 (P0)
-- 来源：binary_functions.run，用例 58

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_blob BLOB);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), X'68656C6C6F');
SELECT to_hex(col_blob) FROM test.binary_test;
drop database test;
<<NULL;

-- TO_HEX：输入为 NULL 时的处理 (P1)
-- 来源：binary_functions.run，用例 66

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), NULL);
SELECT to_hex(col_string) FROM test.binary_test;
drop database test;
<<NULL;

-- ============================================================
-- 类型、参数数量及非法输入场景
-- ============================================================

-- TO_HEX：传入不支持的 INT32 列时报错
-- 来源：binary_functions.run，用例 59

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_int32 INT32);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 123);
SELECT to_hex(col_int32) FROM test.binary_test;
<<SQLSTATE;
drop database test;
<<NULL;

-- TO_HEX：传入不支持的 INT64 列时报错
