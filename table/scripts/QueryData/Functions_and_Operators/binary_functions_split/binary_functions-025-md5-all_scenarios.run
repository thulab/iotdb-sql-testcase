-- MD5：MD5 摘要计算及权限校验
-- 覆盖：正常/边界/空值 1 项；异常输入 0 项；权限 4 项；共 5 项。
-- 原场景编号：179、319、320、321、322
-- 各子场景独立初始化和清理；按顺序串行执行。

-- ============================================================
-- 正常功能、边界值及空值场景
-- ============================================================

-- MD5：STRING 列计算哈希值 (P1)
-- 来源：binary_functions.run，用例 179

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col_string STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
SELECT md5(col_string) FROM test.binary_test;
drop database test;
<<NULL;

-- ============================================================
-- 权限范围及无权限场景
-- ============================================================

-- MD5：授予 ANY 范围 SELECT 权限后查询 STRING 列 (P1)
-- 来源：binary_functions.run，用例 319

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
GRANT SELECT ON ANY TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT md5(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- MD5：授予数据库级 SELECT 权限后查询 STRING 列 (P1)
-- 来源：binary_functions.run，用例 320

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
GRANT SELECT ON DATABASE test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT md5(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- MD5：授予表级 SELECT 权限后查询 STRING 列 (P1)
-- 来源：binary_functions.run，用例 321

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
GRANT SELECT ON TABLE test.binary_test TO USER user1;
connect user1/@Pass1234567;
use test;
SELECT md5(col) FROM test.binary_test;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;

-- MD5：未授予 SELECT 权限时访问数据库及查询 STRING 列均报错 (P1)
-- 来源：binary_functions.run，用例 322

connect root/TimechoDB@2021;
drop database test;
<<NULL;
create database test;
use test;
CREATE TABLE test.binary_test(ts TIMESTAMP, col STRING);
INSERT INTO test.binary_test VALUES (NOW(), NOW(), 'hello');
create user user1 '@Pass1234567';
connect user1/@Pass1234567;
use test;
<<SQLSTATE;
SELECT md5(col) FROM test.binary_test;
<<SQLSTATE;
connect root/TimechoDB@2021;
drop user user1;
drop database test;
<<NULL;
