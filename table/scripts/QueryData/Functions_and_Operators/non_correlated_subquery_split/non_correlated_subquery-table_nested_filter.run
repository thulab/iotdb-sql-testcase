-- 1. 连接到测试数据库实例

connect root/TimechoDB@2021;

-- 2. 删除可能残留的测试数据库

drop database test_db;
<<NULL;


-- 3. 创建测试数据库

create database test_db;

-- 4. 切换到测试数据库

use test_db;

-- 5. 创建 departments 表

create table departments (department_id STRING TAG, dep_description STRING ATTRIBUTE, dep_name TEXT FIELD, dep_phone TEXT FIELD, dep_status BOOLEAN FIELD, dep_member INT32 FIELD);

-- 6. 向 departments 表插入测试记录

insert into departments(time, department_id, dep_description, dep_name, dep_phone, dep_status, dep_member) values (1704874210000, 'D001', 'goods', '销售部', '010-2271-2120', false, 1223);

-- 7. 向 departments 表插入测试记录

insert into departments(time, department_id, dep_description, dep_name, dep_phone, dep_status, dep_member) values (1706698230000, 'D001', 'goods', '销售部', '010-2271-2120', false, 0012);

-- 8. 向 departments 表插入测试记录

insert into departments(time, department_id, dep_description, dep_name, dep_phone, dep_status, dep_member) values (1708868070000, 'D002', 'service', '客服部', '010-2077-2520', true, 0112);

-- 9. 向 departments 表插入测试记录

insert into departments(time, department_id, dep_description, dep_name, dep_phone, dep_status, dep_member) values (1711437332000, 'D002', 'service', '客服部', '010-2077-2520', true, 2012);

-- 10. 向 departments 表插入测试记录

insert into departments(time, department_id, dep_description, dep_name, dep_phone, dep_status, dep_member) values (1719754343000, 'D003', 'IT', '研发部', '010-3272-2310', true, 0212);

-- 11. 验证表子查询结果上的外层条件过滤

select department_id, dep_member from (select department_id, dep_description, dep_member from departments where dep_name='客服部') where dep_description='service';

-- 12. 删除测试数据库并清理测试数据

drop database test_db;
<<NULL;
