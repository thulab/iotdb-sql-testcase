-- 1. 连接到测试数据库实例

connect root/TimechoDB@2021;

-- 2. 删除可能残留的测试数据库

drop database test_db;
<<NULL;


-- 3. 创建测试数据库

create database test_db;

-- 4. 切换到测试数据库

use test_db;

-- 5. 创建 employees 表

create table employees (department_id STRING TAG, remark STRING ATTRIBUTE, name TEXT FIELD, Gender TEXT FIELD, Status BOOLEAN FIELD, employee_id INT32 FIELD, salary DOUBLE FIELD, date_of_birth DATE FIELD, Contac_info STRING FIELD);

-- 6. 向 employees 表插入测试记录

insert into employees(time, department_id, remark, name, gender, status, employee_id, salary, date_of_birth, contac_info) values (1704874210000, 'D001', 'good', 'Mary', 'Female', false, 1223, 5500.22, '1988-10-12', '133-1212-1234');

