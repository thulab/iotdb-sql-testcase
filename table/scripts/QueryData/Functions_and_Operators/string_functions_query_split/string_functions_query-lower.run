// 字符串函数：lower 小写转换与不支持类型校验

--1. 连接测试数据库。
connect root/TimechoDB@2021;
--2. 清理数据: 删除数据库
drop database test_db;
<<NULL;


--3. 创建数据库
create database test_db;

--4. 指定数据库
use test_db;

--5. 创建表
create table Table_A
(
	device_id STRING TAG,
	color STRING ATTRIBUTE,
	s0 BOOLEAN FIELD,
	s1 TEXT FIELD,
	s2 INT32 FIELD,
	s3 INT64 FIELD,
	s4 FLOAT FIELD,
	s5 DOUBLE FIELD,
	s6 BOOLEAN FIELD,
	s7 DATE FIELD,
	s8 TIMESTAMP FIELD,
	s9 STRING FIELD,
	s10 BLOB FIELD
);

--6. 查看表
show tables;

--7. 展示表结构信息
desc Table_A;

--8. 数据写入
