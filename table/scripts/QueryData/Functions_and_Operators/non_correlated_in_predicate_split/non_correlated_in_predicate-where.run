-- 7. 检查初始化数据，各表按 time 排序。
-- 7.1 数据检查：按 time 顺序展示初始化后的员工记录。
select * from employees order by time;
-- 7.2 数据检查：按 time 顺序展示初始化后的部门记录。
select * from departments order by time;
-- 7.3 数据检查：按 time 顺序展示初始化后的订单记录，包含 NULL customer_id 和 NULL 订单字段。
select * from orders order by time;
-- 7.4 数据检查：按 time 顺序展示初始化后的客户记录，包含 NULL customer_id。
select * from customers order by time;

-- 8. 执行本文件的功能测试，以下子项按执行顺序编号。
-- 8.1 部门编号为 D001 且员工 ID 出现在同部门记录中的员工。（来源：原脚本 8.1 第一条）
-- 预期：2 行，employee_id 升序为 1223、40012。
select employee_id from employees
where department_id = 'D001' and employee_id in (select employee_id from departments where department_id = 'D001')
order by employee_id;

-- 8.2 订单项目为 P0010100 的客户。（来源：原脚本 8.1 第二条）
-- 预期：1 行，customer_name 为 Jack。
select customer_id, customer_name from customers
where customer_id IN (select customer_id from orders where project_id = 'P0010100')
order by customer_name;

-- 8.3 department_id 出现在员工表中的部门。（来源：原脚本 8.1 第三条）
-- 预期：3 行，按 department_id、dep_name 升序返回 D001、D002、D003。
select department_id, dep_name from departments
where department_id IN (select DISTINCT department_id from employees)
order by department_id, dep_name;

-- 8.4 薪水等于员工表最高薪水的员工。（来源：原脚本 8.1 第四条）
-- 预期：1 行，employee_id 为 30112，salary 为 10002。
select employee_id, name, salary, department_id from employees
where salary IN (select max(salary) from employees)
order by employee_id;

-- 8.5 订单项目名称为 clothes 的客户。（来源：原脚本 8.1 第五条）
-- 预期：1 行，customer_name 为 Jack。
select customer_id, customer_name from customers
where order_id IN (select order_id from orders where project_name = 'clothes')
order by customer_name;

-- 8.6 部门状态为 true 的员工。（来源：原脚本 8.1 第六条）
-- 预期：5 行，employee_id 升序为 1223、10212、12212、30112、40012。
select employee_id, name from employees
where department_id IN (select department_id from departments where dep_status = true)
order by employee_id;

-- 8.7 订单 ID 出现在 customer_id 为空的客户记录中的员工订单数。（来源：原脚本 8.1 第七条）
-- 预期：1 行，employee_id 为 1002293，count_result 为 1。
select employee_id, count(order_amount) as count_result from orders
where order_id IN (select order_id from customers where customer_id is null)
group by employee_id
order by employee_id;

-- 8.8 客户 ID 不在订单客户 ID 集合中的客户；子查询含 NULL，未匹配值的 NOT IN 结果为 UNKNOWN，不会通过 WHERE。（来源：原脚本 8.1 第八条）
-- 预期：0 行。
SELECT customer_id, customer_name FROM customers
WHERE customer_id NOT IN (SELECT DISTINCT customer_id FROM orders)
ORDER BY customer_name;

-- 9. 清理本用例创建的测试数据库。
drop database test_db;
<<NULL;
