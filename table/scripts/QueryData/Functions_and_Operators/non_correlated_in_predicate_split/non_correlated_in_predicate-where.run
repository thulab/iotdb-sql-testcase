// 非关联 IN 谓词：WHERE 子句
// 来源：non_correlated_in_predicate.run；独立准备数据并清理 test_db。
// 各脚本删除并重建 test_db，须串行执行。

// 测试目的：验证 WHERE 中 IN / NOT IN 对单列子查询结果的过滤，包括 DISTINCT、聚合子查询和 NULL 语义。
// 查询覆盖：原脚本 8.1 共 8 条目标查询；下面的四条全表查询仅用于核对初始化数据。
// 数据特点：orders 中存在 NULL customer_id；NOT IN 子查询包含该 NULL 时，未匹配值的谓词结果为 UNKNOWN。

-- 0. 连接数据库。
connect root/TimechoDB@2021;
-- 1. 清理残留测试数据库。
drop database test_db;
<<NULL;
-- 2. 创建测试数据库。
create database test_db;
-- 3. 切换到测试数据库。
use test_db;

-- 4. 创建测试表：员工、部门、客户和订单。
create table employees
(
    department_id STRING TAG,
    remark STRING ATTRIBUTE,
    name TEXT FIELD,
	Gender TEXT FIELD,
	Status BOOLEAN FIELD,
	employee_id INT32 FIELD,
	salary DOUBLE FIELD,
	date_of_birth DATE FIELD,
	Contac_info string FIELD
);

create table departments
(
    department_id STRING TAG,
    dep_description STRING ATTRIBUTE,
    dep_name TEXT FIELD,
	dep_phone TEXT FIELD,
	dep_status BOOLEAN FIELD,
	dep_member INT32 FIELD,
	employee_id INT32 FIELD
);

create table customers
(
	customer_id STRING TAG,
	remark STRING ATTRIBUTE,
	customer_name TEXT,
	region TEXT,
	order_id INT64
);

create table orders
(
	customer_id STRING TAG,
	employee_id INT32,
	project_id STRING TAG,
	project_name STRING ATTRIBUTE,
	order_id INT64,
	order_amount FLOAT
);

-- 5. 检查测试表及表结构。
show tables;
desc employees;
desc departments;
desc orders;
desc customers;

-- 6. 写入员工测试数据。
