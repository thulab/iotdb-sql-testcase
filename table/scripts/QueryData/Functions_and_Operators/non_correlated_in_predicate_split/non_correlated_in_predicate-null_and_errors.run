-- 7. 检查初始化数据，各表按 time 排序。
-- 7.1 数据检查：按 time 顺序展示初始化后的员工记录。
select * from employees order by time;
-- 7.2 数据检查：按 time 顺序展示初始化后的部门记录。
select * from departments order by time;
-- 7.3 数据检查：按 time 顺序展示初始化后的订单记录，order_id 3729837293838 对应 NULL customer_id。
select * from orders order by time;
-- 7.4 数据检查：按 time 顺序展示初始化后的客户记录，包含一条 NULL customer_id。
select * from customers order by time;

-- 8. 执行本文件的功能测试，以下子项按执行顺序编号。
-- 8.1 先展示客户 ID 全集，包含 NULL。（来源：原脚本 9.1）
-- 预期：返回客户表中的全部 customer_id，按 customer_id 排序。
select customer_id from customers order by customer_id;
-- 8.2 IN 对同一客户 ID 全集进行匹配；WHERE 只保留谓词结果为 TRUE 的行。（来源：原脚本 9.1（续））
-- 预期：返回所有非 NULL customer_id；NULL 与 NULL 的比较结果不是 TRUE，因此该行被过滤。
select customer_id from customers
where customer_id in (select customer_id from customers)
order by customer_id;

-- 8.3 客户 ID 与指定订单的 customer_id 比较；该订单 customer_id 为 NULL，展示投影中的 IN 结果。（来源：原脚本 9.2）
-- 预期：按 order_id 升序返回客户记录；IN 结果遵循 NULL 三值逻辑，可能为 NULL。
select order_id, customer_id in (select customer_id from orders where order_id = 3729837293838) as in_result, customer_id
from customers
order by order_id;

-- 8.4 IN 左侧为两列行值，子查询返回 department_id 与聚合薪水；保留原脚本的预期错误标记。（来源：原脚本 9.3 第一条）
select employee_id, name, salary, department_id from employees
where (department_id, salary) IN (select department_id, avg(salary) from employees GROUP BY department_id);
<<SQLSTATE;

-- 8.5 标量 department_id 与返回两列的子查询比较；子查询列数不匹配，预期报错。（来源：原脚本 9.3 第二条）
select employee_id, name from employees
where department_id IN (SELECT department_id, dep_name FROM departments);
<<SQLSTATE;

-- 9. 清理本用例创建的测试数据库。
drop database test_db;
<<NULL;
