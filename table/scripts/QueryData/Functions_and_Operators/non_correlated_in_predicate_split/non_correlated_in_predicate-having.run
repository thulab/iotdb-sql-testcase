-- 7. 检查初始化数据，各表按 time 排序。
-- 7.1 数据检查：按 time 顺序展示初始化后的员工记录。
select * from employees order by time;
-- 7.2 数据检查：按 time 顺序展示初始化后的部门记录。
select * from departments order by time;
-- 7.3 数据检查：按 time 顺序展示初始化后的订单记录。
select * from orders order by time;
-- 7.4 数据检查：按 time 顺序展示初始化后的客户记录。
select * from customers order by time;

-- 8. 执行本文件的功能测试，以下子项按执行顺序编号。
-- 8.1 按部门分组，并用 HAVING 中的 IN 子查询筛选计数加 3 与 D002 员工姓名长度相等的分组。（来源：原脚本 8.2）
-- 预期：保留 D002 分组；count_result 为该部门记录数。
select department_id, count(*) as count_result from departments
group by department_id
having count(*) + 3 in (select cast(length(name) as INT64) from employees where department_id = 'D002')
order by department_id;

-- 9. 清理本用例创建的测试数据库。
drop database test_db;
<<NULL;
