// pattern_match_query：threshold 阈值参数边界
// 来源：pattern_match_query.run

// 时间序列趋势匹配表值函数
// 新增patter_match内置表值函数完成相似度匹配的筛选
// data参数为必填项
// time_col 参数为可选项
// data_col 参数为必填项
// pattern参数为必填项
// smooth为必填项
// threshold为必填项
// width 选填项
// height选填项
// smooth_on_pattern为选填项

connect root/TimechoDB@2021;

-- 1. 清理数据
drop database test_db;
<<NULL;

-- 2. 创建数据库
create database test_db;
show databases;

-- 3. 使用数据库
use test_db;

-- 4. 创建表
create table t1(
device_id tag,
int32_1 INT32,
int64_1 INT64,
double_1 DOUBLE,
float_1 FLOAT,
boolean_1 BOOLEAN,
text_1 TEXT,
string_1 STRING,
blob_1 BLOB,
object_1 OBJECT,
timestamp_1 TIMESTAMP,
date_1 DATE
);
show tables;
desc t1;

-- 5. 插入数据
