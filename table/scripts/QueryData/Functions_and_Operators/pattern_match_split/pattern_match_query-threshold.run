-- 6. 省略必填 threshold 参数时返回错误
select * from pattern_match(
	data => t1, 
	time_col => 'time', 
	data_col => 'int32_1',
	pattern => '1, 2, 1',
	smooth => 0.0,  
	width => 1000.0, 
	height => 500.0, 
	smooth_On_Pattern=> false
)order by 1,2,3;
<<SQLSTATE;

-- 7. threshold 设置为整数 0
select * from pattern_match(
	data => t1, 
	time_col => 'time', 
	data_col => 'int32_1',
	pattern => '1, 2, 1',
	smooth => 0.5, 
	threshold => 0, 
	width => 1000.0, 
	height => 500.0, 
	smooth_On_Pattern=> false
)order by 1,2,3;
<<SQLSTATE;

-- 8. threshold 设置为小数 0.0
select * from pattern_match(
	data => t1, 
	time_col => 'time', 
	data_col => 'int32_1',
	pattern => '1, 2, 1',
	smooth => 0.5, 
	threshold => 0.0, 
	width => 1000.0, 
	height => 500.0, 
	smooth_On_Pattern=> false
)order by 1,2,3;

-- 9. threshold 设置为负数时返回错误
select * from pattern_match(
   data => t1,
   time_col => 'time',
   data_col => 'int32_1',
   pattern => '1, 2, 1',
   smooth => 0.5,
   threshold => -1.1,
   width => 1000.0,
   height => 500.0,
   smooth_On_Pattern=> false
 )order by 1,2,3;
<<SQLSTATE;
 
-- 10. threshold 设置为 1.0
select * from pattern_match(
    data => t1,
    time_col => 'time',
    data_col => 'int32_1',
    pattern => '1,2,3,2,1,1,1,1,1',
    smooth => 0.5,
    threshold => 1.0,
    width => 1000.0,
    height => 500.0,
    smooth_on_pattern => false
)order by 1,2,3;

-- 11. threshold 设置为 100.0
select * from pattern_match(
    data => t1,
    time_col => 'time',
    data_col => 'int32_1',
    pattern => '1,2,3,2,1,1,1,1,1',
    smooth => 0.5,
    threshold => 100.0,
    width => 1000.0,
    height => 500.0,
    smooth_on_pattern => false
)order by 1,2,3;

-- 12. threshold 设置为 1000.0
select * from pattern_match(
    data => t1,
    time_col => 'time',
    data_col => 'int32_1',
    pattern => '1,2,3,2,1,1,1,1,1',
    smooth => 0.5,
    threshold => 1000.0,
    width => 1000.0,
    height => 500.0,
    smooth_on_pattern => false
)order by 1,2,3;

-- 13. threshold 设置为 0.01
select * from pattern_match(
    data => t1,
    time_col => 'time',
    data_col => 'int32_1',
    pattern => '1,2,3,2,1,1,1,1,1',
    smooth => 0.5,
    threshold => 0.01,
    width => 1000.0,
    height => 500.0,
    smooth_on_pattern => false
)order by 1,2,3;


-- 14. 清理数据
connect root/TimechoDB@2021;
drop database test_db;
<<NULL;
