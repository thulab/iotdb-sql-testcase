-- 6. INT32 列直接作为匹配数据
select * from pattern_match(
	data => t1, 
	time_col => 'time', 
	data_col => 'int32_1',
	pattern => '1,2,3,2,1,1,1,1,1',
	smooth => 0.5, 
	threshold => 10.0, 
	width => 1000.0, 
	height => 500.0, 
	smooth_On_Pattern=> false
)order by 1,2,3;

-- 7. INT32 列通过子查询作为匹配数据
select * from pattern_match(
	data => (select time, int32_1 from t1 order by time),
	time_col => 'time',
	data_col => 'int32_1',
	pattern => '1, 2, 3',
	smooth => 0.5,
	threshold => 10.0,
	width => 1000.0, 
	height => 500.0,
	smooth_on_pattern => false
) order by 1,2,3,4;

-- 8. INT64 列直接作为匹配数据
select * from pattern_match(
	data => t1, 
	time_col => 'time', 
	data_col => 'int64_1',
	pattern => '0,0,0,0,0,1,1,1,1',
	smooth => 0.5, 
	threshold => 10.0, 
	width => 1000.0, 
	height => 500.0, 
	smooth_On_Pattern=> false
)order by 1,2,3;

-- 9. INT64 列通过子查询作为匹配数据
select * from pattern_match(
	data => (select time, int64_1 from t1 order by time),
	time_col => 'time',
	data_col => 'int64_1',
	pattern => '0,0,0,0,0,1,1,1,1',
	smooth => 0.5,
	threshold => 10.0,
	width => 1000.0, 
	height => 500.0,
	smooth_on_pattern => false
) order by 1,2,3,4;

