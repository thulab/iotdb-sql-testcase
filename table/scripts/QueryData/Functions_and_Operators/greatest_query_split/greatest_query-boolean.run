// greatest 标量函数：BOOLEAN 参数查询。
// 本用例单独验证 BOOLEAN 数据类型的 greatest 查询结果，不设置错误标记。

connect root/TimechoDB@2021;

--0. 清理残留测试数据库
drop database test_db;
<<NULL;

--1. 创建测试数据库和 BOOLEAN 表结构
create database test_db;
use test_db;
create table table9(boolean_1 BOOLEAN, boolean_2 BOOLEAN);

--2. 写入两组 BOOLEAN 测试数据
insert into table9 values(1,false,true),(2,true,true);

--3. BOOLEAN 参数调用 greatest，按参数列排序以便稳定核对结果
select boolean_1,boolean_2,greatest(boolean_1,boolean_2) from table9 order by boolean_1,boolean_2;

--4. 清理测试数据库
drop database test_db;
<<NULL;
