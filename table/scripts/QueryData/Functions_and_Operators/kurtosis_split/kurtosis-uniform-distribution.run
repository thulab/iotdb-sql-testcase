-- 6. 查看原始测试数据
-- 6.1 查看 table1 的原始测量值。
select * from table1 order by time, device_id;
-- 6.2 查看 numeric_types 的数值类型数据。
select * from numeric_types order by time, device_id;
-- 6.3 查看 uni_cases 的分场景样本数据。
select * from uni_cases order by time, case_id;

-- 7. 测试场景：均匀分布的超额峰度为负。
-- 7.1 查看均匀分布样本。
select time, v from uni_cases where case_id='uniform' order by time;
-- 7.2 验证均匀分布的超额峰度为负。
select kurtosis(v) as kurtosis_result from uni_cases where case_id='uniform';

-- 8. 清理测试数据库
drop database kurtosis_test;
<<NULL;